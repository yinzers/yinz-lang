// does the received string alias the sent one? (compare via shape ptr-identity trick not available; free both)
function entrypoint() -> nothing {
  let n: int = 5
  let s: string = `bob${n}`
  let ch: channel<string> = channel<string>(4)
  ch.send(s)
  let got = ch.receive()
  let r: string = got.or(`none`)
  print(s)
  print(r)
}
