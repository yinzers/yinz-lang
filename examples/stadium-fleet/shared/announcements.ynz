// Announcement helpers shared between every ship in the stadium fleet.
// Used by ships/concessions/entrypoint.ynz to format PA broadcasts.

export function capitalize(share s: string) -> string {
  if (s.length == 0) {
    return s
  }
  let first = s[0].toUpperCase()
  let rest = s.slice(1, s.length)
  return first + rest
}
