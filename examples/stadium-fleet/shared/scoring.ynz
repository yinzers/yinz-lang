// Scoring helpers shared between every ship in the stadium fleet.
// Currently used by ships/scoreboard/entrypoint.ynz to tally runs per inning.

export function sum(share nums: fixed<int, 4>) -> int {
  let total = 0
  for (n in nums) {
    total = total + n
  }
  return total
}

export function max(share nums: fixed<int, 4>) -> int {
  let biggest = nums[0]
  for (n in nums) {
    if (n > biggest) {
      biggest = n
    }
  }
  return biggest
}
