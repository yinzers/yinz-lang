// examples/primantis-orders/m7_errors.ynz
//
// Intentional compile-error gallery for M7: strings, errors keyword, iterables.
// Every declaration below triggers a specific diagnostic class.
// Run via the error_galleries test in crates/ynz-driver/tests/error_galleries.rs.
//
// All triggers fire on a single compile (Yinz multi-errors up to 50/compile).
// Positive reference functions are included to confirm happy paths still hold.
// ────── errors keyword diagnostics ──────

function readFile(path: String) -> String errors {
  return `file contents`
}

function safeDivide(a: Int, b: Int) -> Int errors {
  return a / b
}

// WHY: calling an errors-capable function inside a non-errors context without
// handling the result — compiler must reject the unhandled call.
function noErrorsContext() -> Nothing {
  let x = readFile(`test.txt`)
  print(x)
}

// WHY: .or() on a non-errors value — int does not have .or()
function badOr() -> Nothing {
  let x: Int = 42
  let y = x.or(0)
  print(y.toString())
}

// WHY: .failed() on a non-errors value — boolean does not have .failed()
function badFailed() -> Nothing {
  let x: Boolean = true
  if (x.failed()) {
    print(`wrong`)
  }
}

// ────── string diagnostics ──────

// WHY: string mutation via bracket assignment — strings are not mutable by index
function stringMutation() -> Nothing {
  let s = `hello`
  s[0] = `H`
}

// WHY: .contains() on a non-string type — int has no .contains()
function badContains() -> Nothing {
  let n: Int = 42
  let r = n.contains(`4`)
  print(r.toString())
}

// ────── iterable diagnostics ──────

// WHY: iterating over a non-iterable type — int cannot be used in a for loop
function iterateInt() -> Nothing {
  let n: Int = 5
  for (x in n) {
    print(x.toString())
  }
}

// WHY: iterating over boolean — not iterable
function iterateBool() -> Nothing {
  for (x in true) {
    print(x.toString())
  }
}

// ────── positive reference cases ──────

// WHY: positive — errors auto-propagation inside an errors context is valid.
function outer() -> String errors {
  let inner = readFile(`log.txt`)
  return inner
}

// WHY: positive — .split() returns array<string>; calling .count() on it compiles.
function splitCount() -> Nothing {
  const csv = `a,b,c`
  const parts = csv.split(`,`)
  const partCount = parts.count()
  print(partCount.toString())
}

// WHY: positive — all M7 features compile and run correctly.
function m7AllFeaturesOk() -> Nothing {
  const s = `Hello, World!`
  print(s.toLowerCase())
  const hasWorld = s.contains(`World`)
  print(hasWorld.toString())
  const attempt = safeDivide(10, 2)
  const result = attempt.or(0)
  print(result.toString())
  let r = range(0, 2)
  for (i in r) {
    print(i.toString())
  }
  let count = 0
  for (c in `abc`) {
    count = count + 1
  }
  print(count.toString())
}

function entrypoint() -> Nothing {
  splitCount()
  m7AllFeaturesOk()
}
