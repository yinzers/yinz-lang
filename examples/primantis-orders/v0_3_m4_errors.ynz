// v0.3-M4 compile-error and warning gallery (Phase 1 construction + Phase 2 send/recv/handle)
//
// Every block below intentionally triggers a diagnostic class added in v0.3-M4.
// Run `ynz build v0_3_m4_errors.ynz` to see all diagnostics.
// Yinz reports up to 50 diagnostics per compile so a single run surfaces all.
//
// Each block has a // WHY: comment naming the diagnostic class.

// A suspending worker with NO channel parameter — the h.send()-with-no-inbox trigger below.
function reheatOven() -> int errors {
  wait sleep(1)
  return 350
}

// A pure-CPU function that never suspends — the handle-form-needs-suspending trigger below.
function countBuns() -> int {
  return 12
}

// A shape holding a channel — the receiver-origin trigger below extracts it unannotated.
shape PickupWindow { line: channel<int> }

// A plain shape + a GENERIC worker that borrows it — the auto-Arc boundary trigger below.
shape BatchNote { label: string }

function describeBatch<T>(share note: BatchNote) -> nothing {
  print(note.label)
}

// An EXPORTED shape + a worker that takes ownership of it — the padding-decline
// lint trigger below (Phase 4). Export is what makes it unpaddable.
export shape PalletLabel { count: int }

function stackPallet(give label: PalletLabel) -> nothing {
  wait sleep(1)
  print(label.count.toString())
}

function entrypoint() -> nothing {
  // WHY: channel-capacity-non-positive — a channel is bounded by construction (stdlib-design
  // Rule 4); a zero-capacity channel could never accept a value, so it is rejected.
  let zeroCap: channel<int> = channel<int>(0)

  // WHY: channel-capacity-non-positive (negated literal) — `-3` is caught at compile time too;
  // a negative capacity is meaningless.
  let negCap: channel<int> = channel<int>(-3)

  // WHY: channel-capacity-wrong-type — the capacity is a count of slots, so it must be an `int`,
  // not a string.
  let wrongCapType: channel<int> = channel<int>(`plenty`)

  // WHY: channel-missing-element-type — the compiler needs the element type `T` to check
  // `send`/`receive` later, so `channel()` with no `<T>` is rejected.
  let noElem = channel()

  // WHY: channel-too-many-args — a channel takes at most one argument, its capacity.
  let tooMany: channel<int> = channel<int>(8, 16)

  // ── v0.3-M4 Phase 2: the .send()/.receive() method surface ──

  // A well-formed channel the method-surface triggers below use.
  let orders: channel<int> = channel<int>(2)

  // WHY: channel-unknown-method — channels carry values with send(value)/receive() only;
  // anything else names the two available methods.
  orders.push(1)

  // WHY: channel-send-wrong-element-type — the element type is fixed at construction. The
  // diagnostic's WHY also carries the backpressure teaching text ("a suspended producer is
  // backpressure working, not a deadlock") so the first send error a user hits teaches the
  // bounded-channel model.
  orders.send(`a string, not an int`)

  // WHY: channel-receive-takes-no-arguments — receive() takes the next value out, bare.
  let takeout = orders.receive(5)

  // WHY: channel-op-must-be-own-statement — a channel operation can suspend, and the compiler
  // resumes a function at a statement boundary; nesting it inside a larger expression is
  // rejected (see `channel-op-expression-position` in the feature registry).
  let doubled = orders.receive() + 1

  // WHY: channel-receiver-must-be-named-binding — an unnamed in-flight channel has nowhere to
  // live across a suspension; bind it first (`let ch = ...`), then call methods on the binding.
  channel<int>(2).send(3)

  // WHY: channel-receiver-origin-not-derivable — the compiler decides which functions need
  // suspend-and-resume support by reading each binding's declared type early, so a channel
  // arriving through a shape field (or a collection element, loop variable, or another
  // module's function) must be bound WITH its type: `let line: channel<int> = window.line`.
  // Unannotated, the origin is invisible and the operation is rejected with a teaching error.
  let window: PickupWindow = { line: orders }
  let line = window.line
  let pickup = line.receive()

  // WHY: channel-element-type-not-supported — a `number` (or `shape`) value lives in the
  // SENDING task's stack frame, which can be freed while the value still sits in the channel;
  // the receiver would read freed memory. Rejected until per-type heap-copying ships.
  let widePipe: channel<number> = channel<number>(2)

  // ── v0.3-M4 Phase 2: the background handle-form ──

  // WHY: background-handle-nonsuspending-callee — the handle form needs a SUSPENDING function
  // (the handle substrate drives a suspend/resume frame); a pure-CPU function is rejected with
  // a pointer to the registry entry. Fire-and-forget `background countBuns()` still works.
  let badHandle = background countBuns()

  // WHY: handle-send-task-takes-no-channel — h.send(v) feeds the spawned function's FIRST
  // `channel<T>` parameter; a task whose function takes no channel never looks for messages,
  // so sending to it would silently pile up values nobody reads.
  let oven = background reheatOven()
  oven.send(450)

  // ── v0.3-M4 Phase 3: the auto-Arc boundary (share/lend across `background`) ──

  // WHY: background-share-generic-callee — a GENERIC function that borrows its argument
  // (`share`) spawned across a `background` boundary. This is the auto-Arc boundary
  // silent-skip gap Phase 3 CLOSED: a generic callee lives in the generic table, not the
  // concrete signature table, so before Phase 3 this borrow-across-thread hazard skipped the
  // reject silently. It now rejects loudly ("borrows its arguments"), identical to a concrete
  // `share`-param callee — the value must cross via `.give`/`.copy` (or auto-Arc when it lands).
  let note: BatchNote = { label: `tray-7` }
  background describeBatch<BatchNote>(note)

  // ── v0.3-M4 Phase 4: the two Tier 3 lints (SUGGESTION severity — teaching
  //    surfaces, never gates; neither blocks a compile) ──

  // WHY: cross-thread-fields-not-padded — PalletLabel's fields are used by a different
  // background task, but PalletLabel is EXPORTED: its memory layout must be identical in
  // every file that imports it, and files compile separately, so the false-sharing
  // auto-padding declines here and teaches instead. A module-local, non-exported shape
  // in the same position pads silently (see examples/pirates-roster).
  let pallet: PalletLabel = { count: 40 }
  background stackPallet(pallet)

  // WHY: prefer-yielding-sleep — a blocking sleep in a NON-kernel program holds an OS
  // thread idle while the scheduler could be running other tasks; `wait sleep(5)` pauses
  // the function and frees the thread. Dismissable, never an error (rare legitimate
  // blocking uses exist); kernel-mode programs do not get this lint at all — with no
  // scheduler to yield to, sleepBlocking is the RIGHT call there.
  sleepBlocking(5)

  print(`unreachable`)
}

// -- v0.3-M4 Error Class: kernel-mode rejects channel<T> construction AND channel methods --
//
// WHY: kernel-channel-rejected — `channel<T>` needs the Tokio scheduler started by ynz_rt_init to
// suspend a task on send-when-full / receive-when-empty; that scheduler does not run in kernel
// mode, so channel construction (Phase 1) AND the `.send()`/`.receive()` method surface (Phase 2)
// are compile errors under --kernel.
//
// Cannot be triggered via the public CLI in v0.3-M4 (the --kernel flag is hidden until it becomes
// a public build mode). Triggered in-process via check_with_kernel_mode() — see
// crates/ynz-typeck/tests/check.rs `channel_construction_in_kernel_mode_rejected` and the Phase-2
// method-gate tests. When --kernel is a public flag, this block will be updated with a real
// trigger:
//
//     let ch: channel<int> = channel<int>()   // ERROR in --kernel mode
//     ch.send(1)                              // ERROR in --kernel mode too

// -- v0.3-M4 Error Class: sending on a channel whose receiver is gone (RUNTIME typed error) --
//
// WHY: channel-closed-send — Lock 8: `.send()` is typed `nothing errors`, so a dropped/closed
// receiver yields a TYPED Yinz channel-closed error a program can handle with `.or()` /
// `errors` propagation — never a silent drop, never a raw runtime crash.
//
// NOT triggerable from v0.3 source, deliberately: the channel OBJECT holds its own sender and
// receiver endpoints, and a `channel<T>` binding keeps both alive (refcount-shared across
// `background` boundaries), so no v0.3 program shape can observe a closed channel. The path is
// still real — it is emitted in codegen (the 3-way suspend-point's Closed arm) and proven at the
// runtime substrate (`send_to_closed_returns_closed` in crates/ynz-runtime/src/channel.rs). It
// becomes source-reachable when channel endpoints get independent lifetimes (a future milestone).
