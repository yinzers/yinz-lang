// v0.2-M1 Error Gallery
//
// Intentional triggers for every registry-driven error path introduced or
// migrated in v0.2-M1. Each trigger has a // WHY: comment naming the diagnostic class.
//
// Themed: Primanti's kitchen — orders going sideways during the rush.
//
// Run: ynz run examples/primantis-orders/v0_2_m1_errors.ynz  (expects compile errors)
// Used for hands-on validation of diagnostic quality after each registry migration.

// ---------------------------------------------------------------------------
// Deferred language features — sized numeric types (Phase 5a)
// WHY: [[deferred_language_feature]] — sized types reserved, ship in v2+
// ---------------------------------------------------------------------------

function deferredSizedFloats() -> nothing {
    let x: f32 = 5.0   // WHY: f32 — deferred, substitute = use `float`
    let y: f64 = 5.0   // WHY: f64 — deferred, substitute = use `float`
}

function deferredSignedInts() -> nothing {
    let a: i8 = 5      // WHY: i8 — deferred, substitute = use `int`
    let b: i16 = 5     // WHY: i16 — deferred
    let c: i32 = 5     // WHY: i32 — deferred
    let d: i64 = 5     // WHY: i64 — deferred, `int` is already i64
}

function deferredUnsignedInts() -> nothing {
    let a: u8 = 5      // WHY: u8 — deferred, substitute = use `int`
    let b: u16 = 5     // WHY: u16 — deferred
    let c: u32 = 5     // WHY: u32 — deferred
    let d: u64 = 5     // WHY: u64 — deferred
}

// ---------------------------------------------------------------------------
// Deferred language features — `test` keyword (Phase 5a)
// WHY: [[deferred_language_feature]] — reserved for v0.13 testing framework
// ---------------------------------------------------------------------------

function deferredTestKeyword() -> nothing {
    let test = "reserved"   // WHY: `test` identifier — reserved for v0.13
}

// ---------------------------------------------------------------------------
// Type-attached constant wrong-type access
// WHY: registry lookup fails → undefined-field error
// ---------------------------------------------------------------------------

function wrongTypeConstant() -> nothing {
    let x = string.max  // WHY: string has no .max constant
}

// ---------------------------------------------------------------------------
// Banned declaration keywords — OOP keywords (Phase 4)
// WHY: [[banned_declaration_keyword]] entries — OOP drift detection
// Each line fires a teaching error with what_instead + why from the registry
// ---------------------------------------------------------------------------

class Player { }

struct Config { }

enum Status { }

interface Drawable { }

abstract shape BaseEntity { }

// ---------------------------------------------------------------------------
// Banned declaration keywords — concurrency keywords (Phase 4)
// WHY: [[banned_declaration_keyword]] — Yinz uses wait/background instead
// ---------------------------------------------------------------------------

function asyncExample() -> nothing {
    async function inner() -> nothing { }   // WHY: async banned, use wait at call site
}

// ---------------------------------------------------------------------------
// Banned jargon (Phase 2) — sampled triggers
// WHY: [[banned_jargon]] — these words must not appear in user-facing diagnostic
// prose. The jargon_audit.rs CI test catches them in compiler source.
// These triggers exist to validate the jargon_audit test still runs.
// (jargon_audit is a source-code scanner, not a runtime test — these
// function names contain jargon words to verify the scanner's exclusion
// of non-diagnostic contexts works correctly.)
// ---------------------------------------------------------------------------

function sampleJargonContextValidation() -> nothing {
    // The jargon_audit test scans diagnostic *strings*, not identifiers.
    // No runtime trigger needed here; jargon_audit.rs is the validator.
}
