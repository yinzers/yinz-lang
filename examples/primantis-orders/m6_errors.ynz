// examples/primantis-orders/m6_errors.ynz
//
// Intentional compile-error gallery for M6: options, unions, and narrowing.
// Every declaration below triggers a specific diagnostic class.
// Run via the existing m{N}_errors.ynz snapshot harness in crates/ynz-driver/tests.

// WHY: non-exhaustive options multi-case — missing variant named in diagnostic
options Status {
  pending
  active
  banned
}

function nonExhaustiveOptions(s: Status) -> nothing {
  if (s) {
    active => {
      print(`active`)
    }
    pending => {
      print(`pending`)
    }
    // 'banned' is missing — compile error

  }
}

// WHY: single-variant options is rejected — symmetric with single-variant union
options Single {
  only
}

// WHY: empty options is rejected — must have ≥2 variants
options Empty { }

// WHY: .toInt() on boolean is rejected — no silent 0/1 coercion
function boolToInt() -> nothing {
  let x = true.toInt()
}

// WHY: cross-options-type comparison is rejected — different tag namespaces
options Visibility {
  visible
  invisible
}

function crossOptionsCompare(s: Status, v: Visibility) -> nothing {
  let eq = s == v
}

// WHY: unknown options variant — typo caught at compile time
function badVariant() -> nothing {
  let s: Status = Status.activ
}

// WHY: non-exhaustive union multi-case — missing variant named in diagnostic
shape Circle {
  radius: int
}

shape Square {
  side: int
}

shape Triangle {
  width: int
  height: int
}

shape AnyShape = Circle | Square | Triangle

function nonExhaustiveUnion(s: AnyShape) -> nothing {
  if (s) {
    is Circle => {
      print(`circle`)
    }
    is Square => {
      print(`square`)
    }
    // Triangle missing — compile error

  }
}

// WHY: `is Type` on a non-union value — must produce teaching error
function isOnString() -> nothing {
  let msg: string = `hello`
  if (msg) {
    is Circle => {
      print(`never`)
    }
    else => {
      print(`other`)
    }
  }
}

// WHY: `.value` without narrowing on maybe<T>
function valueWithoutCheck() -> nothing {
  let x: maybe<int> = `bad`.toInt()
  print(x.value.toString())
}

// WHY: narrowed-union background receiver — fail-closed teaching error (FRAGO 026 /
// NarrowedUnionBackgroundReceiver class). Inside the `is Circle` arm the binding still
// holds the union's storage, not a standalone Circle; running it in the background
// would read past that storage, so the compiler rejects it deterministically.
function haulCircle(give self: Circle) -> nothing {
  wait sleep(20)
  print(`hauling`)
}

function narrowedUnionSpawn(fig: AnyShape) -> nothing {
  if (fig) {
    is Circle => {
      background fig.haulCircle()
    }
    else => {
      print(`other`)
    }
  }
}

function entrypoint() -> nothing { }
