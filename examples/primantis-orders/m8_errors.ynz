// examples/primantis-orders/m8Errors.ynz
//
// Intentional compile-error gallery for M8: modules, concurrency keywords,
// bignum, and the number[N] → Number<N> migration.
// Each trigger fires on a single compile (Yinz multi-errors up to 50/compile).
//
// Run via the error_galleries test in crates/ynz-driver/tests/error_galleries.rs.

// ────── P5: concurrency keyword errors ──────

// WHY: `background foo()` where `foo` has a `share` parameter is a compile
// error — shared borrows may dangle when the background task outlives the caller.
function p5_readData(share data: String) -> Nothing {
    print(data)
}

function p5_background_share_rejected() -> Nothing {
    let s: String = `hello`
    background p5_readData(s)
}

// WHY: `let h = background foo()` (handle form) must be a compile error in M8.
// Background handles (.send/.receive) ship in v0.3. Without an explicit rejection,
// the binding silently gets type `Nothing` and the user has no signal anything is wrong.
function p5_handleTarget() -> Nothing {
    print(`running`)
}

function p5_background_handle_rejected() -> Nothing {
    let h = background p5_handleTarget()
    print(h)
}

// ────── v0.1-polish: inline shape type errors ──────

// WHY: inline shape with a field not in the declared type must be caught.
function polish_unknown_field_in_inline_shape() -> Nothing {
    let x: { a: Int } = { a: 1, b: 2 }
    print(x)
}

// WHY: inline shape missing a required field at construction must error.
function polish_missing_field_in_inline_shape() -> Nothing {
    let x: { a: Int, b: Int } = { a: 1 }
    print(x)
}

// WHY: `hidden` inside an inline shape type must emit the specific diagnostic.
// (The `b: Int` that follows gets parsed as a regular field — secondary "missing b" error fires too.)
function polish_hidden_in_inline_shape() -> Nothing {
    let p: { a: Int, hidden b: Int } = { a: 1 }
    print(p)
}

// ────── v0.3-M8 Phase 4: channel close + the transfer rule ──────
//
// Every trigger below is one of the four compile-time diagnostics the v0.3-M8 design adds
// (IMP-ownership.md "Teaching text" for the three transfer diagnostics — ConsumedBySend,
// ParamNeedsGive, TransferNeedsCopy — and IMP-concurrency.md "Teaching text" for
// HandleChannelArgNeedsBinding), plus the two existing diagnostics `.close()` extends. The
// triggers below keep each of those diagnostic classes from silently reopening.

shape Bucket {
  rows: Array<Int>
}

// eat — a declared `give` position: the sink every "given to `eat`" trigger below hits.
function m8Eat(give rows: Array<Int>) -> Nothing {
  let rowCount = rows.count()
  print(rowCount.toString())
}

// pick — returns its argument through a `Maybe`. A function returning a string, array, map, shape,
// channel, a `Maybe` of a string, shape, number or channel or an envelope union hands back an owned
// copy (`copied_at_return`, and a generic call result is an owned copy of the instance's type), so
// those results are fresh; a `Maybe` of an array or map still returns a piece (`MayAlias` under the
// `returns_fresh` fixpoint fact), so a `let` bound to its result is `Reaches(b)`, never transferable.
function m8Pick(share b: Maybe<Array<Int>>) -> Maybe<Array<Int>> {
  return b
}

function m8EatBucket(give owner: Maybe<Array<Int>>) -> Nothing {
  print(owner.exists().toString())
}

// stash — a `give` position that is NOT the receiver of a UFCS dot-call; it goes through the
// same ownership path as any other `give` argument.
function m8Stash(lend self: Bucket, give rows: Array<Int>) -> Nothing {
  self.rows = rows
}

// WHY: ConsumedBySend (array) — `send()` on an owned-heap channel GIVES its payload; reading
// the sent binding afterward is refused. Nothing happens at runtime; the program does not
// compile until the read moves above the send or the send takes `rows.copy()`.
function m8ConsumedBySendArray() -> Nothing {
  let wire: Channel<Array<Int>> = Channel<Array<Int>>(2)
  let rows: Array<Int> = [1, 2, 3]
  wire.send(rows)
  let rowCount = rows.count()
  print(rowCount.toString())
}

// WHY: ConsumedBySend (map) — the same rule for the other owned-heap element kind. The
// WHAT-INSTEAD's advice (`wire.send(table.copy())`) is executable only because `.copy()` on
// `Map<K, V>` has the same `.copy()`.
function m8ConsumedBySendMap() -> Nothing {
  let wire: Channel<Map<String, Int>> = Channel<Map<String, Int>>(2)
  let table: Map<String, Int> = { `a`: 1 }
  wire.send(table)
  let entryCount = table.count()
  print(entryCount.toString())
}

// WHY: ConsumedBySend through an ALIAS CLASS — `first` is a piece of `rows`, so both names are
// in one class; sending `rows` consumes the class, so the read of `first` is refused and the
// diagnostic's `{via}` slot names `rows` as what was sent. (A whole-value alias, `let other =
// rows`, cannot exist since C5a: that `let` hands `rows` over, see the two triggers below.)
function m8ConsumedViaAliasLet() -> Nothing {
  let wire: Channel<Array<Array<Int>>> = Channel<Array<Array<Int>>>(2)
  let rows: Array<Array<Int>> = [[1, 2, 3]]
  let first = rows.first()
  wire.send(rows)
  let firstIsPresent = first.exists()
  print(firstIsPresent.toString())
}

// WHY: ConsumedByStore through REASSIGNMENT — `rows = other` is a store: it hands `other` to
// `rows`, so the later read of `other` is refused (C5a; before, the two names shared one class
// and the send below consumed both).
function m8ConsumedViaAliasReassign() -> Nothing {
  let wire: Channel<Array<Int>> = Channel<Array<Int>>(2)
  let rows: Array<Int> = [1]
  let other: Array<Int> = [2]
  rows = other
  wire.send(rows)
  let otherCount = other.count()
  print(otherCount.toString())
}

// WHY: ConsumedByStore through a SHADOWING `let` — `let rows = other` hands `other` to the new
// `rows`, so the read of `other` is refused (C5a).
function m8ConsumedViaAliasShadow() -> Nothing {
  let wire: Channel<Array<Int>> = Channel<Array<Int>>(2)
  let other: Array<Int> = [2]
  let rows = other
  wire.send(rows)
  let otherCount = other.count()
  print(otherCount.toString())
}

// WHY: ParamNeedsGive at a SEND — `rows` is a parameter with no ownership word, and the body
// gives it away into `wire`; only a `give` parameter can be given away. The word travels up:
// the caller's own binding must be consumed too, and only `give` in this signature does that.
function m8ParamNeedsGiveAtSend(lend wire: Channel<Array<Int>>, rows: Array<Int>) -> Nothing {
  wire.send(rows)
}

// WHY: ParamNeedsGive at a GIVE-PARAMETER CALL — `rows` is bare and is passed to `m8Eat`'s
// `give` position. This is `check_arg_ownership`'s former silent consume of a bare parameter
// (the relay hole), now the error; the `share` variant below is the retired share-refusal
// folded into the same template.
function m8ParamNeedsGiveAtCall(rows: Array<Int>) -> Nothing {
  m8Eat(rows)
}

function m8ParamNeedsGiveShare(share rows: Array<Int>) -> Nothing {
  m8Eat(rows)
}

// WHY: the whole relay chain in ONE compile — `m8HopB` sends its bare parameter, so
// `consumed[m8HopB][1]` is true in the fixpoint before any body is checked; `m8HopA`'s call
// `m8HopB(wire, rows)` is therefore a give position in the same build and A's own missing
// `give` is reported beside B's. Two ParamNeedsGive errors, one build, each one word to fix.
function m8HopB(lend wire: Channel<Array<Int>>, rows: Array<Int>) -> Nothing {
  wire.send(rows)
}

function m8HopA(lend wire: Channel<Array<Int>>, rows: Array<Int>) -> Nothing {
  m8HopB(wire, rows)
}

// WHY: the reviewer's program with `give` declared — `wait m8Producer(wire, rows)` consumes
// entrypoint-side `rows` through the one transfer decision, exactly as any other `give`
// parameter would, so the later read is the existing use-after-give error (`Consumed`).
function m8Producer(lend wire: Channel<Array<Int>>, give rows: Array<Int>) -> Nothing {
  wire.send(rows)
}

function m8GivenThenRead() -> Nothing {
  let wire: Channel<Array<Int>> = Channel<Array<Int>>(2)
  let rows: Array<Int> = [1, 2, 3]
  wait m8Producer(wire, rows)
  let rowCount = rows.count()
  print(rowCount.toString())
}

// WHY: TransferNeedsCopy — a FIELD (`bucket.rows` is `Reaches(bucket)`; `bucket` still holds
// it). The fix is `m8Eat(bucket.rows.copy())` (probe 2).
function m8TransferNeedsCopyField() -> Nothing {
  let bucket: Bucket = { rows: [1, 2, 3] }
  m8Eat(bucket.rows)
}

// WHY: TransferNeedsCopy — a LOOP CELL (`row` is one cell of `matrix`, which the loop is
// walking — `Cell` origin, never transferable). Refusing `matrix[0]` while admitting its
// loop-variable twin was probe 3's hole.
function m8TransferNeedsCopyLoopCell(lend wire: Channel<Array<Int>>) -> Nothing {
  let matrix: Array<Array<Int>> = [[1, 2], [3]]
  for (row in matrix) {
    wire.send(row)
  }
}

// WHY: TransferNeedsCopy — a CALL RESULT THAT RETURNS A PIECE of its argument (`m8Pick`
// returns `b`, so `again` is `Reaches(held)` under the `returns_fresh` fact — probe 7).
function m8TransferNeedsCopyReturnsPiece() -> Nothing {
  let held: Maybe<Array<Int>> = none
  let again = m8Pick(held)
  m8EatBucket(again)
}

// WHY: TransferNeedsCopy — a NESTED LITERAL built from a named heap value (`[a]` is
// `Reaches(a)`; `a` still holds its cells — probe 8). Literal elements as consuming sinks are
// a four-field deferral; until then the outer literal cannot itself be transferred.
function m8TransferNeedsCopyNestedLiteral() -> Nothing {
  let wire: Channel<Array<Array<Int>>> = Channel<Array<Array<Int>>>(2)
  let a: Array<Int> = [1, 2]
  let outer = [a]
  wire.send(outer)
}

// WHY: UFCS NON-RECEIVER give — `bucket.stash(rows)` passes `rows` to a `give` position that
// is not the dot-call receiver; the shared call-form normalization now reaches it, `rows` is
// consumed, and the read afterward is the use-after-give error (probe 1).
function m8UfcsNonReceiverGive() -> Nothing {
  let bucket: Bucket = { rows: [] }
  let rows: Array<Int> = [1, 2, 3]
  bucket.m8Stash(rows)
  let rowCount = rows.count()
  print(rowCount.toString())
}

// WHY: `dynamic Contract` dispatch, covered BY CONSTRUCTION — `ContractSigDef` carries the
// contract's declared modifiers, so the dispatch site's `give` position runs the same transfer
// decision: a field reaches through `bucket` → TransferNeedsCopy. Compile-time-only (codegen
// refuses every dynamic-dispatch call site today); the eighth probe.
shape Eater {
  swallow(share self, give rows: Array<Int>) -> Nothing
}

shape Goat follows Eater {
  name: String
}

function swallow(share self: Goat, give rows: Array<Int>) -> Nothing {
  let rowCount = rows.count()
  print(rowCount.toString())
}

function m8DynamicContractGive(d: dynamic Eater) -> Nothing {
  let bucket: Bucket = { rows: [1, 2, 3] }
  d.swallow(bucket.rows)
}

// WHY: the cannot-give-const refusal, EXTRACTED with a sink-supplied WHAT-INSTEAD: at a send
// the advice is `wire.send(rows.copy())` — "declare it with `let`" is wrong for a send, where
// the caller keeping the value is the whole point.
function m8ConstSent() -> Nothing {
  let wire: Channel<Array<Int>> = Channel<Array<Int>>(2)
  const rows: Array<Int> = [1, 2, 3]
  wire.send(rows)
}

// WHY: HandleChannelArgNeedsBinding — the handle form's command channel comes from a call, not
// a named binding, so nothing outside the task could ever `close()` it: a hard compile ERROR
// because a warning would leave the hang class live for one spawn shape
// while the fix costs one `let`.
function m8MakeWire() -> Channel<Int> {
  let w: Channel<Int> = Channel<Int>(4)
  return w
}

function m8Doubler(lend commands: Channel<Int>) -> Int errors {
  let c = commands.receive()
  if (c.exists()) {
    return c.value + c.value
  }
  return 0
}

function m8HandleChannelArgNeedsBinding() -> Nothing {
  let h = background m8Doubler(m8MakeWire())
  h.send(21)
}

// WHY: the unknown-method list SPLITS per receiver — a channel's reads
// `send(value), receive(), close()`, a handle's stays `send(value), receive()` (there is no
// `h.close()`: a handle is a message line to the child, not the channel's lifecycle).
function m8UnknownMethodOnChannel() -> Nothing {
  let wire: Channel<Int> = Channel<Int>(2)
  wire.peek()
}

// WHY: `.close()` takes no arguments — "Call it bare: wire.close()".
function m8CloseWithArgs() -> Nothing {
  let wire: Channel<Int> = Channel<Int>(2)
  wire.close(1)
}

// WHY: the use-after-give error for an alias pair consumed by the SAME call — every call form
// infers all of its arguments before any position consumes, so the read of `other` at
// position 1 is seen only by the transfer decision, which compares against the classes
// consumed BEFORE the call, so `eat2(rows, other)` is refused. `{via}` names `bucket` as what was given away. (C5a: the class-mate is a piece of
// `bucket`; a whole-value alias is refused where it is made.)
function m8Eat2(give owner: Bucket, give piece: Array<Int>) -> Nothing {
  print(`${owner.rows.count()} ${piece.count()}`)
}

function m8SameCallAliasGiveGive() -> Nothing {
  let bucket: Bucket = { rows: [1, 2, 3] }
  let other: Array<Int> = bucket.rows
  m8Eat2(bucket, other)
}

// WHY: the mixed form — `bucket` given at position 0, its class-mate `other` (a piece of `bucket`) READ (`share`) at
// position 1 of the same call: a read after free inside the callee, refused with the same
// use-after-give error.
function m8Mix(give owner: Bucket, share piece: Array<Int>) -> Nothing {
  print(`${owner.rows.count()} ${piece.count()}`)
}

function m8SameCallAliasGiveShare() -> Nothing {
  let bucket: Bucket = { rows: [1, 2, 3] }
  let other: Array<Int> = bucket.rows
  m8Mix(bucket, other)
}

// WHY: there is no `h.close()` — a handle is a message line TO the child, not the channel's
// lifecycle; the unknown-method list on a HANDLE stays `send(value), receive()` and points
// at the channel binding (`commands.close()`) as the act. Last in the file on purpose: its
// asserted phrase lives in the WHAT-INSTEAD of the final diagnostic.
function m8CloseOnHandle() -> Nothing {
  let commands: Channel<Int> = Channel<Int>(2)
  let h = background m8Doubler(commands)
  h.close()
}

// WHY: MessageBeforeFailedCheck — `REF-errors.md:171-175` requires a `.failed()` check
// before reading `.message` (and `.suggestions`/`.trace`/`.source`). `late` here is never
// checked, so the read is refused at compile time rather than reading a null error at runtime.
function m8MessageBeforeFailedCheck() -> Nothing {
  let wire: Channel<Int> = Channel<Int>(2)
  wire.close()
  let late = wire.send(9)
  print(late.message)
}

// ────── positive reference case ──────

function entrypoint() -> Nothing {
  print(`M8 error gallery`)
}
