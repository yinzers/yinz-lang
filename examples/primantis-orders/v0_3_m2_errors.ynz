// v0.3-M2 compile-error gallery
//
// Every block below intentionally triggers a diagnostic class added in v0.3-M2
// that is still active. WaitInsideLoop and LocalCrossesWait were lifted in M3a
// and compile clean — their triggers have been removed from this file.
// Run `ynz build v0_3_m2_errors.ynz` to see all diagnostics.
// Yinz reports up to 50 diagnostics per compile so a single run surfaces all.
//
// Each block has a // WHY: comment naming the diagnostic class it exercises.

// -- v0.3-M2 Error Class 1: suspending call in a sub-expression position --
//
// WHY: SubExpressionSuspendPosition — a suspending call nested inside a larger
// expression (as an operand, argument, interpolation slot, or condition) is a
// permanent compile error. Give it its own `let` line first. Step-by-step style
// (one operation per line, named variable) is required so the compiler can
// analyze independent statements and auto-parallelize them in M3b. Expression-
// position suspension would prevent that analysis.
//
// The HALT-class bug this closes: before Fix 1, this pattern silently called
// block_on from inside a Tokio worker thread → non-unwinding abort, exit 0.
// Now typeck rejects it before codegen fires, producing a clean teaching error.

function pauseThenReturn() -> int {
    wait sleep(50)
    return 7
}

function triggerSubExprSuspend() -> nothing {
    // WHY: SubExpressionSuspendPosition — pauseThenReturn() is a suspending
    // call inside an arithmetic expression; give it its own line first.
    let doubled = 2 * pauseThenReturn()
    print(`doubled: ${doubled}`)
}

// -- v0.3-M2 Error Class 2: mutually-recursive suspending functions --
//
// WHY: MutualRecursionSuspendingCycle — two or more distinct suspending functions
// that call each other form a cycle with mixed frame layouts. SpawnStateFnFuture::Drop
// walks the recursion chain assuming uniform layout (self-recursion); mixed layouts
// corrupt heap on cancellation. This is a permanent design constraint: mutually-
// recursive suspending cycles are rare in practice and can always be restructured —
// extract shared logic into a helper, make one function non-suspending, or use a
// self-recursive form. Structuring as self-recursion (one function calling itself)
// or removing `wait` from the cycle are the supported alternatives.

function orderPing(n: int) -> nothing {
    wait sleep(10)
    // WHY: MutualRecursionSuspendingCycle — orderPing calls orderPong which calls
    // orderPing back, forming a mutual cycle where both functions suspend.
    orderPong(n - 1)
}

function orderPong(n: int) -> nothing {
    wait sleep(10)
    orderPing(n - 1)
}

// -- v0.3-M2 Error Class 3: `wait` on a non-call expression --
//
// WHY: WaitOnNonCallExpression — `wait` must be followed by a function call.
// A primitive value (int, string, bool) is not a call and cannot be a suspension
// point. Write `wait someFn()` to wait for a function to complete.

function triggerWaitNonCall() -> nothing {
    // WHY: WaitOnNonCallExpression — `wait` applied to a literal integer, not a call.
    wait 42
    print(`order fulfilled`)
}

// -- v0.3-M2 Warning Class 1: redundant `wait` on a non-suspending call --
//
// WHY: WaitOnNonMayBlock — `wait` on a call to a purely CPU-bound function has
// no effect. `print` never suspends; the `wait` keyword is noise here.
// The compiler emits a warning (not an error) and the program still runs.
// Remove the `wait` for clarity.

function triggerRedundantWait() -> nothing {
    // WHY: WaitOnNonMayBlock — print() is CPU-bound; wait has no effect here.
    wait print(`order received`)
}

// -- v0.3-M2 Error Class 4: can't-infer from dynamic-dispatch vtable --
//
// WHY: CantInferDynamicDispatch — a suspending function calling a method on a
// `dynamic Contract` value can't determine the concrete callee's suspension
// status at compile time. Use a concrete type, or restructure so the call is
// statically resolvable. Dynamic-dispatch suspension support ships in a future
// version.

shape Vendor {
    processOrder(share self) -> nothing
}

shape PrimantisVendor follows Vendor {
    name: string
}

function processOrder(share self: PrimantisVendor) -> nothing {
    print(`Primantis order processed`)
}

function triggerCantInferDynamic(v: dynamic Vendor) -> nothing {
    sleep(10)
    // WHY: CantInferDynamicDispatch — v.processOrder() is a dynamic-dispatch
    // call from a suspending function; concrete callee unknown at compile time.
    v.processOrder()
}

// -- v0.3-M2 Error Class 5: can't-infer from cross-module call --
//
// WHY: CantInferCrossModule — calling a function defined in another file from
// inside a suspending function is a compile error in v0.3-M2. The compiler
// analyzes one compilation unit; cross-module suspension propagation ships in
// v0.3-M3b via the M8 multi-file query.
//
// NOTE: this error class requires a multi-file project to trigger. See the
// integration test fixture at:
//   crates/ynz-driver/tests/fixtures/v0_3_m2_cant_infer_cross_module/
// for an end-to-end example. A single-file gallery cannot trigger cross-module
// errors because all functions are in one compilation unit.

// -- Happy-path (correct v0.3-M2 forms) --

// Direct-statement form — no sub-expression nesting.
function validSuspendingHelper() -> int {
    wait sleep(10)
    return 42
}

function validDirectStatementCall() -> nothing {
    let result = validSuspendingHelper()
    print(`result: ${result}`)
}

// Self-recursion — single function calling itself is the M2-supported form.
function countdown(n: int) -> nothing {
    if (n <= 0) {
        print(`done`)
        return
    }
    wait sleep(10)
    countdown(n - 1)
}

function entrypoint() -> nothing {
    // All the trigger functions above will cause compile errors, so entrypoint
    // is here as a placeholder for the gallery runner.
    print(`v0.3-M2 error gallery loaded`)
}
