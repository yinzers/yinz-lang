// examples/basics/src/entrypoint.ynz
//
// The Yinz v0.1 Language Showcase — grows milestone-by-milestone.
// Compile + run with: ./target/debug/ynz run examples/basics/
//
// M8: this file is now the ENTRYPOINT of a multi-file project.
// Companion modules: services/players.ynz, utils/math_extra.ynz
// See examples/basics/README.md for what each section demonstrates.
//
// Current coverage: M1 + M2 + M3 + M4 + M5 + M6 + M7 + M8 (modules, doc comments,
// sensitive, concurrency keywords, bignum).
// M4+ sections are added by each milestone's phases per
// .claude/rules/plan-invariants.md `### Demo & Error Gallery` requirement.

// M8 module imports — bring names from companion modules into scope.
// Cross-file symbol resolution: cross-file CALLS ship in v0.2; the syntax and
// multi-file project structure ship here in v0.1.
import { newPlayer, greet } from `services/players`
import { clamp, square } from `utils/math_extra`

function entrypoint() -> nothing {
  // ────── M1: hello-world end-to-end ──────
  print(`Yinz v0.1 language showcase`)
  print(`===========================`)
  print(``)

  // ────── M2: variables, arithmetic, primitives, conversions ──────
  print(`M2 — variables, arithmetic, primitives:`)

  // let vs const (M2 const-reassignment check)
  const playerName = `Cheddar`
  let score: int = 0

  // Primitive types — int, float, number (decimal128), bool
  const startHealth: int = 100
  const damageMultiplier: float = 1.5
  const accountBalance: number = 1234.56     // decimal128, exact
  const isActive: bool = true

  // Arithmetic, comparison, boolean
  let combo = startHealth + 25
  combo = combo * 2
  combo = combo - 50
  combo = combo / 3

  // Bitwise operators
  const flagRead: int = 1
  const flagWrite: int = 2
  const flagExecute: int = 4
  const perms = flagRead | flagWrite
  const hasExecute = (perms & flagExecute) != 0

  // Polymorphic print across primitive types
  print(playerName)
  print(combo)
  print(damageMultiplier)
  print(accountBalance)
  print(isActive)
  print(perms)
  print(hasExecute)

  // M2 conversion intrinsic: .toString()
  const scoreText = score.toString()
  print(scoreText)

  print(``)

  // ────── M3: control flow + user-defined functions ──────
  print(`M3 — control flow + user functions:`)

  // if + early return demoed via the helper functions below
  print(classifyHealth(startHealth))
  print(classifyHealth(50))
  print(classifyHealth(10))

  // Multi-case if (M3 match form with else => catch-all)
  const grade = letterGrade(85)
  print(grade)

  // while loop
  let countdown = 3
  while (countdown > 0) {
    print(countdown)
    countdown = countdown - 1
  }

  // for + range
  let sum = 0
  for (i in range(1, 6)) {
    sum = sum + i
  }
  print(sum)  // 1+2+3+4+5 = 15

  // Recursion (mutual recursion exercised by isEven/isOdd below)
  print(fib(10))      // 55
  print(isEven(8))    // true
  print(isOdd(7))     // true

  // ────── M4: shapes + functions + ownership ──────
  // P2 (parser) shipped: shape declarations, field access, struct literals,
  //   .copy()/.freeze() postfix ops, dynamic types, ownership modifiers on params.
  // After M4 P3a (typeck): struct literals type-check against annotated shape
  // After M4 P3b (typeck): extends + follows + dynamic dispatch work
  // After M4 P3c (typeck): full borrow-check enforced
  // After M4 P4 (codegen): end-to-end compile + run
  // After M4 P5 (catch-up): int.max, int.min, number.epsilon, .wrappingAdd() etc.
  // ────── M4: shapes + UFCS methods + ownership ──────
  print(``)
  print(`M4 — shapes + methods + ownership:`)
  let p: Player = { name: `Cheddar`, health: 100 }
  greetPlayer(p)
  healPlayer(p, 20)
  greetPlayer(p)

  // ────── M5: generics + collections + maybe ──────
  print(``)
  print(`M5 — generics + collections:`)

  // Generic function — identity<T> infers T from argument
  print(identity(42))
  print(identity(`generic`))

  // array<T>: heap-growable, literal init
  let nums: array<int> = [10, 20, 30]
  nums.add(40)
  print(nums.count())
  print(nums[0].or(-1))

  // fixed<T>: stack-allocated, size locked
  let tags: fixed<int> = [100, 200, 300]
  print(tags.count())
  print(tags[2].or(-1))

  // maybe<T>: absence without null
  let score: maybe<int> = none
  print(score.or(0))

  // map<K,V>: hash map with string keys
  let lookup: map<string, int> = { `alice`: 90, `bob`: 85 }
  print(lookup[`alice`].or(0))
  print(lookup.count())

  // ────── M6: options + unions + narrowing ──────
  print(`M6 — options, unions, narrowing:`)

  // Options: declaration + value use + multi-case
  let status: Status = Status.active
  print(status.toString())
  if (status) {
    active  => print(`active`)
    pending => print(`pending`)
    banned  => print(`banned`)
  }

  // Options equality
  let eq = status == Status.active
  print(eq.toString())

  // Fallible conversions
  let parsed: maybe<int> = `42`.toInt()
  print(parsed.or(0).toString())
  let fromFloat: maybe<int> = (3.14).toInt()
  print(fromFloat.or(-1).toString())
  let fromInt: int = (99).toInt()
  print(fromInt.toString())

  // Early-return narrowing on maybe<T>
  let nums: array<int> = [10, 20, 30]
  let first = firstOrDefault(nums)
  print(first.toString())

  // ────── M7: strings, errors, iterables ──────
  print(``)
  print(`M7 — full strings, errors, iterables:`)

  // String interpolation in a real message
  const playerName2 = `Alice`
  const playerScore = 150
  const msg = `Player ${playerName2} scored ${playerScore} points!`
  print(msg)

  // Multi-line string with trim
  const announcement = `
  Welcome to the tournament!
  Top player: ${playerName2}
`
  print(announcement.trim())

  // String methods
  const bio = `  Hello, World!  `
  print(bio.trim())
  print(`hello`.toUpperCase())
  print(`WORLD`.toLowerCase())
  print(`hello`.contains(`ell`).toString())
  print(`hello`.startsWith(`hel`).toString())
  print(`hello`.endsWith(`lo`).toString())
  const idx = `hello world`.indexOf(`world`)
  print(idx.or(-1).toString())

  // Code point iteration — counts 4 code points in "café"
  let charCount = 0
  for (c in `café`) {
    charCount = charCount + 1
  }
  print(charCount.toString())

  // String splitting
  const csv = `a,b,c,d`
  const parts = csv.split(`,`)
  print(parts.count().toString())

  // errors keyword — fallible function with .or() fallback
  const ratio = safeDivide(10, 2).or(0)
  print(ratio.toString())

  // errors with .failed() check (function always succeeds here)
  const ok = safeDivide(10, 5)
  if (ok.failed()) {
    print(`safeDivide failed`)
  }
  print(ok.toString())

  // for loop with first-class range
  let r = range(0, 3)
  for (i in r) {
    print(`range item: ${i}`)
  }

  // for loop over string characters
  for (c in `abc`) {
    print(`char: ${c}`)
  }

  // User-defined iterable shape — Countdown counts down from N
  let cd: Countdown = { from: 3, current: 0 }
  for (n in cd) {
    print(n.toString())
  }

  // ────── M8: bignum (number<N> for N > 34) ──────
  let a: number<100> = 0.1
  let b: number<100> = 0.2
  let c: number<100> = a + b
  print(``)
  print(`M8 — bignum (number<100>):`)
  print(`  0.1 + 0.2 = (see next line)`)
  print(c)

  // ────── M8: modules (syntax demo) ──────
  // Import statements above bring names from companion modules into scope.
  // Cross-file CALLS (using newPlayer / clamp etc. here) ship in v0.2 when
  // the typeck learns to resolve symbols across compilation units.
  // In v0.1 the import/export SYNTAX is locked and the multi-file driver works
  // (all .ynz files under src/ are compiled and linked together).
  print(``)
  print(`M8 — modules, multi-file project:`)
  print(`  import { newPlayer, greet } from services/players`)
  print(`  import { clamp, square } from utils/math_extra`)
  print(`  Multi-file build: ALL .ynz files under src/ compiled + linked.`)

  // ────── Deferred features (v0.2+) ──────
  // arena scratch { let temp: array<int> = [...] }  // v0.2 — design/future/arena.md
  // verified { let raw = rawMemory(64) }              // v0.3+ — vocabulary.md
  // Self-referential shapes                           // v0.3+ — design/future/self-references.md
  // Union codegen (classifyAccount) — requires P4 codegen
  // newPlayer("Patrick")                              // v0.2 — cross-file calls need cross-file typeck
}

// ────── M3 helper functions ──────

// Classify health into a status string. Uses early return.
function classifyHealth(hp: int) -> string {
  if (hp >= 75) {
    return `healthy`
  }
  if (hp >= 25) {
    return `wounded`
  }
  return `critical`
}

// Multi-case `if (value) { arms => ... else => ... }` for letter grading.
function letterGrade(percent: int) -> string {
  // Multi-case form — each arm is a value pattern; `else =>` is the catch-all
  if (percent) {
    100 => return `A+`
    else => {
      if (percent >= 90) { return `A` }
      if (percent >= 80) { return `B` }
      if (percent >= 70) { return `C` }
      if (percent >= 60) { return `D` }
      return `F`
    }
  }
  return `F`  // unreachable but typeck requires every path returns
}

// Classic recursive fib — exercises user-defined function with int param + recursion.
function fib(n: int) -> int {
  if (n < 2) {
    return n
  }
  return fib(n - 1) + fib(n - 2)
}

// Mutual recursion — isEven calls isOdd and vice versa.
function isEven(n: int) -> bool {
  if (n == 0) { return true }
  return isOdd(n - 1)
}

function isOdd(n: int) -> bool {
  if (n == 0) { return false }
  return isEven(n - 1)
}


// ────── M4: shapes + UFCS methods + ownership ──────

shape Player {
  name: string
  health: int
}

function greetPlayer(share self: Player) -> nothing {
  print(self.name)
}

function healPlayer(lend self: Player, amount: int) -> nothing {
  self.health = self.health + amount
}

// ────── M5: generics + collections + maybe ──────

function identity<T>(give value: T) -> T {
  return value
}

// ────── M6: options + unions + narrowing ──────

options Status { pending, active, banned }

shape ActiveAccount { name: string }
shape BannedAccount { reason: string }
shape PendingAccount { email: string }
shape AccountResult = ActiveAccount | BannedAccount | PendingAccount

function classifyAccount(account: AccountResult) -> string {
  if (account) {
    is ActiveAccount  => return `OK`
    is BannedAccount  => return `DENIED`
    is PendingAccount => return `WAIT`
  }
  return `UNKNOWN`
}

function firstOrDefault(share nums: array<int>) -> int {
  let r = nums.first()
  if (!r.exists()) { return -1 }
  return r.value
}

// ────── M7: strings, errors, iterables ──────

// safeDivide: an errors-capable function — caller uses .or() or .failed()
function safeDivide(a: int, b: int) -> int errors {
  return a / b
}

// Countdown: user-defined iterable shape — walks 3, 2, 1 sequence
shape Countdown {
  from: int
  hidden current: int
}

// next: standalone function satisfying the Iterable<int> protocol for Countdown.
// Returns the next value or none when exhausted.
function next(lend self: Countdown) -> maybe<int> {
  if (self.current >= self.from) {
    return none
  }
  let items: fixed<int> = [3, 2, 1]
  let result = items.get(self.current)
  self.current = self.current + 1
  return result
}
