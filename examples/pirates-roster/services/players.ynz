// services/players.ynz — exported shapes and functions for Pirates roster management.
// Demonstrates: export shape, export function, doc comments, UFCS across modules.

/// A Pittsburgh Pirate. Tracks display name and career hit total.
export shape Pirate {
  /// The player's display name (e.g., "Roberto Clemente").
  name: string
  /// Career hits at the major-league level. Starts at 0 for rookies.
  careerHits: int
}

export function newPirate(name: string) -> Pirate {
  return { name: name, careerHits: 0 }
}

export function announce(player: Pirate) -> string {
  return `Now batting: ${player.name}!`
}

export function recordHits(player: Pirate, count: int) -> Pirate {
  return { name: player.name, careerHits: player.careerHits + count }
}
