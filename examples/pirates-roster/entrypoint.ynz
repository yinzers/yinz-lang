// Cmd+click `greet` to jump to its function declaration.
// Right-click `Player` → "Find All References" to see every use across files.
// Press F2 on `greet` → type a new name → atomic rename across all files.
// Note the muted `: int (from 42)` hint after `let score = 42`.
// Note the muted `share` hint after `player` in `greet(player)`.
// Format on save rewrites the file to canonical Yinz style via ynz-fmt.
// Code actions offer quick-fixes for any diagnostic with a WHAT-INSTEAD.
// Semantic tokens show keywords in one color, types in another, variables in a third.

// ────── v0.3-M1 helper ──────

function recordPittsburghAnalytics(event: string) -> nothing {
  // Sleep 200ms (simulating slow disk write) so the main thread visibly
  // gets ahead of us.
  // NOTE: `sleepBlocking` (NOT `wait`) — `wait` is the keyword and stays
  // synchronous in M1; the state-machine suspension semantics ship in v0.3-M2.
  // `sleepBlocking` is the Yinz-language intrinsic added in v0.3-M1 (P2).
  sleepBlocking(200)
  print(`background analytics done`)
}

// ────── v0.2.1-M10: Three Rivers schedule — import-pattern coverage ──────
//
// Each declaration below exercises an AST position that previously triggered a
// spurious "imported but never used" warning. Building with zero such warnings
// proves that Bugs 1 and 2.1–2.5 hold in a realistic multi-file project.
//
// Driver constraints noted:
//   - options types as function PARAMETER types are not yet lowered in codegen
//     (v0.1 limitation); options imports are exercised via variant access,
//     field types, module-const, and generic fields instead.
//   - Cross-file `follows` and `extends` cannot be demonstrated here because
//     `collect_shapes` (shapes.rs:298-322) builds `all_names` only from
//     module-local items. The `all_names.contains(contract)` guard at shapes.rs:406
//     and `all_names.contains(parent)` at shapes.rs:393 reject imported contract/parent
//     names with "not defined" before the unused-import check even runs. Imported shapes
//     ARE seeded into the shape_table (shapes.rs:244) but not into `all_names`, so
//     cross-file `follows`/`extends` is a compile error today. Both patterns are covered
//     by dedicated typeck unit tests (see `two_file_db` tests in
//     crates/ynz-typeck/tests/unused_import_false_positives.rs:
//     `follows_contract_does_not_warn_unused_import` and
//     `extends_parent_does_not_warn_unused_import`). The root cause is tracked in
//     .claude/todos.md "m8-typeck-cross-file-resolution" — fixing it is out of M10 scope.
//
// Pattern map (import → AST position exercised in this file):
//   ScheduleDay         → options-variant access  (Bug 1: Timeframe.fiveMinute repro)
//   StripeDistrictEvent → is-narrowing             (Bug 2.1: multi-case if arm)
//   Announceable        → dynamic contract         (Bug 2.4: dynamic Announceable param)
//   ScheduleDay         → shape field-type         (Bug 2.3: field: ScheduleDay in ShapeDecl)
//   ScheduleDay         → module-const type        (Bug 2.3: const …: ScheduleDay = …)
//   StatCategory        → generic field type       (Bug 2.5: concrete field in shape<T>)
//   SouthSideEvent      → union-alias RHS member   (Phase 0 alias_ty walk in ShapeDecl arm)
// follows/extends (Bug 2.2): covered by unit tests (shapes.rs:393/406 limitation above).
// Union alias RHS: exercised in Pattern 9 below (SouthSideEvent → shape RiverEvent) AND
//   by unit tests in crates/ynz-typeck/tests/unused_import_false_positives.rs:
//   union_alias_rhs_member_does_not_warn_unused_import +
//   union_alias_rhs_with_options_member_does_not_warn_unused_import.
// The driver calls the same check_query path as the unit tests — both exercise the
// Phase 0 ShapeDecl arm's alias_ty walk (check.rs:273-274). Zero spurious warnings
// confirmed by the demo build at Phase 11 completion.

// Pattern 1 — options-variant access (Bug 1).
// ScheduleDay is referenced via ScheduleDay.home — the exact variant-access form
// that triggered the false positive before check_options_value was patched.
// The variant is accessed in a body expression (not a function parameter) because
// options types as function parameter types are not yet codegen-lowered in v0.1.
function showOpeningDay() -> nothing {
  let openingSlot = ScheduleDay.home
  print(openingSlot.toString())
  if (openingSlot == ScheduleDay.doubleHeader) {
    print(`doubleheader at PNC Park`)
  }
}

// Pattern 2 — is-narrowing (Bug 2.1).
// StripeDistrictEvent is imported and used only via the multi-case `is` arm.
// A local shape provides the other union arm; StripeDistrictEvent is the arm
// whose name is tracked via check_is_arm_pattern (the fixed path).
shape LocalVenueEvent {
  venue: string
}

shape PghMarketEvent = StripeDistrictEvent | LocalVenueEvent

function describeMarketEvent(e: PghMarketEvent) -> string {
  if (e) {
    is StripeDistrictEvent => {
      return `Strip District vendor stand`
    }
    is LocalVenueEvent => {
      return `other Pittsburgh venue`
    }
  }
  return `unknown`
}

// Pattern 9 — union-alias RHS member.
// SouthSideEvent is imported and used ONLY as a member on the union-alias RHS.
// This exercises the Phase 0 ShapeDecl arm's alias_ty walk (check.rs:273-274):
// check_module now calls collect_referenced_names_in_ast_type on alias_ty, so
// union members are visible to referenced_names even though no function body
// references them. The driver calls the same check_query path as the unit tests.
shape RiverEvent = SouthSideEvent | LocalVenueEvent

// Pattern 7 — dynamic contract (Bug 2.4).
// Announceable is imported and used as `dynamic Announceable` in a parameter
// type. This exercises the AstType::Dynamic branch fixed in check.rs.
function runAnnouncement(a: dynamic Announceable) -> nothing {
  print(`announcing`)
}

// Pattern 5 — shape field-type annotation (Bug 2.3).
// ScheduleDay is imported and used only as a field type in a local shape.
// This exercises the check_module ShapeDecl field-type walk that was added for
// Bug 2.3 — the same walk also covers follows/extends parent names (Bug 2.2),
// so fixing the field-type path fixed all three positions in one patch.
shape ScheduleSlot {
  day: ScheduleDay
  runsScored: int
  opponent: string
}

// Pattern 6 — module-const type annotation (Bug 2.3).
// ScheduleDay appears as both the type annotation and the initializer value,
// exercising the check_module ConstDecl arm's collect_referenced_names_in_ast_type
// and collect_referenced_names_in_expr walks added for Bug 2.3.
export const OPENING_DAY_SLOT: ScheduleDay = ScheduleDay.home

// Pattern 8 — generic shape with concrete imported field type (Bug 2.5).
// StatCategory is imported from utils/math_extra and used as a concrete field
// type inside a generic shape. Before the fix, the field-walk in check_module
// skipped the entire ShapeDecl for generic shapes (generics.is_empty() guard),
// so StatCategory was never recorded. The fix walks concrete fields while
// skipping bare TypeParam placeholders.
shape StatBook<T> {
  entry: T
  category: StatCategory
  seasonYear: int
}

// ── v0.3-M3a Phase 4: for-loop + crossing-local suspension ───────────────────
//
// `wait sleep` now works inside a `for` body (P3 lifted WaitInsideLoop for `for`
// and `match`). The loop index is frame-backed — it survives each suspension —
// and any local declared BEFORE the loop can be updated across the suspensions.
//
// `tallyScouts` processes scouting ratings for a list of pirates one-by-one,
// pausing between each to simulate an async report fetch. `total` is a crossing
// local: it is declared before the loop, updated inside it across multiple `wait`
// suspensions, and read after the loop ends. ONE `ynz_alloc` covers the whole
// task — no per-iteration allocation.

function tallyScouts(ratings: array<int>) -> int {
  // `total` is a crossing local — declared before the loop, accumulated across
  // each `wait sleep`, read after the loop. The compiler frame-backs it so each
  // resumed iteration sees the correct running total.
  let total: int = 0
  for (rating in ratings) {
    // Simulate an async scout-report fetch between ratings.
    wait sleep(5)
    total = total + rating
  }
  return total
}

// m3a_p4_demo — called from entrypoint() to show for-loop + crossing-local
// suspension in realistic context. Each rating is processed with a pause;
// the accumulated total crosses every suspension boundary unscathed.
function m3a_p4_demo() -> nothing {
  print(``)
  print(`v0.3-M3a Phase 4 — for-loop + crossing-local suspension (5 scouts, ~25ms total):`)
  let pirateRatings: array<int> = [85, 92, 78, 95, 88]
  let scoutTotal = wait tallyScouts(pirateRatings)
  let scoutStr = scoutTotal.toString()
  print(`scout total: ${scoutStr}`)
}

// ── v0.3-M3e: cross-module suspension ────────────────────────────────────────
//
// fetchScoutGrade is exported from services/scouting.ynz. Calling it here
// crosses a module boundary: this entrypoint is one compilation unit; scouting.ynz
// is another. The compiler's frame_layouts_query resolves the callee's LLVM-accurate
// FrameLayout (total_size, n_locals) so the sub-frame is embedded at the right offset
// in entrypoint's composed frame. No universal reject, no silent miscompile.
//
// The returned grade string drives a verdict decision — the result does real work
// across the boundary, not just a trivial print.

// reviewTopProspect fetches a single player's scouting grade across the module
// boundary and prints a verdict based on the result. The `summary` variable is a
// crossing local: it is bound before the suspension and read again after resume
// to build the printed line.
function reviewTopProspect(name: string, atBats: int) -> nothing {
  let summary = wait fetchScoutGrade(name, atBats)
  let verdict: string = `average`
  if (summary.endsWith(`A`)) {
    verdict = `elite`
  }
  print(`${summary} — ${verdict}`)
}

// m3e_demo calls the cross-module suspending functions in two realistic contexts:
//   1. A direct cross-module suspending call whose result drives a verdict.
//   2. A full-roster ranking via rankRoster — cross-module suspension in a loop.
function m3e_demo() -> nothing {
  print(``)
  print(`v0.3-M3e — cross-module suspension (scouting grades from services/scouting):`)

  // Direct cross-module suspending call: fetch one grade, use the result.
  reviewTopProspect(`McCutchen`, 400)
  reviewTopProspect(`Clemente`, 300)

  // Cross-module suspension driving a count: rankRoster suspends per player
  // to fetch each grade, accumulates A grades, and returns the total.
  let names: array<string> = [`Stargell`, `Mazeroski`, `Wagner`, `Kiner`]
  let atBats: array<int> = [380, 290, 420, 310]
  let aCount = wait rankRoster(names, atBats)
  let aStr = aCount.toString()
  print(`roster A-grade count: ${aStr}`)
}

// ── v0.3-M3a Phase 2: while-loop suspension ──────────────────────────────────
//
// `wait sleep` now works inside a `while` body. Loop-carried locals are
// frame-backed (one `ynz_alloc` for the whole task, not per-iteration).
// Iterations are sequential: each pause-and-resume is a single poll cycle.
//
// awaitCrewReady simulates checking each pirate's readiness with a delay between
// checks. The counter `i` and accumulator `ready` are loop-carried crossing locals:
// each suspension preserves them in the composed frame so the next iteration sees
// the correct values. One `ynz_alloc` for the entire loop — no per-iteration alloc.
function awaitCrewReady(checks: int) -> int {
  let ready: int = 0
  let i: int = 0
  while (i < checks) {
    wait sleep(5)
    ready = ready + 1
    i = i + 1
  }
  return ready
}

// m3a_p2_demo — called from entrypoint() to show while-loop suspension in context.
// Counts down pirate slot availability with a pause between each roster check.
// The loop counter and accumulator survive each `wait` via the frame-backed locals
// mechanism from Phase 1 — no extra allocation, sequential execution order.
function m3a_p2_demo() -> nothing {
  print(``)
  print(`v0.3-M3a Phase 2 — while-loop suspension (3 roster checks, ~15ms total):`)
  let crewCount: int = wait awaitCrewReady(3)
  let crewStr = crewCount.toString()
  print(`crew ready: ${crewStr}`)
}

// ── v0.3-M3b: auto-parallelization — the compiler overlaps independent work ───
//
// When two suspending calls have NO data dependency between them and share no
// `lend` resource, the compiler proves they are independent and overlaps their
// suspensions. The wall-clock is ≈ max(each) instead of sum — without the
// programmer writing anything special. `--no-auto-parallel` turns the overlap
// off; the OBSERVABLE OUTPUT is byte-identical either way (see below for why).
//
// fetchLowerBowlPrice and fetchUpperDeckPrice are two separate suspending price
// lookups. Each pauses ~60ms simulating a slow ticket-server round-trip, then
// returns an exact decimal128 price.

function fetchLowerBowlPrice() -> number {
  // IDE shows: wait (fetchLowerBowlPrice suspends on the sleep below)
  wait sleep(60)
  return 24.50
}

function fetchUpperDeckPrice() -> number {
  // IDE shows: wait (fetchUpperDeckPrice suspends on the sleep below)
  wait sleep(60)
  return 31.75
}

// recordPromoNight runs on a background thread (fire-and-forget). It pauses to
// simulate a slow analytics write, then prints. Main never waits for it.
function recordPromoNight(promo: string) -> nothing {
  sleepBlocking(40)
  print(`promo logged: ${promo}`)
}

// m3b_demo — three faces of v0.3-M3b in one Pittsburgh-themed scene:
//   (a) independent suspending fetches OVERLAP (≈ max, not sum);
//   (b) `wait` orders two otherwise-independent side effects;
//   (c) `background` infers give/copy for fire-and-forget work.
function m3b_demo() -> nothing {
  print(``)
  print(`v0.3-M3b — auto-parallel: two independent price fetches overlap (~60ms, not ~120ms):`)

  // (a) AUTO-PARALLEL OVERLAP.
  // These two fetches have no data dependency, so the compiler overlaps their
  // suspensions — total wait is ≈ max(60, 60) ≈ 60ms, not 60 + 60 = 120ms.
  // NOTE: there is intentionally NO `wait` between these two lines — that is what
  // lets the auto-parallel pass overlap them.
  // IDE shows: wait (fetchLowerBowlPrice may suspend on I/O)
  let lowerBowl = fetchLowerBowlPrice()
  // IDE shows: wait (fetchUpperDeckPrice may suspend on I/O)
  let upperDeck = fetchUpperDeckPrice()
  // The two prints below READ lowerBowl/upperDeck, so they are data-dependent on
  // the fetches: the compiler keeps them after both fetches complete and in this
  // exact order. The overlap is in the suspension, not the print order — so the
  // observable output is deterministic and byte-identical with --no-auto-parallel.
  print(`lower bowl ticket: ${lowerBowl}`)
  print(`upper deck ticket: ${upperDeck}`)

  // (b) `wait` AS AN ORDERING BARRIER.
  // pausePirate prints as a side effect with no return value. Two calls to it are
  // otherwise independent, but `wait` on the first forces it to finish before the
  // second begins — `wait` is the ordering barrier between the two side effects.
  print(``)
  print(`v0.3-M3b — wait orders two side effects:`)
  wait pausePirate(`Maz`)
  wait pausePirate(`Clemente`)

  // (c) `background` give/copy inference.
  // `promo` is read again on the line after the spawn, so the compiler infers
  // `.copy` automatically — the background task gets its own copy and main keeps
  // the original. (If `promo` were dead after the spawn, the compiler would infer
  // `.give` instead — no copy.) `.copy` is written explicitly here so the demo
  // reads clearly; the compiler would have inferred the same thing.
  // IDE shows: background -> routed to I/O pool (recordPromoNight has a blocking sleep)
  print(``)
  print(`v0.3-M3b — background give/copy inference:`)
  const promo = `bobblehead_night`
  background recordPromoNight(promo.copy())
  print(`main keeps the promo handle: ${promo}`)
  // Keep main alive long enough for the background task to finish and print.
  wait sleep(120)
}

// ── v0.3-M3f: codegen correctness — same-callee EC bindings + parallel-group bool ──
//
// M3f closed two silent-miscompile bugs in the state-machine codegen:
//
// Bug 1 — Same-callee wide-`errors` staging-slot aliasing: when the same
// `-> number errors` function was called twice, both bindings silently held the
// SECOND call's value. Fixed by copy-on-bind: each binding now gets its own
// per-binding stable storage before the next call can reuse the callee's staging slot.
//
// Bug 2 — Parallel-group bool sibling corrupts int frame slot: when an int and a
// boolean were both auto-grouped and crossed a subsequent `wait`, the bool's
// i1-alloca store overwrote 7 bytes of the adjacent int's alloca, returning 0.
// Fixed by truncating i64→i1 before the bool alloca store (the reload side already
// truncated; the store side was the missing half).
//
// Both bugs were mode-divergent (default vs --no-auto-parallel differed for Bug 2)
// and confirmed via live bisection on v0.3.0-m5 before the fixes.

// fetchScoutRating returns an arg-dependent decimal128 scouting rating.
// Two calls with distinct args (scoringWeight 0 and 1) must hold distinct values
// — demonstrating Bug-1's fix: each binding owns its own copy of the wide-EC ok-value.
function fetchScoutRating(scoringWeight: int) -> number errors {
  wait sleep(5)
  if (scoringWeight == 0) {
    return 87.50
  }
  return 92.25
}

// checkAvailability returns whether a prospect is available on a given date.
// Used with fetchScoutRating in a parallel group to demonstrate Bug-2's fix:
// the boolean result and the int result both survive a subsequent `wait` with
// their correct values — no frame-slot corruption.
function checkAvailability() -> boolean {
  wait sleep(5)
  return true
}

// fetchDraftSlot returns the int draft slot for a prospect.
// Paired with checkAvailability in an independent parallel group.
function fetchDraftSlot() -> int {
  wait sleep(5)
  return 14
}

// m3f_demo — demonstrates both M3f codegen correctness fixes in a realistic
// scouting-week context: (a) two same-callee wide-EC ratings stay distinct;
// (b) a parallel-group int + bool both survive a wait barrier with correct values.
function m3f_demo() -> nothing {
  print(``)
  print(`v0.3-M3f — codegen correctness fixes:`)

  // (a) BUG-1 FIX: same-callee wide-EC bindings hold distinct values.
  // Two calls to `fetchScoutRating` with DIFFERENT args — each binding must
  // hold its OWN call's value. Before the fix both printed the second rating.
  let ratingA = fetchScoutRating(0)
  let ratingB = fetchScoutRating(1)
  let rA = ratingA.or(0.0)
  let rB = ratingB.or(0.0)
  print(`McCutchen rating: ${rA.toString()}`)
  print(`Clemente rating: ${rB.toString()}`)

  // (b) BUG-2 FIX: parallel-group int + bool both survive a subsequent wait.
  // `fetchDraftSlot` and `checkAvailability` are independent — the compiler
  // overlaps their suspensions into one parallel group. The subsequent
  // `wait sleep(1)` is an ordering barrier; both group results must survive it
  // with their correct values. Before the fix, `slot` read 0 in parallel mode.
  let slot = fetchDraftSlot()
  let available = checkAvailability()
  wait sleep(1)
  if (available) {
    let slotStr = slot.toString()
    print(`draft slot available: ${slotStr}`)
  }
}

// v0.3-M3d: pure-CPU parallelization — independent crunches run on separate cores.
//
// When several independent number-crunching calls sit next to each other with no data
// flowing between them, the compiler runs them all at the same time on separate cores.
// No special syntax — the same step-by-step code runs faster. `--no-auto-parallel` turns
// the overlap off; the output is byte-identical either way.
//
// crunchStat loops over a season's worth of games to roll up one counting stat for a
// player. It does enough work to be worth running alongside the others.

function crunchStat(perGame: int) -> int {
  let total = 0
  let game = 0
  while (game < 162) {
    total = total + perGame
    game = game + 1
  }
  return total
}

// m3d_demo — three independent stat crunches over the roster run at the same time as one
// group. Each call is independent (no result feeds another), so the compiler runs all three
// on separate cores; the season totals are added after all three finish.
function m3d_demo() -> nothing {
  print(``)
  print(`v0.3-M3d — pure-CPU: three independent season crunches run at the same time:`)

  // These three calls have no data dependency on each other, so the compiler runs all three
  // at the same time on separate cores. There is intentionally NO statement between them —
  // adjacency is what lets the compiler group them.
  let hits = crunchStat(2)
  let walks = crunchStat(1)
  let steals = crunchStat(1)
  // The prints READ the results, so they stay after all three crunches finish and in this
  // exact order. The overlap is in the computation, not the print order, so the output is
  // deterministic and byte-identical with --no-auto-parallel.
  print(`season hits: ${hits.toString()}`)
  print(`season walks: ${walks.toString()}`)
  print(`season steals: ${steals.toString()}`)
}

// v0.3-M3g: mixed CPU+I/O overlap — the compiler fuses independent CPU work and I/O work into
// ONE shared continuation, the same way M3b fused I/O+I/O and M3d fused CPU+CPU. A heavy season
// crunch (real, loop-driven CPU work) runs on a separate blocking-pool thread WHILE a scouting
// report fetch (a suspending I/O wait) is in flight — genuinely at the same time, not one after
// another. No special syntax: adjacency + independence is enough, exactly like M3b and M3d.
//
// crunchSeasonTotal rolls up a season's worth of per-game production for a player — real,
// measurable CPU work. fetchLatestScoutingReport simulates a slow scouting-database round-trip.

function crunchSeasonTotal(perGame: int) -> int {
  let total = 0
  let game = 0
  while (game < 162) {
    total = total + perGame
    game = game + 1
  }
  return total
}

function fetchLatestScoutingReport() -> string {
  // IDE shows: wait (fetchLatestScoutingReport may suspend on I/O)
  wait sleep(60)
  return `grade: A-`
}

// m3g_demo — one crunch, one fetch, no statement between them. That adjacency plus the lack
// of any data dependency between the two calls is what lets the compiler fuse them into a
// single shared continuation: the crunch runs on a separate thread while the report fetch
// suspends, at the same time. `--no-auto-parallel` turns the fusion off; the output is
// byte-identical either way (only the overlap — not the printed result — differs).
function m3g_demo() -> nothing {
  print(``)
  print(`v0.3-M3g — mixed CPU+I/O: a season crunch overlaps a scouting report fetch:`)

  // crunchSeasonTotal is pure CPU work; fetchLatestScoutingReport suspends on I/O. No statement
  // sits between them — that adjacency is what lets the compiler fuse the two work-classes.
  let seasonHits = crunchSeasonTotal(3)
  let report = fetchLatestScoutingReport()
  // Both prints READ the results, so they stay after both the crunch and the fetch finish, in
  // this exact order. The overlap is in the suspension/compute, not the print order — so the
  // output is deterministic and byte-identical with --no-auto-parallel.
  print(`season hits (crunched): ${seasonHits.toString()}`)
  print(`latest report: ${report}`)
}

