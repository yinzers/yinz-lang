// calculator — a binary ship that uses helpers from /shared.
//
// Imports are root-relative from the project root (where yinz.toml lives).
// No package-name / workspace-member indirection needed.

import { sum, max } from `shared/math`

function entrypoint() -> nothing {
  let nums: fixed<int, 4> = [3, 1, 4, 1]
  let total = sum(nums)
  let biggest = max(nums)
  print(`total = ${total}, biggest = ${biggest}`)
}
