// examples/errors/m8_errors.ynz
//
// Intentional compile-error gallery for M8: modules, doc comments, sensitive,
// concurrency keywords, bignum, and the number[N] → number<N> migration.
// Each trigger is wrapped in its own function so errors stay isolated.
//
// USAGE: Run with `ynz run examples/errors/m8_errors.ynz --max-errors 100`
// to see every M8 diagnostic class at once (Yinz multi-errors up to 50/compile).
// Uncomment the trigger body inside each function to activate the diagnostic.

// ────── P2: module errors ──────

// WHY: relative import paths must be rejected at parse time with a teaching
// diagnostic. Guards the project-root-path convention for imports.
function p2_relative_import() -> nothing {
    // Uncomment to trigger "Import paths must be project-root relative, not relative paths":
    // import { foo } from `./services/foo`
}

// WHY: wildcard imports are not allowed — must name what you bring into scope.
function p2_wildcard_import() -> nothing {
    // Uncomment to trigger "Wildcard imports are not allowed in Yinz":
    // import * from `services/players`
}

// WHY: `export default` is rejected — Yinz uses named exports only.
function p2_default_export() -> nothing {
    // Uncomment to trigger "Yinz does not have default exports":
    // export default function helper() -> nothing {}
}

// ────── P1: banned concurrency + visibility keywords ──────

// WHY: `async` is not a Yinz keyword — the lexer must redirect it with a
// teaching diagnostic pointing at `wait`. Guards the banned-keyword gate.
function p1_async_banned() -> nothing {
    // Uncomment to trigger "`async` is not a keyword in Yinz":
    // async function helper() -> nothing {}
}

// WHY: `pub` is a banned visibility keyword — must redirect to `export`.
function p1_pub_banned() -> nothing {
    // Uncomment to trigger "`pub` is not a keyword in Yinz":
    // pub function helper() -> nothing {}
}

// ────── P5: concurrency keyword errors ──────

// WHY: `background foo()` where `foo` has a `share` parameter is a compile
// error (shared borrows may dangle when the background task outlives the caller).
// The type system must reject this even in M8's sequential lowering.
function p5_background_share_rejected() -> nothing {
    // Uncomment the function + call below to trigger:
    // function readData(share data: string) -> nothing { print(data) }
    // function handler(data: string) -> nothing { background readData(data) }
}

// WHY: `let h = background foo()` (handle form) is rejected in M8.
// Background handles (.send/.receive) ship in v0.3.
function p5_background_handle_rejected() -> nothing {
    // Uncomment to trigger "Storing the result of `background` is not yet supported":
    // function op() -> int { return 42 }
    // function test() -> nothing { let h = background op() }
}

// ────── P6: bignum errors ──────

// WHY: number<5000> exceeds the 4096-digit cap. Parser must reject with error.
function p6_number_over_cap() -> nothing {
    // Uncomment to trigger (parser rejects above 4096):
    // let x: number<5000> = 0.0
}

// ────── P4: sensitive type errors ──────

// WHY: The .reveal() method in a print context should (in future) emit a Tier 3
// lint; for M8 it compiles cleanly. But printing a sensitive value directly
// MUST produce [REDACTED]. This tests that the type system accepts sensitive
// and that the runtime redaction fires.
// Note: These are commented-out triggers for RUNTIME behavior, not compile errors.

// ────── P0: number syntax migration ──────

// WHY: `number[N]` is the pre-M5 syntax. Parser must reject it with a
// migration diagnostic pointing at `number<N>`. Guards the syntax migration gate.
function p0_number_bracket_migration() -> nothing {
    // Uncomment to trigger "Use angle brackets for number<N>, not square brackets":
    // let x: number[100] = 1.0
}

// WHY: `number<5000>` exceeds the 4096-digit cap. Compiler must reject it.
// This guards the precision upper-bound invariant.
function p0_number_over_cap() -> nothing {
    // Uncomment to trigger "number<5000> is not available yet":
    // let x: number<5000> = 0.0
}
