// v0.2-M1 Error Gallery
//
// Intentional triggers for every registry-driven error path introduced or
// migrated in v0.2-M1. Each trigger has a WHY: comment naming the diagnostic class.
//
// Run: ynz run examples/errors/v0_2_m1_errors.ynz  (expects compile errors)
// Used for hands-on validation of diagnostic quality after each registry migration.

// ---------------------------------------------------------------------------
// Deferred language features — sized numeric types (Phase 5a)
// WHY: [[deferred_language_feature]] — sized types reserved, ship in v2+
// ---------------------------------------------------------------------------

function deferredSizedInts() -> nothing {
    let x: i8 = 5      // WHY: i8 — deferred, substitute = use `int`
    let y: i16 = 5     // WHY: i16 — deferred
    let z: i32 = 5     // WHY: i32 — deferred
    let w: i64 = 5     // WHY: i64 — deferred
    let a: u8 = 5      // WHY: u8 — deferred
    let b: u16 = 5     // WHY: u16 — deferred
    let c: u32 = 5     // WHY: u32 — deferred
    let d: u64 = 5     // WHY: u64 — deferred
    let e: f32 = 5.0   // WHY: f32 — deferred, substitute = use `float`
    let f: f64 = 5.0   // WHY: f64 — deferred
}

// ---------------------------------------------------------------------------
// Deferred language features — `test` keyword (Phase 5a)
// WHY: [[deferred_language_feature]] — reserved for v0.13 testing framework
// ---------------------------------------------------------------------------

function deferredTestKeyword() -> nothing {
    let test = "reserved"   // WHY: `test` identifier — reserved for v0.13
}

// ---------------------------------------------------------------------------
// Banned jargon in hypothetical diagnostic — checked at CI time by jargon_audit
// (no runtime trigger; jargon_audit.rs scans source at CI time)
// ---------------------------------------------------------------------------

// ---------------------------------------------------------------------------
// Type-attached constant wrong-type access
// WHY: type_attached_const_type — registry lookup fails, produces undefined error
// ---------------------------------------------------------------------------

function wrongTypeConstant() -> nothing {
    let x = string.max  // WHY: string has no .max constant
}

// ---------------------------------------------------------------------------
// Banned declaration keywords — OOP keywords redirected (Phase 4)
// WHY: [[banned_declaration_keyword]] entries — OOP drift detection
// ---------------------------------------------------------------------------

// class Player { }         // WHY: class → use shape
// struct Config { }        // WHY: struct → use shape
// enum Status { }          // WHY: enum → use options
// interface Foo { }        // WHY: interface → use shape + follows
// type Alias = int         // WHY: type → use shape (but only as declaration keyword)
// abstract shape Foo { }   // WHY: abstract → use base shape
