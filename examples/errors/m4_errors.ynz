// examples/errors/m4_errors.ynz
//
// Every M4 lexer-level compile error in one file (P1 scope only).
// P2+ error classes are added by their respective phases.
// Run: ./target/debug/ynz build examples/errors/m4_errors.ynz
//
// Yinz multi-errors up to 50 per compile — all diagnostics below fire in one run.

// ────── M4 P1: Banned declaration keywords ──────

// WHY: `type` is banned at the lexer level. M4 P1 redirects to `shape`.
// Users from TypeScript hit this first — the diagnostic teaches `shape` as
// the single unambiguous keyword for all data type declarations.
type Player {
  name: string
}

// WHY: `struct` is banned. Users from Rust/C reach for this.
// Redirected to `shape` with a note that Yinz uses one keyword for all shapes.
struct Enemy {
  health: int
}

// WHY: `class` is banned. Users from Java/Swift reach for this.
// Diagnostic explicitly mentions the non-OOP model: data in `shape`,
// behavior in standalone functions.
class Weapon {
  damage: int
}

// WHY: `interface` is banned. Users from TypeScript/Java reach for this.
// Redirected to `shape` + `follows` — the Yinz contract pattern.
interface Damageable {
  takeDamage(lend self, amount: int) -> nothing
}

// WHY: `enum` is banned. Users from any typed language reach for this.
// Redirected to `options` — the Yinz human-readable term for named value sets.
enum Status {
  active
  inactive
}

// WHY: `abstract` is banned. Users from Java/C# reach for this.
// Redirected to `base shape` — the Yinz form for a non-instantiable shape.
abstract class Entity {
  name: string
}

// ────── M4 P2: Parser errors ──────

// WHY: Prefix-form struct literal `Player { ... }` is banned — annotation-only
//      form is required. Parser redirects to `let p: Player = { ... }` form.
function prefixStructLit() -> nothing {
  let p = Player { name: `Patrick` }
}

// WHY: Method body inside a shape is banned — Yinz is not OOP.
//      Parser emits teaching diagnostic telling user to move the function outside.
shape BadShape {
  function greet() -> string {
    return `hi`
  }
}

// ────── M4 P3a: Typeck errors ──────

// WHY: Struct literal missing a required field.
//      P3a check_struct_lit validates all visible fields are present.
shape Player { name: string health: int }
function missingField() -> nothing {
  let p: Player = { name: `Patrick` }
}

// WHY: Field type mismatch — health expects int, got string.
function wrongFieldType() -> nothing {
  let p: Player = { name: `Patrick`, health: `one hundred` }
}

// WHY: `base shape` cannot be instantiated directly.
base shape Entity { name: string }
function instantiateBase() -> nothing {
  let e: Entity = { name: `ghost` }
}

// WHY: `const` binding — field mutation rejected.
//      Demonstrates const deep-immutability (one of the five const paths from plan invariants).
function constFieldMutation() -> nothing {
  const p: Player = { name: `Patrick`, health: 100 }
  p.health = 50
}

// ────── Hidden-field errors ──────

// WHY: hidden fields must have a default value — without one, external
// construction would leave the field uninitialized. This triggers the
// "hidden field has no default" diagnostic from collect_shapes.
shape NoDefault {
    hidden bar: int
}

// WHY: external construction cannot set a hidden field. The multi-file case
// (importing a shape from another file and setting its hidden field at
// construction) requires two files and is covered by the typeck test
// `external_file_construction_cannot_set_hidden_field` in
// crates/ynz-typeck/tests/check.rs rather than here.

// ────── (P3b+ error classes added here as phases land) ──────
// After M4 P3b: cyclic extends, dynamic type mismatch, follows contract violation
// After M4 P3c: use-after-give, const-lend, double-lend, mutable-while-shared
