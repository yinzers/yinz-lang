// v0.3-M9 C1f (#423) round 2: an explicit `.copy()` is always deep, like `Clone` on a Rust struct
// holding a `Box`: the receiver is read, not consumed, so the copy owns four cells of its own, and
// the binding then moves the copy without cloning it again. Correct behavior: prints 200. The
// counter test pins 400 cells more than the moved-binding fixture.
shape End {
  flag: Boolean
}
shape Node {
  value: Int
  next: Node | End
}
shape Holder {
  chain: Node | End
  id: Int
}
shape Outer {
  inner: Holder
  tag: Int
}

function buildChain() -> Node {
  let stop: End = { flag: true }
  let last: Node = { value: 3, next: stop }
  let middle: Node = { value: 2, next: last }
  let top: Node = { value: 1, next: middle }
  return top
}

function makeHolder() -> Holder {
  let top = buildChain()
  let holder: Holder = { chain: top, id: 1 }
  return holder
}

function entrypoint() -> Nothing {
  let total = 0
  let round = 0
  while (round < 100) {
    let holder = makeHolder()
    let copied = holder.copy()
    total = total + copied.id + holder.id
    round = round + 1
  }
  print(total)
}
