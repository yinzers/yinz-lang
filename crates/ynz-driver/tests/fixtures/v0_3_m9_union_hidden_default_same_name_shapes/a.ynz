// v0.3-M9 C1e rework (#421): module `a` declares a shape `Thing` with hidden defaults. Module
// `b` declares a DIFFERENT shape that is also called `Thing`. Both modules build and run.
export shape Thing {
  id: Int
  hidden count: Int = seed()
  hidden label: String = `a`
}

function seed() -> Int {
  return 11
}

export function readThing(share self: Thing) -> String {
  return `${self.count.toString()}${self.label}`
}

export function runA() -> String {
  let thing: Thing = { id: 1 }
  return thing.readThing()
}
