// v0.3-M3g E7 ratchet: a wide-value-EC (`number errors`) call next to an I/O call. `priceA`
// returns `number errors` — excluded from `cpu_supported_callees` (the shared CPU-ABI-fits
// predicate both the pure-CPU and fused admission gates read): the 24-byte {error word + i128
// value} pair overflows the 16-byte CPU result slot, so admitting it as a fused-group CPU member
// would make the join-bind dereference a pointer into the dead worker-thread frame — a
// use-after-free. `priceA` is also not a suspending call, so the fused-group admission gate's
// classifier finds it INELIGIBLE for either class — no adjacent eligible pair ever forms, so no
// fused group is even considered here. Both calls run in plain sequence.
//
// priceA(n) loops, so it "looks CPU-heavy," but its wide-EC return keeps it off the fused path
// entirely (the decline-around must survive fusion). fetch(n) waits on a timer.
//
// Arithmetic: priceA(4) = 4 * 1.5 = 6.0.
//
// Expected output (both modes — default and --no-auto-parallel):
//   6.0
//   waited

function priceA(n: int) -> number errors {
  let total: number = 0.0
  let i: int = 0
  while (i < n) {
    total = total + 1.5
    i = i + 1
  }
  return total
}

function fetch(n: int) -> string {
  wait sleep(0)
  return `waited`
}

function entrypoint() -> nothing {
  let a = priceA(4)
  let b = fetch(4)
  print(a.or(0.0))
  print(b)
}
