// v0.3-M9 C1f (#423) round 2: a `let` of a place read is a view only while nothing writes the place.
// Here `holder.chain` is replaced while `view` is still read, so the binding must keep the value it
// had: it owns a deep copy of the three-link chain.
// Correct behavior: prints `3` (the copy) and `1` (the new chain); clean under AddressSanitizer at
// -O0 and -O2. A view would read the replaced slot and print `1` for the first line.

shape End {
  flag: boolean
}
shape Node {
  value: int
  next: Node | End
}
shape Holder {
  chain: Node | End
  id: int
}

function length(share chain: Node | End) -> int {
  if (chain) {
    is Node => {
      return 1 + length(chain.next)
    }
    is End => {
      return 0
    }
  }
  return 0
}

function buildChain() -> Node {
  let stop: End = { flag: true }
  let last: Node = { value: 3, next: stop }
  let middle: Node = { value: 2, next: last }
  let top: Node = { value: 1, next: middle }
  return top
}

function shortChain() -> Node {
  let stop: End = { flag: true }
  let only: Node = { value: 9, next: stop }
  return only
}

function entrypoint() -> nothing {
  let top = buildChain()
  let holder: Holder = { chain: top, id: 1 }
  let view = holder.chain
  let shorter: Node | End = shortChain()
  holder.chain = shorter
  print(length(view))
  print(length(holder.chain))
}
