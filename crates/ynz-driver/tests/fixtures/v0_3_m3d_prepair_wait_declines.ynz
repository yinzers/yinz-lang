// v0.3-M3d: `entrypoint` waits on a timer first, then makes two independent computations.
// Because the function waits, it is already a step-by-step waiter, and the two computations
// that follow run one after the other in plain sequence — they do NOT run at the same time.
// Both modes (default and --no-auto-parallel) print the same line.
//
// score(seed) loops, so each call does enough work to be worth running alongside the other,
// and returns the loop sum plus its seed.
//
// Arithmetic: loopSum = 0+1+...+99 = 4950.
//   score(3) = 4953
//   score(4) = 4954
//   sum      = 4953 + 4954 = 9907
//
// Expected output (both modes — default and --no-auto-parallel):
//   9907
function score(seed: int) -> int {
  let total = 0
  let i = 0
  while (i < 100) {
    total = total + i
    i = i + 1
  }
  return total + seed
}

function entrypoint() -> nothing {
  wait sleep(0)
  let a = score(3)
  let b = score(4)
  print(a + b)
}
