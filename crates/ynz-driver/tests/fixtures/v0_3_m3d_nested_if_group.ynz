// inside the `if` branch, `combine` makes two independent `score(...)` calls.
// They run at the same time, and `combine` adds their results once both finish. `entrypoint`
// calls `combine` once. Both print the same line whether or not the two calls run at the same
// time.
//
// score(seed) loops, so it does enough work to be worth running alongside the other call, and
// returns the loop sum plus its seed, giving each call a distinct result.
//
// Arithmetic: loopSum = 0+1+...+99 = 4950.
//   score(3) = 4950 + 3 = 4953
//   score(4) = 4950 + 4 = 4954
//   combine  = 4953 + 4954 = 9907
//
// Expected output (both modes — default and --no-auto-parallel):
//   9907
function score(seed: int) -> int {
  let total = 0
  let i = 0
  while (i < 100) {
    total = total + i
    i = i + 1
  }
  return total + seed
}

function combine() -> int {
  let result = 0
  let go = true
  if (go) {
    let lo = score(3)
    let hi = score(4)
    result = lo + hi
  }
  return result
}

function entrypoint() -> nothing {
  let r = combine()
  print(r)
}
