// Fixture (Bug-2 matrix — int+int, nested-only use): two independent suspending int
// bindings are auto-grouped; both results cross a subsequent `wait`; both are read
// ONLY inside a nested `if` body (not at the top level of the function).
//
// This case was CORRECT before the Bug-2 fix and must stay correct afterward
// (regression guard — nested reads of int+int grouped results must not regress).
//
// Expected output (correct — cond is always true, so both print):
//   42
//   99
function slowCall() -> int {
  wait sleep(40)
  return 42
}

function otherInt() -> int {
  wait sleep(40)
  return 99
}

function flag() -> boolean {
  wait sleep(1)
  return true
}

function entrypoint() -> nothing {
  let a = slowCall()
  let b = otherInt()
  let cond = flag()
  wait sleep(1)
  if (cond) {
    print(a.toString())
    print(b.toString())
  }
}
