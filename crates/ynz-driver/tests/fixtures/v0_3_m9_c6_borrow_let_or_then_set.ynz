// v0.3-M9 C6: let of an element .or() aliases it; the index assign frees it
// The reader keeps the value it read after the place is overwritten: no freed memory is read.

function entrypoint() -> Nothing {
  let rows: Array<Array<Int>> = [[10, 20, 30]]
  let fallback: Array<Int> = []
  let heldRow = rows[0].or(fallback)
  rows[0] = [9]
  print(heldRow.count())
  print(heldRow[0].or(-1))
}
