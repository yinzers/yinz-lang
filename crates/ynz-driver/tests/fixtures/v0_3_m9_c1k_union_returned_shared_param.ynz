// v0.3-M9 C1k: a function returns a shared `map<string, string> | nothing` parameter as it is,
// and the caller releases what a call hands back (the union is the map's raw pointer). The
// `return` copies the map, as it copies a plain `map` parameter, so the caller's release frees the
// copy and `table` still owns its own.
// Before: the result was an alias of `table`, and both frees ran (a segmentation fault).
// Expected output: `ok`, `end`.

function fallback(share first: Map<String, String> | Nothing, share second: Map<String, String> | Nothing) -> Map<String, String> | Nothing {
  return second
}

function describeTable(share table: Map<String, String> | Nothing) -> String {
  return `ok`
}

function entrypoint() -> Nothing {
  let table: Map<String, String> = { `a`: `b` }
  let other: Map<String, String> = table.copy()
  print(describeTable(fallback(other, table)))
  print(`end`)
}
