// v0.3-M9 C1h: a shape with fixed fields lent to a function that waits: the list survives the suspension and a write before it is read after.
// Expected output: 50, 50, B

shape Bag {
  tag: int
  names: fixed<string, 2>
  nums: fixed<int, 3>
}

function pause(lend bag: Bag) -> int {
  wait sleep(1)
  bag.nums.set(0, 50)
  return bag.nums[0].or(-1)
}

function entrypoint() -> nothing {
  let bag: Bag = { tag: 1, names: [`a`.toUpperCase(), `b`.toUpperCase()], nums: [1, 2, 3] }
  let r = wait pause(bag)
  print(r)
  wait sleep(1)
  print(bag.nums[0].or(-1))
  print(bag.names[1].or(`?`))
}
