// v0.3-M3d: `combine` makes two independent `score(...)` calls inside an `if` branch and then
// waits on a timer before returning. The wait is a second suspension point in the same function
// as the nested call pair. When a function has a suspension point OTHER than the nested pair, the
// two nested calls run in plain sequence — they do NOT run at the same time. `entrypoint` calls
// `combine` once; both modes (default and --no-auto-parallel) print the same line.
//
// score(seed) loops, so each call does enough work to be worth running alongside another, and
// returns the loop sum plus its seed for a distinct result.
//
// Arithmetic: loopSum = 0+1+...+99 = 4950.
//   score(3) = 4950 + 3 = 4953
//   score(4) = 4950 + 4 = 4954
//   combine  = 4953 + 4954 = 9907
//
// Expected output (both modes — default and --no-auto-parallel):
//   9907
function score(seed: int) -> int {
  let total = 0
  let i = 0
  while (i < 100) {
    total = total + i
    i = i + 1
  }
  return total + seed
}

function combine() -> int {
  let result = 0
  let go = true
  if (go) {
    let lo = score(3)
    let hi = score(4)
    result = lo + hi
  }
  wait sleep(0)
  return result
}

function entrypoint() -> nothing {
  let r = combine()
  print(r)
}
