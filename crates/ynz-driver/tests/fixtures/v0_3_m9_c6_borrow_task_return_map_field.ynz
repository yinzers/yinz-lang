// v0.3-M9 C6: a task returns its argument's map field; the glue frees it
// The reader keeps the value it read after the place is overwritten: no freed memory is read.

shape Bucket {
  table: Map<String, String>
  id: Int
}
function pick(bucket: Bucket) -> Map<String, String> {
  wait sleep(1)
  return bucket.table
}
function entrypoint() -> Nothing {
  let bucket: Bucket = { table: { `k`: `v-${1}` }, id: 1 }
  let handle = background pick(bucket)
  wait sleep(50)
  let got = handle.receive()
  let fallback: Map<String, String> = {}
  let heldTable = got.or(fallback)
  let maybeValue = heldTable.get(`k`)
  print(maybeValue.or(`none`))
}
