// Shadow matrix: non-crossing `for` variable named like a crossing LOCAL (the loop body has no
// wait; the local is read after a later wait). Expected: amy, bob, outer.
function entrypoint() -> nothing {
  let n = `outer`
  let names: array<string> = [`amy`, `bob`]
  for (n in names) {
    print(n)
  }
  wait sleep(5)
  print(n)
}
