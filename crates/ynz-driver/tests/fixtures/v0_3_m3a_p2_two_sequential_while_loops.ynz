// Fixture: two sequential suspending while loops with distinct counters.
// has_top_level_let_before_suspension must recognise a suspending while as a
// suspension point, so `let k` after the first loop is correctly classified as
// a new binding AFTER a suspension — not as a spurious "redeclaration of k before
// suspension" error. Both loops must complete; the final `k` value is printed.
// Expected output: 3
function entrypoint() -> nothing {
  let i: int = 0
  while (i < 2) {
    wait sleep(5)
    i = i + 1
  }
  let k: int = 0
  while (k < 3) {
    wait sleep(5)
    k = k + 1
  }
  print(k.toString())
}
