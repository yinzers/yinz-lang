// v0.3-M3g E8 obligation — blocking-pool exhaustion stress. Tokio's blocking pool
// (`ynz_rt_spawn_blocking_joinable`'s substrate) is FINITE, per IMP-concurrency's "Cancellation
// Detach Constraint" and this crate's `Builder::new_multi_thread()` runtime init (no
// `.max_blocking_threads()` override, so the pool defaults to Tokio's built-in 512-thread cap).
// Literally exhausting 512 real OS threads in a fast CI fixture is impractical (and would not
// exercise anything qualitatively different from a smaller fan-out) — this fixture instead drives
// MANY concurrent mixed CPU+I/O groups via a RECURSION-SPAWNING, FAN-OUT shape: four independent
// chains, each with one root worker hosting its OWN top-level fused CPU+I/O group and, once that
// group resolves, `background`-spawning ALL FOUR of its remaining chain-mates AT ONCE (not one
// sequential successor). That is 20 fused groups total (20 CPU spawns onto the blocking pool + 20
// concurrent I/O sleeps): 4 fired directly from `entrypoint` (the four chain roots, genuinely
// concurrent with each other) and, once each root resolves, up to 16 more fired recursively and
// near-simultaneously from already-spawned background tasks (the four roots do comparable work —
// same `crunch` loop bound, same-order `fetchIO` sleep — so their fan-outs cluster in time rather
// than trickling one at a time). Genuine concurrent-pressure ceiling: 4 initial roots, then up to
// 16 leaves overlapping shortly after (root and leaf phases don't overlap each other — a root's
// own fused group has already resolved by the time it fans out) — NOT 20-way concurrency at any
// single instant, but a substantial, honestly-measured improvement over a strictly sequential
// chain (whose ceiling would be only 4). 20 is the CUMULATIVE total across the whole run. Must
// complete without deadlock (watchdog-wrapped by the shared test helpers) and print every
// worker's completion marker exactly once.
//
// crunch(n) does small real (loop) work; fetchIO(n) suspends briefly. Every worker's fused group
// output is deterministic (seed-dependent); only the INTERLEAVING across workers/chains is
// concurrent, so the test asserts the *set* of completion lines, not their order.
//
// Arithmetic per worker (seed s): crunch(s) = 0+1+...+499 + s = 124750 + s; fetchIO(s) = s + 1.
//   worker sum = 124750 + s + s + 1 = 124751 + 2s.

function crunch(n: int) -> int {
  let total = 0
  let i = 0
  while (i < 500) {
    total = total + i
    i = i + 1
  }
  return total + n
}

function fetchIO(n: int) -> int {
  wait sleep(15)
  return n + 1
}

function workerA1() -> nothing {
  let a = crunch(1)
  let b = fetchIO(1)
  print(`DONE_A1 ${a + b}`)
  background workerA2()
  background workerA3()
  background workerA4()
  background workerA5()
}
function workerA2() -> nothing {
  let a = crunch(2)
  let b = fetchIO(2)
  print(`DONE_A2 ${a + b}`)
}
function workerA3() -> nothing {
  let a = crunch(3)
