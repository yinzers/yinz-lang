// v0.3-M9 C7 slice 3b: `held` owns one counted reference to the channel an imported function hands
// back, though its argument's owner (`local`) dies first; the channel is freed once, after both.
import { firstChan } from `helpers`

function underTest(condition: Boolean) -> Nothing {
  let held: Maybe<Channel<Int>> = none
  if (condition) {
    let local: Array<Channel<Int>> = [Channel<Int>()]
    held = firstChan(local)
  }
  print(1)
}

function entrypoint() -> Nothing {
  underTest(true)
  underTest(false)
}
