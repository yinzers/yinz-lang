// v0.3-M9 C1f (#423): a union binding that crosses a `wait` lives in its function's frame, not in
// a heap cell. Covers a `let thing: Thing` read as a `wait`ed call's argument after an earlier
// `wait`, and an `errors` result (`Thing errors`) held across a `wait` and read after it.
// Correct behavior: each value reads back as the variant that was stored, clean under
// AddressSanitizer at both optimization levels. Before: the union binding was two counted heap
// cells, the `errors` binding a view pointer into the resume function's dead stack.

shape Tiny {
  flag: Boolean
}
shape Big {
  label: String
  count: Int
}
shape Thing = Tiny | Big

function describe(share thing: Thing) -> String {
  if (thing) {
    is Tiny => {
      return `tiny`
    }
    is Big => {
      return `big ${thing.label} ${thing.count}`
    }
  }
  return `none`
}

function slowDescribe(share thing: Thing) -> String {
  wait sleep(1)
  return describe(thing)
}

function slowBig(count: Int) -> Thing errors {
  wait sleep(1)
  let big: Big = { label: `slow`, count: count }
  return big
}

function clobber(depth: Int) -> Int {
  let filler: Big = { label: `filler`, count: depth }
  return filler.count
}

function entrypoint() -> Nothing {
  let big: Big = { label: `crossing`, count: 3 }
  let thing: Thing = big
  wait sleep(1)
  let scratch = clobber(5)
  let first = wait slowDescribe(thing)
  print(first)
  let held = slowBig(8)
  wait sleep(1)
  let scratchAgain = clobber(6)
  let fallback: Tiny = { flag: false }
  let fallbackThing: Thing = fallback
  print(describe(held.or(fallbackThing)))
  print(`end`)
}
