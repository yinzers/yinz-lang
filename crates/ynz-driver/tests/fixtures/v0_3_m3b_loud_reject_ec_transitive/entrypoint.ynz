// M3e Phase 2: caller of an errors-capable cross-module suspending fn that
// suspends transitively. compute() returns int errors. Use .or() to unwrap.
// Expected output: "got: 42"
import { compute } from `ec_ops`

function entrypoint() -> nothing {
  let result = compute()
  let v = result.or(0)
  print(`got: ${v}`)
}
