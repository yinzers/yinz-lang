// v0.3-M9 C1g rework: `big.useBig()` is sugar for `useBig(big)`, but `useBig` takes a second
// argument.
// Correct behavior: does not compile — refused with the plain call form's arity text.
// Pre-fix failure: LLVM "Incorrect number of arguments" reported as a compiler bug; the call
// read an argument that was never passed (`check_method_call` zipped the arguments with the
// parameters and silently dropped the difference).

shape Big {
  label: string
  count: int
}

function useBig(share first: Big, share second: Big) -> int {
  return second.count
}

function entrypoint() -> nothing {
  let big: Big = { label: `hello`, count: 3 }
  print(big.useBig().toString())
}
