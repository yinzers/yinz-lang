// v0.3-M9 C1f (#423) round 2: a shape pushed into an array as an explicit copy is deep once: the
// element owns the copy's four cells and the source keeps its own. Correct behavior: prints 200.
// The counter test pins 400 cells more than the moved-array fixture.
shape End {
  flag: boolean
}
shape Node {
  value: int
  next: Node | End
}
shape Holder {
  chain: Node | End
  id: int
}
shape Outer {
  inner: Holder
  tag: int
}

function buildChain() -> Node {
  let stop: End = { flag: true }
  let last: Node = { value: 3, next: stop }
  let middle: Node = { value: 2, next: last }
  let top: Node = { value: 1, next: middle }
  return top
}

function makeHolder() -> Holder {
  let top = buildChain()
  let holder: Holder = { chain: top, id: 1 }
  return holder
}

function entrypoint() -> nothing {
  let total = 0
  let round = 0
  while (round < 100) {
    let holders: array<Holder> = []
    let holder = makeHolder()
    holders.add(holder.copy())
    total = total + holders.count() + holder.id
    round = round + 1
  }
  print(total)
}
