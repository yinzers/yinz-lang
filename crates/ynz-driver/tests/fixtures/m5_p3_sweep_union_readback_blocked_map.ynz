// WHY: v0.3-M5 P3 step-5 item (d) — LOUD-FAIL PIN for the union persist hole
// in value_to_stable_bits, MAP-VALUE side (see the array sibling
// m5_p3_sweep_union_readback_blocked_array.ynz for the full rationale: union
// repr is non-uniform, write side constructible + silently persists an
// interior-stack pointer, read-back ICEs loud so no binary exists). This pin
// asserts the build/run FAILS (exit != 0, empty stdout) in BOTH modes. Either
// today's ICE or a future clean loud-reject diagnostic satisfies; only a
// SILENT compile-and-run fails the pin, forcing the union-marshalling question
// to be answered consciously. See value_to_stable_bits' KNOWN-HOLE doc.
shape Circle {
  radius: float
}

shape Square {
  side: float
}

shape Figure = Circle | Square

function entrypoint() -> nothing {
  let c: Circle = { radius: 3.0 }
  let fig: Figure = c
  let figs: map<int, Figure> = {}
  figs.set(1, fig)
  let g = figs.get(1)
  if (g.exists()) {
    let f2: Figure = g.value
    if (f2 is Circle) {
      print(`circle`)
    }
  }
}
