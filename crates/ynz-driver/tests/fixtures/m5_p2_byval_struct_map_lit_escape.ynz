// M5 P2 fix round 2 — tripwire (c2): same map-literal escape through the
// IDENTIFIER-KEY literal path (`{ pick: p.copy() }` with a map annotation — the
// StructLit-as-map lowering), the fourth and last map-value marshalling site.
shape Part {
  qty: Int
  price: Int
}

function entrypoint() -> Nothing {
  let seed: Int = 1
  let qa: Int = seed * 1
  let qb: Int = seed * 2
  let qc: Int = seed * 3
  let parts: Array<Part> = [
    { qty: qa, price: qa * 10 },
    { qty: qb, price: qb * 10 },
    { qty: qc, price: qc * 10 }
  ]
  let zero: Part = { qty: 0, price: 0 }
  let picks: Map<String, Part> = { pick: zero }
  for (p in parts) {
    if (p.qty == 1) {
      let inner: Map<String, Part> = { pick: p.copy() }
      picks = inner
    }
  }
  let got = picks[`pick`]
  if (got.exists()) {
    print(got.value.qty)
    print(got.value.price)
  }
}
