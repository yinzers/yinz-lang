// v0.3-M9 C1f (#423): a union passed to a suspending callee rides the callee's own frame
// (`Param` region): the only allocation per call is the callee frame itself, the same as for an
// `int` argument (`v0_3_m9_union_alloc_wait_arg_int.ynz`).
// Correct behavior: prints the sum; the allocation count equals the int baseline's.

shape Tiny {
  flag: Boolean
}
shape Big {
  count: Int
  weight: Int
}
shape Thing = Tiny | Big

function weigh(share thing: Thing) -> Int {
  if (thing) {
    is Tiny => {
      return 1
    }
    is Big => {
      return thing.count + thing.weight
    }
  }
  return 0
}

function make(seed: Int) -> Thing {
  if (seed % 2 == 0) {
    let tiny: Tiny = { flag: true }
    let thing: Thing = tiny
    return thing
  }
  let big: Big = { count: seed, weight: 2 }
  let thing: Thing = big
  return thing
}

function slowWeigh(share thing: Thing) -> Int {
  wait sleep(0)
  return weigh(thing)
}

function entrypoint() -> Nothing {
  let total = 0
  let round = 0
  while (round < 100) {
    let big: Big = { count: round, weight: 2 }
    let thing: Thing = big
    let weight = wait slowWeigh(thing)
    total = total + weight
    round = round + 1
  }
  print(total)
}
