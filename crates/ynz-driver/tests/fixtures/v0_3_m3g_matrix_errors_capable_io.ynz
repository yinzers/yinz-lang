// v0.3-M3g N+M matrix — an `errors`-capable I/O member mixed with a CPU member. `fetchWithErrors`
// returns `-> int errors` (the 2-slot `{i64, i64}` errors ABI struct in its embedded child
// sub-frame's return slot); `emit_fused_group_spawn_poll`'s I/O-member binding must register the
// bound name in `errors_capable_locals` (mirrors `emit_independent_group_poll`'s pre-existing
// errors-capable handling — M3b's `v0_3_m3b_p4_parallel_errors_return.ynz`) so `.or(...)` at the
// print site unwraps correctly instead of dereferencing a mis-typed slot.
//
// crunch(n) loops 0..50 (sum 1225); fetchWithErrors(n) waits on a timer then returns `n + 1`.
//
// Arithmetic: crunch(1) = 1225+1=1226; fetchWithErrors(2) = 2+1=3.
//   sum = 1226 + 3 = 1229.
//
// Expected output (both modes — default and --no-auto-parallel):
//   1229

function crunch(n: int) -> int {
  let total = 0
  let i = 0
  while (i < 50) {
    total = total + i
    i = i + 1
  }
  return total + n
}

function fetchWithErrors(n: int) -> int errors {
  wait sleep(0)
  return n + 1
}

function entrypoint() -> nothing {
  let a = crunch(1)
  let b = fetchWithErrors(2)
  let bv = b.or(0)
  print(a + bv)
}
