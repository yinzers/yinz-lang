// v0.3-M3d danger matrix — two functions returning a boolean, run at the same time inside a
// `match` branch. The two calls produce DIFFERENT booleans (false then true), so if the results
// were mixed up the output would change. Both results are used INSIDE the branch (a result used
// after the branch ends would run the two calls one after the other instead — see the
// `..._read_after_arm_declines` companion). Both print the same lines whether or not the two
// calls run at the same time.
//
// overHalf(n) loops summing, so it is worth running alongside the other call, then returns
// whether the sum exceeds a threshold — a distinct true/false per input.
//
// Arithmetic: sum(0..3) = 3 (not > 10 → false); sum(0..6) = 15 (> 10 → true).
//
// Expected output (both modes — default and --no-auto-parallel):
//   false
//   true

function overHalf(n: int) -> boolean {
  let sum: int = 0
  let i: int = 0
  while (i < n) {
    sum = sum + i
    i = i + 1
  }
  return sum > 10
}

function overHalf2(n: int) -> boolean {
  let sum: int = 0
  let i: int = 0
  while (i < n) {
    sum = sum + i
    i = i + 1
  }
  return sum > 10
}

function combine() -> boolean {
  let pick = 1
  let result = false
  if (pick) {
    1 => {
      let lo = overHalf(3)
      let hi = overHalf2(6)
      print(lo)
      result = hi
    }
    else => {
      result = false
    }
  }
  return result
}

function entrypoint() -> nothing {
  let r = combine()
  print(r)
}
