// v0.3-M9 C10, stays legal: the callee only reads what the loop walks.
shape Holder {
  rows: Array<Array<Int>>
}
function countRows(share holder: Holder) -> Int {
  return holder.rows.count()
}
function entrypoint() -> Nothing {
  let holder: Holder = { rows: [[1], [2], [3]] }
  let total = 0
  for (row in holder.rows) {
    total = total + row[0].or(0) + countRows(holder)
  }
  print(total)
}
