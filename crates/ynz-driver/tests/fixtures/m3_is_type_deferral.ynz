// M6 P5 catch-up: closes the M3 is-type deferral.
// `is TypeName =>` pattern matching now works (M6 P3b shipped it).
// This fixture was previously a deferral diagnostic; now it's a runnable demo.

shape Circle { radius: float }
shape Square { side: float }
shape Figure = Circle | Square

function describe(figure: Figure) -> string {
  if (figure) {
    is Circle => return "circle"
    is Square => return "square"
  }
  return "unknown"
}

function main() -> nothing {
  let c: Circle = { radius: 5.0 }
  let s: Square = { side: 3.0 }
  let fig: Figure = c
  print(describe(fig))
  let fig2: Figure = s
  print(describe(fig2))
}
