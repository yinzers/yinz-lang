// v0.3-M9 C1j: a fire-and-forget `background` call passes an element of a fresh call result
// (`make()[0]`, a `maybe<string>`). The whole array `make()` returns must be released by the
// statement, and the task keeps its own copy of the element.
// Expected output: the element, then `done`.

function show(item: Maybe<String>) -> Nothing {
  print(item.or(`?`))
}

function make() -> Array<String> {
  let names: Array<String> = [`a`.toUpperCase(), `b`.toUpperCase()]
  return names
}

function entrypoint() -> Nothing {
  background show(make()[0])
  wait sleep(50)
  print(`done`)
}
