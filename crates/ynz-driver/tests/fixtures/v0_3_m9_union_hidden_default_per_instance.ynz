// v0.3-M9 C1e rework (#421), review round 1: a hidden union default belongs to each instance.
// Two instances built by the same default must not share one envelope: reassigning one's slot
// leaves the other's default intact, and the default is inherited through `extends`.

shape Big {
  label: String
  count: Int
}

shape Base {
  id: Int
  hidden slot: Big | Int = 4096
}

shape Derived extends Base {
  name: String
  hidden own: Big | Int = 7
}

function describe(share value: Big | Int) -> String {
  if (value) {
    is Big => {
      return `big ${value.label}`
    }
    else => {
      return `int`
    }
  }
  return `none`
}

function showSlot(share self: Derived) -> String {
  let slot: Big | Int = self.slot
  return describe(slot)
}

function showOwn(share self: Derived) -> String {
  let own: Big | Int = self.own
  return describe(own)
}

function replaceSlot(lend self: Derived, give replacement: Big | Int) -> Nothing {
  self.slot = replacement
}


function entrypoint() -> Nothing {
  let first: Derived = { id: 1, name: `first` }
  let second: Derived = { id: 1, name: `second` }
  let big: Big = { label: `replacement`, count: 3 }
  let replacement: Big | Int = big
  first.replaceSlot(replacement)
  print(first.showSlot())
  print(second.showSlot())
  print(first.showOwn())
  print(second.showOwn())
  for (round in range(0, 2)) {
    let fresh: Derived = { id: round, name: `loop` }
    print(fresh.showSlot())
  }
}
