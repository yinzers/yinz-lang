// M5 P4 closing round — SoA decline fixture: REASSIGNED AFTER INITIAL BINDING.
//
// `pts` starts as a 72-element literal (> SOA_SIZE_THRESHOLD = 64) whose only loop
// reads a 2-field union — everything that admitted the QUALIFYING cell — but the
// binding is REASSIGNED to a different array mid-function. The walk's recorded
// initializer signals (provable_len = 72) describe the ORIGINAL array only; by the
// time any consumer reads the name it holds the 4-element replacement, so an
// Admitted verdict would carry a stale provable_len into Phase 5's buffer sizing
// (the E3/E7 silent-miscompile class). Asserted verdicts: `pts` declines
// Escapes { how: "reassigned after initial binding" }; `replacement` declines as
// the aliasing side of the same statement
// (Escapes { how: "stored into another binding (aliases the array)" }).
shape Point {
  x: int
  y: int
}

function entrypoint() -> nothing {
  let pts: array<Point> = [
    { x: 1, y: 2 },
    { x: 2, y: 4 },
    { x: 3, y: 6 },
    { x: 4, y: 8 },
    { x: 5, y: 10 },
    { x: 6, y: 12 },
    { x: 7, y: 14 },
