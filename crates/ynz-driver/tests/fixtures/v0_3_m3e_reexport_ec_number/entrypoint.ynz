// M3e adversarial axis 5a.ii: stacked escapes #1+#3+#4 — re-export × EC × number.
// C (entrypoint) imports calcTotal from B; B imports fetchPrice from A.
// B's composed frame must include A's sub-frame (escape #1), the EC staging slot
// (escape #3), and two number/decimal128 slots (escape #4) — all three stacked.
// Expected output: "total: 3.5"
import { calcTotal } from `b_ops`

function entrypoint() -> nothing {
  const result = calcTotal()
  const v = result.or(0.0)
  print(`total: ${v.toString()}`)
}
