// WHY: ArrayShapeRuntimeFieldWithWait guard — an array<Shape> whose elements have
// runtime-computed field values (variables, not compile-time int/bool literals)
// cannot cross a `wait`. Without the guard this silently prints stack garbage
// (the element pointers dangle after the resume function's stack is freed).
// After the guard: exit 1, clean WHAT/WHAT-INSTEAD/WHY diagnostic.
// See design/concurrency.md 'ArrayShapeRuntimeFieldWithWait'.
shape Item {
  id: int
  qty: int
}

function entrypoint() -> nothing {
  let a: int = 10
  let b: int = 20
  let items: array<Item> = [{ id: 1, qty: a }, { id: 2, qty: b }]
  let total: int = 0
  wait sleep(5)
  for (it in items) {
    total = total + it.qty
  }
  print(total.toString())
}
