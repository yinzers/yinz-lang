// v0.3-M9 C10: the body assigns the ROOT binding of the walked place (`holder` while walking
// `holder.rows`). The assignment frees the walked list; refused.
shape Holder {
  rows: Array<Array<Int>>
}
function entrypoint() -> Nothing {
  let holder: Holder = { rows: [[1], [2], [3]] }
  let total = 0
  for (row in holder.rows) {
    let fresh: Holder = { rows: [[9]] }
    holder = fresh
    total = total + row[0].or(0)
  }
  print(total)
}
