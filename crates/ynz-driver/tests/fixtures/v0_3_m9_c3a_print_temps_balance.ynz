// v0.3-M9 C3a fixture: `print` and `${}` of an `int`, `float` or `number` allocate no string for
// the number's text. 1,000 iterations print each kind once, and interpolate each kind once. Each
// interpolation result is a string the program still holds (freed by the C7 release pass), so
// exactly one string per iteration is allocated and may stay allocated.
//
// Expected last line: 1000

function entrypoint() -> nothing {
  let i: int = 0
  let ratio: float = (3).toFloat()
  let price: number = 9.5
  while (i < 1000) {
    print(i)
    print(ratio)
    print(price)
    let line: string = `n=${i} f=${ratio} d=${price}`
    i = i + 1
  }
  print(i)
}
