// v0.3-M9 C10: the body assigns an ELEMENT of a list the loop walks through (`cube[0]` while
// walking `cube[0]`). The assignment frees the walked list; refused.
function entrypoint() -> Nothing {
  let cube: Array<Array<Array<Int>>> = [[[1], [2], [3]], [[4]]]
  let empty: Array<Array<Int>> = []
  let total = 0
  for (row in cube[0].or(empty)) {
    cube[0] = [[9]]
    total = total + row[0].or(0)
  }
  print(total)
}
