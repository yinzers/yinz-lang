// v0.3-M9 C1f (#423) round 2: a shape stored in a shape field as an explicit copy is deep once:
// the copy's four cells, then the field cell takes it by move. Correct behavior: prints 300.
// The counter test pins 400 cells more than the moved-field fixture.
shape End {
  flag: boolean
}
shape Node {
  value: int
  next: Node | End
}
shape Holder {
  chain: Node | End
  id: int
}
shape Outer {
  inner: Holder
  tag: int
}

function buildChain() -> Node {
  let stop: End = { flag: true }
  let last: Node = { value: 3, next: stop }
  let middle: Node = { value: 2, next: last }
  let top: Node = { value: 1, next: middle }
  return top
}

function makeHolder() -> Holder {
  let top = buildChain()
  let holder: Holder = { chain: top, id: 1 }
  return holder
}

function entrypoint() -> nothing {
  let total = 0
  let round = 0
  while (round < 100) {
    let holder = makeHolder()
    let outer: Outer = { inner: holder.copy(), tag: 2 }
    total = total + outer.tag + holder.id
    round = round + 1
  }
  print(total)
}
