// v0.3-M9 C10, stays legal: the body assigns a field of the loop variable (one cell of the
// walked list) that has the walked field's name: that frees the cell's list, not the walked one.
shape Leaf {
  rows: Array<Int>
}
shape Tree {
  rows: Array<Leaf>
}
function entrypoint() -> Nothing {
  let tree: Tree = { rows: [{ rows: [1] }, { rows: [2] }] }
  let total = 0
  for (leaf in tree.rows) {
    leaf.rows = [5]
    total = total + leaf.rows[0].or(0)
  }
  print(total)
}
