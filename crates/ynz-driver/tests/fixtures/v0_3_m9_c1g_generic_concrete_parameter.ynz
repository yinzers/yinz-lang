// v0.3-M9 C1g (security): a generic function's parameter with a CONCRETE type (`second: Big`)
// receives a different shape (`pick(big, tiny)`). No type parameter is involved in the
// mismatching parameter, so only a comparison of the argument with the declared type catches it.
// Correct behavior: does not compile — refused, naming the parameter's declared type.
// Pre-fix failure: compiled; `pick` read the 1-byte `Tiny` as a 16-byte `Big`.

shape Tiny {
  flag: boolean
}
shape Big {
  label: string
  count: int
}

function pick<T>(share first: T, share second: Big) -> int {
  return second.count
}

function entrypoint() -> nothing {
  let big: Big = { label: `hello`, count: 3 }
  let tiny: Tiny = { flag: true }
  print(pick(big, tiny).toString())
}
