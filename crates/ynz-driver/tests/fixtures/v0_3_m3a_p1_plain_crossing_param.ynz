// Fixture: plain crossing parameter — a parameter `x` that is read after a
// `wait` with NO inner shadow. Parameters are frame-slotted at function entry
// and survive the suspension correctly. This must compile and run cleanly,
// printing the original parameter value.
// Expected: exit 0, stdout = "7".
function f(x: int) -> nothing {
  wait sleep(5)
  print(x.toString())
}
function entrypoint() -> nothing {
  f(7)
}
