// v0.3-M9 C10: a `return` inside the loop, after the iterated binding was reassigned, still
// releases the list the loop was walking. Correct behavior: prints 4, 3.

function find(start: Array<Array<Int>>) -> Int {
  let matrix: Array<Array<Int>> = start.copy()
  let total = 0
  for (row in matrix) {
    matrix = [[9]]
    total = total + row[0].or(0)
    if (total > 3) {
      return total
    }
  }
  return total + matrix.count()
}

function entrypoint() -> Nothing {
  print(find([[1, 2], [3, 4], [5, 6]]))
  print(find([[1], [1]]))
}
