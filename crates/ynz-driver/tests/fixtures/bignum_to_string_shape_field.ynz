// Card #419: `.toString()` on a bignum shape field.
shape Account {
  budget: Number<40>
}

function render(acct: Account) -> Nothing {
  let text = acct.budget.toString()
  print(text)
  print(acct.budget)
}

function entrypoint() -> Nothing {
  let one: Number<40> = 1.0
  let acct: Account = { budget: one / 3.0 }
  render(acct)
}
