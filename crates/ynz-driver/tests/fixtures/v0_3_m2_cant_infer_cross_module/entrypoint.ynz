// Cross-module call from a suspending function to a non-suspending imported function.
// `entrypoint` reaches sleep (suspending). `remoteOp` is imported from utils and is
// non-suspending — the compiler now correctly propagates suspension flags across
// module boundaries (v0.3-M3b P1), so this compiles and runs cleanly.
// Expected: exits 0, prints "remote op".
import { remoteOp } from `utils`

function entrypoint() -> nothing {
  sleep(10)
  remoteOp()
}
