// v0.3-M9 C3a print-cost fixture: printing a shape allocates only the debug text, not one string per int/float/number field.
// 1,000 iterations; the test counts heap strings through the runtime's string counter.
//
// Expected last line: 1000

shape Reading {
  count: int
  ratio: float
  price: number
}

function entrypoint() -> nothing {
  let i: int = 0
  let ratio: float = (3).toFloat()
  let price: number = 9.5
  while (i < 1000) {
    let reading: Reading = { count: i, ratio: ratio, price: price }
    print(reading)
    i = i + 1
  }
  print(i)
}
