// v0.3-M9 C3b fixture: a `let` and a reassignment store a string.
// A string still read afterwards is stored as an owned copy; the last read of a binding and a
// fresh string are stored by move; a literal is borrowed, so it is copied.
// Heap strings allocated: `source` 1 (fresh), `copied` 1 (copy: `source` is read again),
// `handedOn` 1 (fresh), `moved` 0 (last use of `handedOn`), `fromLiteral` 1 (copy of a literal),
// `second` 1 (fresh), `second = fromLiteral` 1 (copy: `fromLiteral` is read again). Total 6.
// Expected output: one value per line below.

function entrypoint() -> Nothing {
  let count: Int = 4
  let source: String = `item-${count}`
  let copied: String = source
  print(source)
  print(copied)
  let handedOn: String = `next-${count}`
  let moved: String = handedOn
  print(moved)
  let fromLiteral: String = `plain`
  let second: String = `x-${count}`
  second = fromLiteral
  print(second)
  print(fromLiteral)
}
