// A second, unrelated 1-byte shape named `Big`, the variant of `HolderB`'s union field.
shape Big {
  flag: Boolean
}
shape Tiny {
  flag: Boolean
}
export shape HolderB {
  slot: Big | Tiny
  id: Int
}
export function makeB() -> HolderB {
  let tiny: Tiny = { flag: true }
  let holder: HolderB = { slot: tiny, id: 2 }
  return holder
}
