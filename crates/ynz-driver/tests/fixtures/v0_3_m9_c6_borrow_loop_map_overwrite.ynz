// v0.3-M9 C6 security r1 red fixture: a map-loop entry reads a value the body overwrites
// Expected output is what base cf5a42dd prints; head frees the old value under the live reader.

function entrypoint() -> nothing {
  let table: map<string, string> = { `k`: `v-${1}` }
  for (entry in table) {
    table[`k`] = `w-${2}`
    print(entry.value)
  }
}
