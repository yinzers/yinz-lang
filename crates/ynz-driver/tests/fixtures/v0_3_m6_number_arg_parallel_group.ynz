// v0.3-M6 Phase 1b fix-loop RED fixture (FRAGO 006 / signed R14): number-arg UAF through
// the AUTO-PARALLELIZED independent I/O group path (`emit_io_member_init`).
// Correct behavior: `grow(x)` and `shrink(y)` are bare (no explicit `wait`) suspending
// calls to DISTINCT callees with no data dependency and trivially-copyable `number` args,
// so `partition_independent_groups` lowers them as ONE parallel group; each callee reads
// its decimal128 arg AFTER its own suspend point, so the staged value must live in the
// surviving composed heap frame. Prints 2.5 then 4.5, exits 0.
// Pre-fix failure (the documented UAF): the group path's arg staging
// (`emit_io_member_init`) lowers `x`/`y` via `load`, which copies the i128 bits into a
// FRESH resume-fn STACK alloca and stages ptr_to_int(temp) into the child frame — the
// third staging loop the Phase 1b fix missed. The parent returns Pending, its stack dies,
// and each resumed child dereferences its dangling temp — garbage instead of 2.5/4.5.

function grow(n: number) -> number {
  wait sleep(10)
  return n
}

function shrink(m: number) -> number {
  wait sleep(10)
  return m
}

function entrypoint() -> nothing {
  wait sleep(1)
  let x: number = 2.5
  let y: number = 4.5
  const a = grow(x)
  const b = shrink(y)
  print(a.toString())
  print(b.toString())
}
