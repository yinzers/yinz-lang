// v0.3-M9 C6: a shape is not a map key; it is made of several fields, so a key slot could hold
// only where it lives.
// Correct behavior: does not compile; the refusal names the type, a key to use, and why.
shape Point {
  x: Int
  y: Int
}

function entrypoint() -> Nothing {
  let labels: Map<Point, String> = {}
  print(labels.count())
}
