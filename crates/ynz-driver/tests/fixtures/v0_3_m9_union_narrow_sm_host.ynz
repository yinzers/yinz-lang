// v0.3-M9 C1: `is Variant =>` narrowing inside a STATE-MACHINE function (the second
// lowering site, `lower_sm_match`): the function suspends (`wait sleep`) BEFORE the union is
// created, so `fig` does not cross the suspension. Narrowed `fig` is passed to a function,
// used as a UFCS receiver, and copied with `let inner: Circle = fig`.
// Correct behavior: prints `round`, `5.0`, `round`, `end`; clean under AddressSanitizer.
// Pre-fix failure: every one of those reads went through the 16-byte union envelope.
// Fields are `number` (a plain `float` prints `0.000...` — separate pre-existing bug).

shape Circle {
  radius: number
  label: string
}
shape Square {
  side: number
}
shape Figure = Circle | Square

function describe(share c: Circle) -> string {
  return c.label
}

function area(share self: Circle) -> number {
  return self.radius
}

function entrypoint() -> nothing {
  wait sleep(5)
  let c: Circle = { radius: 5.0, label: `round` }
  let fig: Figure = c
  if (fig) {
    is Circle => {
      print(describe(fig))
      print(fig.area())
      let inner: Circle = fig
      print(inner.label)
    }
    is Square => {
      print(fig.side)
    }
  }
  print(`end`)
}
