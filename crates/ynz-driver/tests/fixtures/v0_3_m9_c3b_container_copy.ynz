// v0.3-M9 C3b fixture: a string held by a copied container is copied with it: `.copy()` of a
// shape with a string field, `.copy()` of a `map<string, string>` (key and value), and a
// `maybe<string>` stored in a shape field or returned (its payload is a string the place owns).
// Allocations: `t` name 1 (fresh), `t.copy()` 1; the map literal's key 1 and value 1 (fresh),
// `table.copy()` copies the key and the value 2; `names` element 1 (fresh); `let m =
// names.get(0)` copies the payload 1; `{ slot: m }` 1; `pick` returns a payload copy 1 and
// `let p = pick(names)` copies it again 1. Total 1+1+1+1+2+1+1+1+1+1 = 11.
// Expected output: one value per line below.

shape Tag {
  name: string
  id: int
}
shape Holder {
  slot: maybe<string>
}

function pick(names: array<string>) -> maybe<string> {
  return names.get(0)
}

function entrypoint() -> nothing {
  let n: int = 1
  let t: Tag = { name: `t-${n}`, id: 1 }
  let c = t.copy()
  print(c.name)
  let table: map<string, string> = { `a`: `v-${n}` }
  let tc = table.copy()
  print(tc.get(`a`).or(`none`))
  let names: array<string> = [`x-${n}`]
  let m = names.get(0)
  let h: Holder = { slot: m }
  print(h.slot.or(`none`))
  let p = pick(names)
  print(p.or(`none`))
}
