// v0.3-M9 C1j: a `background` call passes a union field of a NAMED value (`bag.choice`). A union
// has no independent copy (a named union read after a spawn is refused the same way), and `bag`
// is a live value that releases the field when `launch` returns. Before the fix this compiled; on
// `main` it ran wrong (the wrong variant at O2, nothing at O0, ASan stack-use-after-return).
// Expected: a compile error naming the type and the line.

shape Circle {
  radius: float
}

shape Tag {
  name: string
}

shape Bag {
  choice: Circle | Tag
  id: int
}

function f(choice: Circle | Tag) -> nothing {
  wait sleep(100)
  if (choice) {
    is Circle => {
      print(`circle`)
    }
    is Tag => {
      print(choice.name)
    }
  }
}

function launch() -> nothing {
  let tag: Tag = { name: `boxed`.toUpperCase() }
  let bag: Bag = { choice: tag, id: 1 }
  background f(bag.choice)
}

function entrypoint() -> nothing {
  launch()
  wait sleep(300)
  print(`done`)
}
