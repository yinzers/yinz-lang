// v0.3-M2 Phase 7 Round-2: composed-single-alloc proof, background variant.
// background spawn allocates ONE additional frame for the spawned task tree.
// Expected: alloc=2 (1 for the main task tree + 1 for the spawned task).

function worker() -> nothing {
  wait sleepAsync(1)
  print(`worker done`)
}

function entrypoint() -> nothing {
  background worker()
  wait sleepAsync(5)
  print(`main done`)
}
