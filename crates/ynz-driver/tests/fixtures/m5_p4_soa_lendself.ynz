// M5 P4 step 4 — SoA decline fixture: LEND-SELF SHAPE FILTER (E6, roadmap mandate).
//
// A standalone `recordHit(lend self: Pirate, ...)` exists (mirrors
// examples/pirates-roster/entrypoint.ynz), so EVERY array<Pirate> declines at the
// shape level regardless of call sites — SoA would split storage a lend-self
// function expects contiguous. The `crew` hot loop otherwise fully qualifies
// (66 > 64, 1-field union, no escape/growth). Asserted verdict:
// LendSelfMethod { function: "recordHit" }.
shape Pirate {
  hits: int
  bounty: int
}

function recordHit(lend self: Pirate, amount: int) -> nothing {
  self.hits = self.hits + amount
}

function entrypoint() -> nothing {
  let crew: array<Pirate> = [
