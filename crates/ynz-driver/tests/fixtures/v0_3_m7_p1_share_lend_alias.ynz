// Compile-rejection fixture (v0.3-M7 Phase 1 RED → Phase 2 resolution, FRAGO 002):
// the SAME value passed as both a `share` and a `lend` argument in one call. Phase 1
// committed this as a RED miscompile repro (typeck accepted the call while codegen
// claimed `noalias` on both parameters; the optimizer hoisted the `src.value` read past
// the aliased `dst.value = 5` store — printed 1 instead of 5). Phase 2's decided fix is
// typeck REJECTION: `lend` means exclusive mutable access, so this call is an ownership-
// contract violation caught at compile time (Golden Rule 5).
//
// Expected: COMPILE ERROR — "`h` is passed to `relay` twice in the same call".
shape Box {
  value: int
}

function relay(share src: Box, lend dst: Box) -> nothing {
  dst.value = 5
  dst.value = src.value
}

function entrypoint() -> nothing {
  let h: Box = { value: 1 }
  relay(h, h)
  print(h.value.toString())
}
