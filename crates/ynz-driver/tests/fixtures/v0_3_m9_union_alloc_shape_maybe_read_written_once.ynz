// v0.3-M9 C1f (#423) round 2: baseline of `v0_3_m9_union_alloc_shape_maybe_read_written.ynz`, one round.
// Correct behavior: prints 1.
shape End {
  flag: Boolean
}
shape Node {
  value: Int
  next: Node | End
}
shape Holder {
  chain: Node | End
  id: Int
}
shape Outer {
  inner: Holder
  tag: Int
}

function buildChain() -> Node {
  let stop: End = { flag: true }
  let last: Node = { value: 3, next: stop }
  let middle: Node = { value: 2, next: last }
  let top: Node = { value: 1, next: middle }
  return top
}

function makeHolder() -> Holder {
  let top = buildChain()
  let holder: Holder = { chain: top, id: 1 }
  return holder
}

function entrypoint() -> Nothing {
  let holders: Array<Holder> = []
  holders.add(makeHolder())
  let total = 0
  let round = 0
  while (round < 1) {
    let found = holders.get(0)
    holders.set(0, makeHolder())
    if (found.exists()) {
      total = total + found.value.id
    }
    round = round + 1
  }
  print(total)
}
