// M3e danger-matrix: string × crossing-local × direct.
// A string local declared before the cross-module suspending call must hold its value after resume.
// Strings are pointer-sized frame slots; the slot must be correctly placed in the composed
// frame so the pointer survives the cross-module suspension boundary intact.
// Expected output: "before: hello\nafter: hello"
import { fetchData } from `io_ops`

function caller() -> nothing {
  const name: string = `hello`
  print(`before: ${name}`)
  fetchData()
  print(`after: ${name}`)
}

function entrypoint() -> nothing {
  caller()
}
