// M5 P3 step 1 — map<K,Shape> RED-matrix cell + step 5(b) MapEntry-aliasing
// cell: an entry VALUE escaping the iteration into an outer binding. If the
// entry binding aliased a per-site reused slot (the class store_binding fixed
// for arrays), `keep` would silently read the LAST iteration's bytes (3/30);
// the golden asserts the matched entry's bytes (1/10).
shape Part {
  qty: int
  price: int
}

function entrypoint() -> nothing {
  let pa: Part = { qty: 1, price: 10 }
  let pb: Part = { qty: 2, price: 20 }
  let pc: Part = { qty: 3, price: 30 }
  let stock: map<string, Part> = { `a`: pa, `b`: pb, `c`: pc }
  let keep: Part = { qty: 0, price: 0 }
  for (entry in stock) {
    if (entry.value.qty == 1) {
      keep = entry.value
    }
  }
  print(keep.qty)
  print(keep.price)
}
