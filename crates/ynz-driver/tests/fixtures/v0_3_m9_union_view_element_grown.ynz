// v0.3-M9 C1f (#423) round 2: an element read of an array is a view only while the array is not
// written. `first` is read after 40 more elements were added (the buffer grew and moved), so it must
// own a copy of the element it named; a view into the old buffer would read freed memory.
// Correct behavior: prints `big first` then `41`; clean under AddressSanitizer at -O0 and -O2.

shape Tiny {
  flag: boolean
}
shape Big {
  label: string
  count: int
}
shape Thing = Tiny | Big

function describe(share thing: Thing) -> string {
  if (thing) {
    is Tiny => {
      return `tiny`
    }
    is Big => {
      return `big ${thing.label}`
    }
  }
  return `none`
}

function entrypoint() -> nothing {
  let things: array<Thing> = []
  let big: Big = { label: `first`, count: 1 }
  things.add(big)
  let first = things.get(0)
  let index = 0
  while (index < 40) {
    let filler: Tiny = { flag: true }
    things.add(filler)
    index = index + 1
  }
  if (first.exists()) {
    print(describe(first.value))
  }
  print(things.count())
}
