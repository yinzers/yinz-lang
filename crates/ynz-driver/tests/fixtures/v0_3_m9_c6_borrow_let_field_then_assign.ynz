// v0.3-M9 C6 security r1 red fixture: let of an array field aliases it; the field assign frees it
// Expected output is what base cf5a42dd prints; head frees the old value under the live reader.

shape Bucket {
  rows: array<int>
  id: int
}
function entrypoint() -> nothing {
  let b: Bucket = { rows: [10, 20, 30], id: 1 }
  let r = b.rows
  b.rows = [9]
  print(r.count())
  print(r[0].or(-1))
}
