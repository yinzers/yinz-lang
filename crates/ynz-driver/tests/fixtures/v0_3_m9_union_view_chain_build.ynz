// v0.3-M9 C1f (#423) round 2: baseline of `v0_3_m9_union_view_chain_walk.ynz`: builds a crate
// holding a 100-link chain and does not read it. Correct behavior: prints `built`.
shape End {
  flag: Boolean
}
shape Node {
  value: Int
  next: Node | End
}
shape Holder {
  chain: Node | End
  id: Int
}
shape Crate {
  holder: Holder
  tag: Int
}

function sum(share head: Node | End) -> Int {
  if (head) {
    is Node => {
      let rest = head.next
      return head.value + sum(rest)
    }
    is End => {
      return 0
    }
  }
  return 0
}

function makeCrate(count: Int) -> Crate {
  let stop: End = { flag: true }
  let list: Node | End = stop
  let index = 0
  while (index < count) {
    let node: Node = { value: index, next: list }
    let wrapped: Node | End = node
    list = wrapped
    index = index + 1
  }
  let holder: Holder = { chain: list, id: 1 }
  let crate: Crate = { holder: holder, tag: 2 }
  return crate
}

function makeShort() -> Node {
  let stop: End = { flag: true }
  let only: Node = { value: 9, next: stop }
  return only
}

function entrypoint() -> Nothing {
  let crate = makeCrate(100)
  print(`built`)
}
