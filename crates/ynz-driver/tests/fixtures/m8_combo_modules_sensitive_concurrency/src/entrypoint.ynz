// M8 combo: modules + sensitive + concurrency.
// Demonstrates: import syntax, sensitive type, background (sequential).
import { ApiCred, validateCred } from `auth`

function processRequest(key: sensitive string) -> nothing {
  print(key)
}

function entrypoint() -> nothing {
  let apiKey: sensitive string = sensitive(`super-secret-key`)
  print(apiKey)
  print(apiKey.reveal())
  background processRequest(apiKey)
  print(`done`)
}
