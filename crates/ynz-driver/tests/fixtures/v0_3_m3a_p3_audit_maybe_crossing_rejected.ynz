// Audit: maybe<int> crossing local across top-level wait — must be LOUD compile error (exit 1).
// maybe<T> is represented as a pointer to a stack-allocated {tag,payload} struct.
// The stack frame is freed on suspension; the crossing-local frame slot holds a dangling pointer.
function entrypoint() -> nothing {
  let m: maybe int = 42
  wait sleep(5)
  print(m.or(0).toString())
}
