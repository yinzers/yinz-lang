// v0.3-M9 C6 fixture: a channel of arrays of strings. The channel registers drop glue for its
// element type at construction; the glue must be the one release function of the element type
// (the array and the strings it owns), not a flat array drop.
// Expected output: the received count.

function entrypoint() -> Nothing {
  let wire: Channel<Array<String>> = Channel<Array<String>>(2)
  let items: Array<String> = [`a`, `b`]
  wire.send(items)
  let got = wire.receive()
  let received: Array<String> = got.or([])
  print(received.count())
}
