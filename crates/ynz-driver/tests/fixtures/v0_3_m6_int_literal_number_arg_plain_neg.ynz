// WHY: NEGATIVE int literal into a `number` param through the plain call form
// (`toll(-5)`). Pre-fix this already rendered a CLEAN generic mismatch error via
// the types_compatible backstop — it is unified under the shared gate so ALL
// call forms render the byte-identical teaching diagnostic (non-oop.md).
function toll(amount: number) -> number {
  return amount
}

function entrypoint() -> nothing {
  print(toll(-5))
}
