// v0.3-M9 C1f (#423): a shape literal that stores a plain variant in a union field, returned
// from the function that built it; and a field store into a `lend` shape from a callee, read
// after the callee's frame is gone. The union field is the shape's own 16 bytes and its payload
// lives outside every frame.
// Correct behavior: prints `big escaped`, `tiny`, `big stored`, `end`; clean under
// AddressSanitizer at both optimization levels.
// Failure on the base (measured, commit 00cd7ca): the first read prints `int` instead of
// `big escaped` at -O0 and segfaults at -O2.

shape Tiny {
  flag: boolean
}
shape Big {
  label: string
  count: int
}
shape Thing = Tiny | Big

shape Holder {
  name: string
  slot: Tiny | Big
}

function describe(share thing: Thing) -> string {
  if (thing) {
    is Tiny => {
      return `tiny`
    }
    is Big => {
      return `big ${thing.label}`
    }
  }
  return `none`
}

function build() -> Holder {
  let big: Big = { label: `escaped`, count: 1 }
  let holder: Holder = { name: `h`, slot: big }
  return holder
}

function build_tiny() -> Holder {
  let tiny: Tiny = { flag: true }
  let holder: Holder = { name: `thing`, slot: tiny }
  return holder
}

function restock(lend holder: Holder) -> nothing {
  let big: Big = { label: `stored`, count: 2 }
  let as_thing: Thing = big
  holder.slot = as_thing
}

function clobber(seed: int) -> int {
  let plusOne = seed + 1
  let doubled = plusOne * 2
  let reduced = doubled - 3
  return reduced + plusOne
}

function entrypoint() -> nothing {
  let first = build()
  let second = build_tiny()
  let third = build_tiny()
  restock(third)
  let scratch = clobber(9)
  print(describe(first.slot))
  print(describe(second.slot))
  print(describe(third.slot))
  print(`end`)
}
