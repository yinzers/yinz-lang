// v0.3-M9 C3a print-cost fixture: interpolating an int allocates only the result string.
// 1,000 iterations; the test counts heap strings through the runtime's string counter.
//
// Expected last line: 1000


function entrypoint() -> Nothing {
  let i: Int = 0
  let ratio: Float = (3).toFloat()
  let price: Number = 9.5
  while (i < 1000) {
    let line: String = `n=${i}`
    i = i + 1
  }
  print(i)
}
