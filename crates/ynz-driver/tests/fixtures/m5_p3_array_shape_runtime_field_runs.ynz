// WHY: v0.3-M5 P3 crossing-wait ACCEPTANCE (the scratch doc's named signal) — an
// array<Shape> whose elements have runtime-computed field values (variables, not
// compile-time int/bool literals) crossing a `wait` must print CORRECT values.
// Pre-M5 this was the silent stack-garbage miscompile the interim
// ArrayShapeRuntimeFieldWithWait guard loud-rejected; the by-value ABI cut stores
// element bytes inline in the heap buffer (stable owner across suspension), so the
// guard is LIFTED and this exact program now runs. Expected: total = 10+20 = 30.
// See docs/internal/implementation/IMP-concurrency.md 'ArrayShapeRuntimeFieldWithWait — LIFTED'.
shape Item {
  id: int
  qty: int
}

function entrypoint() -> nothing {
  let a: int = 10
  let b: int = 20
  let items: array<Item> = [{ id: 1, qty: a }, { id: 2, qty: b }]
  let total: int = 0
  wait sleep(5)
  for (it in items) {
    total = total + it.qty
  }
  print(total.toString())
}
