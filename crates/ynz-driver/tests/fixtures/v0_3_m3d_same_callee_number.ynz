// v0.3-M3d same-callee distinctness: two calls to the SAME function with DIFFERENT inputs,
// run at the same time, each returning a `number`. `a` is sumn(2) (3.0) and `b` is sumn(4)
// (6.0) — the two results stay separate, so the prints differ. Both print the same lines
// whether or not the two calls run at the same time.

function sumn(n: int) -> number {
  let total: number = 0.0
  let i: int = 0
  while (i < n) {
    total = total + 1.5
    i = i + 1
  }
  return total
}

function entrypoint() -> nothing {
  let a = sumn(2)
  let b = sumn(4)
  print(a)
  print(b)
}
