// WHY: under-rejection hole in the R6 pre-check — an array<Shape> whose `let` binding
// is declared INSIDE a nested `if` body crossing a `wait` was silently miscompiling.
// The old pre-check walked only the top-level statement list and couldn't find the
// `let items` there (it's nested), so it returned false and skipped the guard.
// After deleting the pre-check, `items` is in `crossings` (the crossing analysis
// examines nested scopes) and the guard must fire with exit 1.
// See design/concurrency.md 'ArrayShapeRuntimeFieldWithWait'.
shape Item {
  id: int
  qty: int
}

function entrypoint() -> nothing {
  let a: int = 10
  let b: int = 20
  let cond: boolean = true
  if (cond) {
    let items: array<Item> = [{ id: 1, qty: a }, { id: 2, qty: b }]
    wait sleep(5)
    let total: int = 0
    for (it in items) {
      total = total + it.qty
    }
    print(total.toString())
  }
}
