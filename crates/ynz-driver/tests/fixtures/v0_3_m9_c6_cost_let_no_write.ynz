// v0.3-M9 C6 cost fixture: a `let` of a field nobody overwrites copies nothing.
// Allocations: the field's literal (header + buffer).

shape Bucket {
  rows: Array<Int>
  id: Int
}

function entrypoint() -> Nothing {
  let bucket: Bucket = { rows: [10, 20, 30], id: 1 }
  let rows = bucket.rows
  print(rows.count())
}
