// v0.3-M3b Phase 2 fixture (b): `background fn(x)` with `x` used after the spawn.
// The compiler infers `.copy` — the caller reads `taskId` again after the spawn,
// so the task gets its own copy and the caller retains the original.
//
// `caller sees: 42` must appear after `after spawn`, proving the caller still holds
// the original value. The task also prints `task ran: 42` from its copy.

function processTask(id: int) -> nothing {
  sleepBlocking(10)
  print(`task ran: ${id}`)
}

function entrypoint() -> nothing {
  let taskId: int = 42
  print(`before spawn`)
  background processTask(taskId)
  // taskId IS read after this point — compiler infers .copy
  print(`caller sees: ${taskId}`)
  print(`after spawn`)
  sleepBlocking(100)
}
