// v0.3-M9 C10: `ping` writes `holder.rows` only through `pong`, and `pong` calls `ping` back. The
// summary of what each function writes is a fixpoint over the call graph, so the loop's call to
// `ping` is refused though `ping` has no assignment of its own that the call can see.
shape Holder {
  rows: array<array<int>>
}
function ping(lend holder: Holder, depth: int) -> nothing {
  if (depth > 0) {
    pong(holder, depth - 1)
  }
}
function pong(lend holder: Holder, depth: int) -> nothing {
  if (depth > 1) {
    ping(holder, depth - 1)
  }
  holder.rows = [[9]]
}
function entrypoint() -> nothing {
  let holder: Holder = { rows: [[1], [2], [3]] }
  let total = 0
  for (row in holder.rows) {
    ping(holder, 3)
    total = total + row[0].or(0)
  }
  print(total)
}
