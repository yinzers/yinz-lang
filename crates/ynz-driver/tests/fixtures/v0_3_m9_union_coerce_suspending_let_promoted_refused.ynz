// v0.3-M9 C1e (#421): `combine` has no `wait`, so typeck sees it as an ordinary function; the
// compiler later turns it into a function that pauses and resumes (it runs the two `leaf` calls
// at the same time), and `entrypoint` holds a `wait`, so its `let m: Mixed = combine()` is
// bound by the state-machine lowering, which skips the union envelope. The build must refuse
// it with the teaching diagnostic naming the call, never the "compiler bug" box.
// Correct behavior: does not compile (the refusal names `combine()`).
// Pre-fix failure: codegen's guard fired and the user saw "This is a compiler bug".
shape Circle {
  name: string
}
shape Mixed = Circle | int

function show(share m: Mixed) -> string {
  if (m) {
    is Circle => {
      return `circle ${m.name}`
    }
    else => {
      return `int`
    }
  }
}

function leaf(n: int) -> int {
  let t = 0
  let i = 0
  while (i < n) {
    t = t + i
    i = i + 1
  }
  return t
}

function combine() -> int {
  let a = leaf(10)
  let b = leaf(11)
  return a + b
}

function entrypoint() -> nothing {
  wait sleep(1)
  let m: Mixed = combine()
  print(show(m))
}
