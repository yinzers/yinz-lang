// v0.3-M9 C6 borrow probe: overwriting and growing a map while a reader holds an old value
function entrypoint() -> Nothing {
  let table: Map<String, String> = {}
  for (index in range(0, 40)) {
    table[`k${index}`] = `v${index}`
  }
  let maybeFirst: Maybe<String> = table.get(`k0`)
  let first: String = maybeFirst.or(`none`)
  for (index in range(0, 40)) {
    table[`k${index}`] = `w${index}`
  }
  table[`extra`] = `e`
  print(first)
  let maybeLast: Maybe<String> = table.get(`k0`)
  print(maybeLast.or(`none`))
  print(table.count())
}
