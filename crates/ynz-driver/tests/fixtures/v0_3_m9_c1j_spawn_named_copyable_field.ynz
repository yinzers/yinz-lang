// v0.3-M9 C1j control: a `background` call passes a field of a NAMED value whose type has an
// owned copy (`array<string>`). The task gets a copy of its own, so `launch` can return and
// release `bag` while the task still reads. Must stay accepted, balanced and ASan clean.
// Expected output: the count, the first name, then `done`.

shape Bag {
  items: Array<String>
  id: Int
}

function f(items: Array<String>) -> Nothing {
  wait sleep(100)
  print(items.count())
  print(items[0].or(`?`))
}

function launch() -> Nothing {
  let names: Array<String> = [`a`.toUpperCase(), `b`.toUpperCase()]
  let bag: Bag = { items: names, id: 1 }
  background f(bag.items)
}

function entrypoint() -> Nothing {
  launch()
  wait sleep(300)
  print(`done`)
}
