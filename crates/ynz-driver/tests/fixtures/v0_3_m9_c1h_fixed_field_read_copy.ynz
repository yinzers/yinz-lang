// v0.3-M9 C1h: reading a fixed field into a binding gives the binding its own copy when the binding is written; a lend function writes the field in place.
// Expected output: 1, 99, B, 11, 16

shape Bag {
  items: Fixed<Int, 3>
  names: Fixed<String, 2>
}

function bump(lend bag: Bag) -> Nothing {
  bag.items.set(0, bag.items[0].or(0) + 10)
}

function entrypoint() -> Nothing {
  let bag: Bag = { items: [1, 2, 3], names: [`a`.toUpperCase(), `b`.toUpperCase()] }
  let alias = bag.items
  alias.set(0, 99)
  print(bag.items[0].or(-1))
  print(alias[0].or(-1))
  let aliasNames = bag.names
  print(aliasNames[1].or(`?`))
  bump(bag)
  print(bag.items[0].or(-1))
  let total: Int = 0
  for (n in bag.items) {
    total = total + n
  }
  print(total)
}
