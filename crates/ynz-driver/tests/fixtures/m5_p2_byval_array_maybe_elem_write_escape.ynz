// M5 P2 fix round 3 — tripwire (B1): a maybe<Part> ENVELOPE persisted as an
// ARRAY ELEMENT WRITE (`.set()` on `array<maybe<Part> >` — nested generic
// needs the space). Non-shape element cells hold i64 bits; the maybe bits
// were bare ptr_to_int(per-site envelope), reused every iteration, so the
// cell read back after the loop showed the LAST iteration's payload (3/30),
// not the persisted one (1/10). Locks the array element-write marshalling to
// the ONE stable-bits choke point (value_to_stable_bits: heap-cloned
// envelope + payload per write). Covers BOTH admission routes: annotation
// (`array<maybe<Part> >`) and inference (`[empty]` from a maybe binding).
shape Part {
  qty: int
  price: int
}

function entrypoint() -> nothing {
  let seed: int = 1
  let qa: int = seed * 1
  let qb: int = seed * 2
  let qc: int = seed * 3
  let parts: array<Part> = [
    { qty: qa, price: qa * 10 },
    { qty: qb, price: qb * 10 },
    { qty: qc, price: qc * 10 }
  ]
  let empty: maybe<Part> = parts[9]
  // Inference route: element type comes from `empty`'s maybe<Part>.
  let inferred = [empty]
  // Annotation route: explicit nested-generic element type.
  let annotated: array<maybe<Part> > = [empty]
  let i: int = 0
  while (i < 3) {
    let cur: maybe<Part> = parts[i]
    if (i == 0) {
      inferred.set(0, cur)
      annotated.set(0, cur)
    }
    i = i + 1
  }
  let entryA = inferred.get(0)
  if (entryA.exists()) {
    let gotA: maybe<Part> = entryA.value
    if (gotA.exists()) {
      print(gotA.value.qty)
      print(gotA.value.price)
    }
  }
  let entryB = annotated.get(0)
  if (entryB.exists()) {
    let gotB: maybe<Part> = entryB.value
    if (gotB.exists()) {
      print(gotB.value.qty)
      print(gotB.value.price)
    }
  }
}
