// v0.3-M9 C8 (card #385) — a handle binding leaving its scope stops its task.
//
// The handle `h` is bound inside a block that exits while the child is still mid-work. The
// scope-exit release of the block calls `ynz_handle_free`, which stops the child at its next
// suspension: `child: after first sleep` and `child: done` are lost, the parent's three lines
// are not (`v03_m8_handle_scope_pin.rs`). Before C8 a suspending function released nothing, so
// the child ran to completion here.
function worker() -> int errors {
  wait sleep(20)
  print(`child: after first sleep`)
  wait sleep(20)
  print(`child: done`)
  return 42
}

function entrypoint() -> nothing {
  if (true) {
    let h = background worker()
    print(`parent: leaving block`)
  }
  print(`parent: block exited`)
  wait sleep(150)
  print(`parent: done`)
}
