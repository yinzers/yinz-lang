// Fixture: crossing local defined in a continuation state (between two waits).
// `b` is declared after wait-1 and read after wait-2 — it must be in the frame
// so it survives the second suspension. If the alloca for `b` were created in the
// continuation state block instead of sm_entry, LLVM would reject it for dominance.
// Expected output: 3  (a=1, b=a+2=3)
function entrypoint() -> nothing {
  let a = 1
  wait sleep(5)
  let b = a + 2
  wait sleep(5)
  print(b.toString())
}
