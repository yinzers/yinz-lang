// v0.3-M9 C1e rework (#421): `map.set(key, plain)` stores a plain variant as the value of a
// `map<string, Thing>`. The stored value must be the tagged envelope of the variant stored.
// Correct behavior: prints `tiny`, `big hello`, `end`; clean under AddressSanitizer at both
// optimization levels.
// Pre-fix failure: the bare shape pointer was stored as the map value.

shape Tiny {
  flag: Boolean
}
shape Big {
  label: String
  count: Int
}
shape Thing = Tiny | Big

function describe(share thing: Thing) -> String {
  if (thing) {
    is Tiny => {
      return `tiny`
    }
    is Big => {
      return `big ${thing.label}`
    }
  }
  return `none`
}

function entrypoint() -> Nothing {
  let tiny: Tiny = { flag: true }
  let big: Big = { label: `hello`, count: 3 }
  let things: Map<String, Thing> = {}
  things.set(`a`, tiny)
  things.set(`b`, big)
  let first = things.get(`a`)
  if (first.exists()) {
    print(describe(first.value))
  }
  let second = things.get(`b`)
  if (second.exists()) {
    print(describe(second.value))
  }
  print(`end`)
}
