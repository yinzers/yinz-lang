// WHY: C8 slice 5 — a `MapEntry` of decimal key and value: the key's and the value's heap cells
// the spawn made are freed with the entry cell.
function readLater(entry: MapEntry<Number<20>, Number<20> >) -> Nothing {
  sleepBlocking(30)
  print(entry.value)
}

function entrypoint() -> Nothing {
  let stock: Map<Number<20>, Number<20> > = {}
  stock.set(1.5, 2.5)
  for (entry in stock) {
    background readLater(entry)
  }
  wait sleep(300)
}
