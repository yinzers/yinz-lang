// v0.3-M9 C1h: a shape holds a fixed<int, 3> and a fixed<string, 2> field: the list is read in place, passed to functions taking an unsized and a sized list, replaced by assignment (the old strings are released), written through set, and copied with the shape (the copy owns its own strings).
// Expected output: 3, 15, 3, X, y, 3, 7, 9, 100, q, 7, -5, p

shape Bag {
  label: String
  items: Fixed<Int, 3>
  names: Fixed<String, 2>
}

function total(share xs: Fixed<Int>) -> Int {
  let sum: Int = 0
  for (x in xs) {
    sum = sum + x
  }
  return sum
}

function sizeThree(share xs: Fixed<Int, 3>) -> Int {
  return xs.count()
}

function entrypoint() -> Nothing {
  let bag: Bag = { label: `a`, items: [4, 5, 6], names: [`x`.toUpperCase(), `y`] }
  print(bag.items.count())
  print(total(bag.items))
  print(sizeThree(bag.items))
  for (name in bag.names) {
    print(name)
  }
  let copyOfList = bag.items
  print(copyOfList.count())
  let other: Fixed<Int> = [7, 8, 9]
  bag.items = other
  print(bag.items[0].or(-1))
  print(bag.items[2].or(-1))
  bag.items.set(1, 100)
  print(bag.items[1].or(-1))
  let names: Fixed<String> = [`p`, `q`]
  bag.names = names
  print(bag.names[1].or(`?`))
  let twin = bag.copy()
  twin.items.set(0, -5)
  print(bag.items[0].or(-1))
  print(twin.items[0].or(-1))
  print(twin.names[0].or(`?`))
}
