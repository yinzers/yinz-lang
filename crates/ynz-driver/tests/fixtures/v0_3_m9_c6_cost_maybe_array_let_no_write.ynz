// v0.3-M9 C6 cost fixture: a `let` of a `maybe<array>` element read, and of its `.or`, copies no
// payload while nothing writes the list.
// Allocations: the outer literal and its one inner literal (4) and the fallback literal (2).

function entrypoint() -> nothing {
  let rows: array<array<int>> = [[10, 20, 30]]
  let picked = rows.get(0)
  let fallback: array<int> = []
  let found = picked.or(fallback)
  print(found.count())
}
