// v0.3-M9 C1e rework (#421): plain variants stored into union containers INSIDE A LOOP. A frame
// envelope is one per-site slot, so every element of one site would share the last value
// stored; each element needs its own envelope AND its own copy of the payload (#423's by-value
// envelope with an inline payload).
// Correct behavior: prints `tiny`, `big b1`, `tiny`, `big b3`, `big m0`, `big m1`, `end`; clean
// under AddressSanitizer.
// Failure of a per-site frame envelope (measured): `tiny`, `big b3`, `tiny`, `big b3`, `big m1`,
// `big m1`: ASan-clean, silently wrong.

shape Tiny {
  flag: Boolean
}
shape Big {
  label: String
  count: Int
}
shape Thing = Tiny | Big

function describe(share thing: Thing) -> String {
  if (thing) {
    is Tiny => {
      return `tiny`
    }
    is Big => {
      return `big ${thing.label}`
    }
  }
  return `none`
}

function entrypoint() -> Nothing {
  let things: Array<Thing> = []
  let round = 0
  while (round < 4) {
    if (round % 2 == 0) {
      let tiny: Tiny = { flag: true }
      things.add(tiny)
    }
    if (round % 2 == 1) {
      let big: Big = { label: `b${round}`, count: round }
      things.add(big)
    }
    round = round + 1
  }
  let i = 0
  while (i < things.count()) {
    let got = things.get(i)
    if (got.exists()) {
      print(describe(got.value))
    }
    i = i + 1
  }
  let held: Map<String, Thing> = {}
  let k = 0
  while (k < 2) {
    let big: Big = { label: `m${k}`, count: k }
    held.set(`key${k}`, big)
    k = k + 1
  }
  let first = held.get(`key0`)
  if (first.exists()) {
    print(describe(first.value))
  }
  let second = held.get(`key1`)
  if (second.exists()) {
    print(describe(second.value))
  }
  print(`end`)
}
