// Fixture: number (decimal128) returning suspending function (Round 17 — wrapper-return
// type mismatch for i128 return type).
// A `-> number` suspending function that suspends and returns a decimal128 literal.
// Prior to this fix the SM wrapper emitted `ret void` (falling through the `_ =>` fallback)
// because `Type::Number` had no explicit arm. LLVM verification failed:
// "Function return type does not match operand type of return inst!"
//
// The value 0.1 + 0.2 in decimal128 = 0.3 exactly (no IEEE-754 float rounding error).
// A truncation to 8 bytes would produce the LOWER 64 bits of the 128-bit BID encoding —
// a completely wrong value, not 0.3 — catching any hi-word truncation silently.
function sleepingNumber() -> number {
  wait sleep(5)
  let v = 0.1 + 0.2
  return v
}

function entrypoint() -> nothing {
  let r = sleepingNumber()
  print(r)
}
