// WHY: v0.3-M8 Phase 4 fix round 2 (Producer C1) — the same-call class-mate pair through a
// `background` spawn: `background eat2(rows, other)` hands the drop ladder TWO descriptors
// for ONE allocation (`other` is a piece of `rows`; each `give` argument is heap-upgraded and
// freed at task retire), a double free. The spawn's inner call runs the same
// `check_call_transfers` as a plain call, so the same-call fix closes this door too.
// C5a: the class-mate is a piece view (`rows.items`), since `let other = rows` now hands `rows`
// over and is refused on its own (`ConsumedByStore`).
// RED today: compiles. GREEN: refused with the use-after-give error naming `other` and `rows`.
shape Rows {
  items: array<int>
}

function eat2(give owner: Rows, give piece: array<int>) -> nothing {
  wait sleep(1)
  print(`${owner.items.count()} ${piece.count()}`)
}

function entrypoint() -> nothing {
  let rows: Rows = { items: [1, 2, 3] }
  let other: array<int> = rows.items
  background eat2(rows, other)
}
