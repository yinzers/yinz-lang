// v0.3-M3d danger matrix — two different functions returning a `number`, run at the same time
// inside a taken `if` branch, with the result then RETURNED out of the wrapping function. Each
// result is available after both finish; both prints match in both modes (only the values
// matter, never the finishing order). Memory is fully released on both paths — the
// run-at-the-same-time path and the plain one-after-the-other path both end with no leftover
// allocation when the number is returned out.
//
// addUp(n) loops adding 1.5 each pass, so it is worth running alongside the other call.
//
// Arithmetic: addUp(4) = 4 * 1.5 = 6.0; addDouble(6) = 6 * 2.5 = 15.0.
//
// Expected output (both modes — default and --no-auto-parallel):
//   6.0
//   15.0

function addUp(n: int) -> number {
  let total: number = 0.0
  let i: int = 0
  while (i < n) {
    total = total + 1.5
    i = i + 1
  }
  return total
}

function addDouble(n: int) -> number {
  let total: number = 0.0
  let i: int = 0
  while (i < n) {
    total = total + 2.5
    i = i + 1
  }
  return total
}

function combine() -> number {
  let result: number = 0.0
  let go = true
  if (go) {
    let lo = addUp(4)
    let hi = addDouble(6)
    print(lo)
    result = hi
  }
  return result
}

function entrypoint() -> nothing {
  let r = combine()
  print(r)
}
