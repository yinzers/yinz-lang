// v0.3-M9 C1j: a field of a fresh call result whose type is a union with no shape variant and
// heap beside `nothing` (`array<int> | nothing`) has no slot to be copied into, and the task
// would share the array with the value it is read from. Refused at compile time with the text of
// the one spawn refusal, never as a backend error.

shape Bag {
  items: Array<Int> | Nothing
  label: String
}

function make() -> Bag {
  return { items: [1, 2].copy(), label: `l`.toUpperCase() }
}

function crunch(items: Array<Int> | Nothing) -> Nothing {
  print(`task`)
}

function entrypoint() -> Nothing {
  background crunch(make().items)
  wait sleep(50)
  print(`done`)
}
