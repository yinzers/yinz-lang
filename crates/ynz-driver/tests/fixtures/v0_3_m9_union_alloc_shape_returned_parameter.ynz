// v0.3-M9 C1f (#423) round 2: `pass` returns its parameter, so its result is an alias of the
// caller's `holder` and the binding that takes it owns a deep copy (four cells); the return
// itself clones nothing. Correct behavior: prints 200. The counter test pins 400 cells more than
// the moved-binding fixture.
shape End {
  flag: Boolean
}
shape Node {
  value: Int
  next: Node | End
}
shape Holder {
  chain: Node | End
  id: Int
}
shape Outer {
  inner: Holder
  tag: Int
}

function buildChain() -> Node {
  let stop: End = { flag: true }
  let last: Node = { value: 3, next: stop }
  let middle: Node = { value: 2, next: last }
  let top: Node = { value: 1, next: middle }
  return top
}

function makeHolder() -> Holder {
  let top = buildChain()
  let holder: Holder = { chain: top, id: 1 }
  return holder
}

function pass(share holder: Holder) -> Holder {
  return holder
}

function entrypoint() -> Nothing {
  let total = 0
  let round = 0
  while (round < 100) {
    let holder = makeHolder()
    let again = pass(holder)
    total = total + again.id + holder.id
    round = round + 1
  }
  print(total)
}
