// v0.3-M9 C1f (#423) round 2: a recursive walk peels one link per call with `let rest = head.next`.
// The binding only reads the field of a `share` parameter, so it is a view of the field and the
// walk allocates nothing: the cells are the ones building the chain made (Golden Rule 6: a Rust
// borrow costs none; a copy per step costs O(n^2) cells).
// Correct behavior: prints the sum of the values and the depth.
shape End {
  flag: Boolean
}
shape Node {
  value: Int
  next: Node | End
}

function sum(share head: Node | End) -> Int {
  if (head) {
    is Node => {
      let rest = head.next
      return head.value + sum(rest)
    }
    is End => {
      return 0
    }
  }
  return 0
}

function depth(share head: Node | End) -> Int {
  if (head) {
    is Node => {
      let rest = head.next
      return 1 + depth(rest)
    }
    is End => {
      return 0
    }
  }
  return 0
}

function entrypoint() -> Nothing {
  let stop: End = { flag: true }
  let list: Node | End = stop
  let count = 0
  while (count < 100) {
    let node: Node = { value: count, next: list }
    let wrapped: Node | End = node
    list = wrapped
    count = count + 1
  }
  print(sum(list))
  print(depth(list))
}
