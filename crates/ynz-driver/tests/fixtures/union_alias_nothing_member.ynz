// WHY: `shape MaybeCircle = Circle | nothing` — a union alias with `nothing` as a member —
// used to resolve to `Circle | unknown` (a second alias resolver had no `nothing` arm), so
// `let m: MaybeCircle = make()` was refused. Alias resolution now goes through the one
// resolver, `ShapeTable::resolve_ast_type`.
shape Circle { radius: float }

shape MaybeCircle = Circle | nothing

function make() -> Circle | nothing {
  let c: Circle = { radius: 1.0 }
  return c
}

function entrypoint() -> nothing {
  let m: MaybeCircle = make()
  print(`ok`)
}
