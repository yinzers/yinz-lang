// v0.3-M9 C1f (#423) round 2: `holders.get(0)` is bound, then the element is REPLACED (`set`) while the
// binding is read, so the binding is not a view: it owns a copy of the payload, four cells, and reads
// the old holder. Correct behavior: prints 100. The counter test compares it with the single-round
// fixture: 99 more rounds, each a new holder (4 cells) and a copy (4 cells).
shape End {
  flag: Boolean
}
shape Node {
  value: Int
  next: Node | End
}
shape Holder {
  chain: Node | End
  id: Int
}
shape Outer {
  inner: Holder
  tag: Int
}

function buildChain() -> Node {
  let stop: End = { flag: true }
  let last: Node = { value: 3, next: stop }
  let middle: Node = { value: 2, next: last }
  let top: Node = { value: 1, next: middle }
  return top
}

function makeHolder() -> Holder {
  let top = buildChain()
  let holder: Holder = { chain: top, id: 1 }
  return holder
}

function entrypoint() -> Nothing {
  let holders: Array<Holder> = []
  holders.add(makeHolder())
  let total = 0
  let round = 0
  while (round < 100) {
    let found = holders.get(0)
    holders.set(0, makeHolder())
    if (found.exists()) {
      total = total + found.value.id
    }
    round = round + 1
  }
  print(total)
}
