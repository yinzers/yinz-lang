// v0.3-M9 C5a (spike S3 probe g1): `o.add(a)` stores `a` into the container with no sink, then the
// container is returned. A release pass that frees `a` at the callee's scope exit leaves the
// caller reading a freed row. GREEN today; guards C7. Expected output: `3`.
function make() -> array<array<int>> {
  let a: array<int> = [1, 2, 3]
  let o: array<array<int>> = []
  o.add(a)
  return o
}

function entrypoint() -> nothing {
  let o: array<array<int>> = make()
  for (inner in o) {
    print(inner.count().toString())
  }
}
