// M5 P4 step 4 — SoA decline fixture: RUNTIME LENGTH (D3).
//
// `pts` is initialized from a function call, not an array literal — its length is
// not compile-time provable, so it declines (the provable-length rule keeps the
// "length > threshold at the analysis-time proof point" criterion honest instead
// of guessing runtime sizes). Asserted verdicts: `pts` = LengthNotProvable; the
// `out` binding inside makePoints = Escapes { how: "returned from the function" }.
shape Point {
  x: int
  y: int
}

function makePoints() -> array<Point> {
  let out: array<Point> = [
    { x: 1, y: 2 },
    { x: 2, y: 4 },
    { x: 3, y: 6 }
  ]
  return out
}

function entrypoint() -> nothing {
  let pts = makePoints()
  let total = 0
  for (p in pts) {
    total = total + p.x
  }
  print(total)
}
