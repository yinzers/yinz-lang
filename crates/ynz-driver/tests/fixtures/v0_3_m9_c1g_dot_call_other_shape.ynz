// v0.3-M9 C1g (security): a `Tiny` passed as a NON-RECEIVER argument of a dot-call where a `Big`
// is expected (`big.useBig(tiny)` is sugar for `useBig(big, tiny)`).
// Correct behavior: does not compile — the same diagnostic as the plain form `useBig(big, tiny)`.
// Pre-fix failure: compiled (the dot-call form checked non-receiver arguments for the union case
// only), and `useBig` read the 1-byte `Tiny` as a 16-byte `Big` — it printed a stack address.

shape Tiny {
  flag: boolean
}
shape Big {
  label: string
  count: int
}

function useBig(share first: Big, share second: Big) -> int {
  return second.count
}

function entrypoint() -> nothing {
  let big: Big = { label: `hello`, count: 3 }
  let tiny: Tiny = { flag: true }
  print(big.useBig(tiny).toString())
}
