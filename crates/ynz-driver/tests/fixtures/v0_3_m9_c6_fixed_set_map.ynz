// v0.3-M9 C6 fixture: `fixed<map<string, int>>` `set` releases the map it replaces, its keys
// included.
// Expected output: the sizes of the two maps the list holds at the end.

function entrypoint() -> Nothing {
  let first: Map<String, Int> = {}
  first.set(`a-${1}`, 1)
  let second: Map<String, Int> = {}
  second.set(`b-${2}`, 2)
  let third: Map<String, Int> = {}
  third.set(`c-${3}`, 3)
  third.set(`d-${4}`, 4)
  let value: Fixed<Map<String, Int> > = [first, second]
  value.set(0, third)
  let fallback: Map<String, Int> = {}
  let firstItem: Map<String, Int> = value[0].or(fallback)
  let secondItem: Map<String, Int> = value[1].or(fallback)
  print(firstItem.count())
  print(secondItem.count())
}
