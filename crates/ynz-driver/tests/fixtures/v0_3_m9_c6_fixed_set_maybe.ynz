// v0.3-M9 C6 fixture: `fixed<maybe<string>>` `set` and index assignment release the envelope
// and the string of the `maybe` they replace.
// Expected output: the list's size.

function entrypoint() -> Nothing {
  let labels: Array<String> = [`a-${1}`, `b-${2}`]
  let first: Maybe<String> = labels.get(0)
  let second: Maybe<String> = labels.get(1)
  let value: Fixed<Maybe<String> > = [first, second]
  value.set(0, labels.get(1))
  value[1] = labels.get(0)
  print(value.count())
}
