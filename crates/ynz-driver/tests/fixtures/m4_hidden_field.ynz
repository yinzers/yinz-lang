shape Counter {
  name: String
  hidden count: Int = 0
}

function increment(lend self: Counter) -> Nothing {
  self.count = self.count + 1
}

function value(share self: Counter) -> Int {
  return self.count
}

function entrypoint() -> Nothing {
  let c: Counter = { name: `clicks` }
  c.increment()
  c.increment()
  c.increment()
  print(c.value())
}
