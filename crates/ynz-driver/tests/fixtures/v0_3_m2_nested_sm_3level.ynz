// v0.3-M2 Phase 7: 3-level nested state machine.
// Verifies Bug B fix: nested SM calls use inline poll-and-yield (no bridge abort).

function inner() -> Int {
  wait sleep(5)
  return 7
}

function middle() -> Int {
  const v = inner()
  return v + 1
}

function outer() -> Int {
  const v = middle()
  return v + 1
}

function entrypoint() -> Nothing {
  const result = outer()
  print(`nested: ${result}`)
}
