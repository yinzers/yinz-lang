// v0.3-M9 C1i: as `v0_3_m9_c1i_spawn_fixed_array_refused.ynz`, for a `fixed<map<string, int>>`.
// Expected: a compile error naming `xs`, why, and the `array` recovery.

function crunch(xs: Fixed<Map<String, Int>>) -> Nothing {
  print(xs.count())
}

function entrypoint() -> Nothing {
  let first: Map<String, Int> = {}
  first.set(`a-${1}`, 1)
  let second: Map<String, Int> = {}
  second.set(`b-${2}`, 2)
  let xs: Fixed<Map<String, Int>> = [first, second]
  background crunch(xs)
  wait sleep(50)
  print(`done`)
}
