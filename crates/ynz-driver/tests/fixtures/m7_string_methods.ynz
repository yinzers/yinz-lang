// WHY: validates basic string method codegen — toLowerCase, toUpperCase, count, split.
// If any string method runtime call or codegen is broken, the output will differ.

function main() -> nothing {
  let s = `Hello, World!`
  print(s.toLowerCase())
  print(s.toUpperCase())
  let parts = s.split(`, `)
  print(parts.count().toString())
}
