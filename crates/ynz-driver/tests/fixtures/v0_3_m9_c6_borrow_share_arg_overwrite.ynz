// v0.3-M9 C6 security r1 red fixture: a share argument reads an item another argument's lend overwrites
// Expected output is what base cf5a42dd prints; head frees the old value under the live reader.

function both(share name: string, lend items: array<string>) -> nothing {
  items[0] = `z-${3}`
  print(name)
}
function entrypoint() -> nothing {
  let items: array<string> = [`a-${1}`]
  both(items[0].or(`none`), items)
}
