shape Pt {
  a: Int
  b: Int
}
// Q3: sibling crossing `x`: first a shape (frame-embedded multi-slot), then int.
function entrypoint() -> Nothing {
  let c = true
  if (c) {
    let x: Pt = { a: 1, b: 2 }
    wait sleep(5)
    print(x.a.toString())
  }
  if (c) {
    let x: Int = 99
    wait sleep(5)
    print(x.toString())
  }
}
