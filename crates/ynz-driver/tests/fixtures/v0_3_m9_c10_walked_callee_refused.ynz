// v0.3-M9 C10: the body passes the root to a `lend` callee that assigns the walked field
// (`reset` writes `holder.rows` while the loop walks `holder.rows`). Refused at the call.
shape Holder {
  rows: array<array<int>>
}
function reset(lend holder: Holder) -> nothing {
  holder.rows = [[9]]
}
function entrypoint() -> nothing {
  let holder: Holder = { rows: [[1], [2], [3]] }
  let total = 0
  for (row in holder.rows) {
    reset(holder)
    total = total + row[0].or(0)
  }
  print(total)
}
