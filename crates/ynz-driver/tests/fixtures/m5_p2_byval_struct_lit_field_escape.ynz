// M5 P2 fix round 2 — tripwire (a2): shape element persisted through a STRUCT
// LITERAL field (`holder = { best: p }` inside the loop) — the same store_field
// funnel as direct field-assign, distinct lexical path (lower_struct_lit's
// provided-field stores). The escape survives the outer binding's shallow
// byte copy (store_binding copies Holder's bytes — i.e. the `best` POINTER
// cell), so unfixed the field reads last-iteration bytes after the loop.
shape Part {
  qty: int
  price: int
}

shape Holder {
  best: Part
}

function entrypoint() -> nothing {
  let seed: int = 1
  let qa: int = seed * 1
  let qb: int = seed * 2
  let qc: int = seed * 3
  let parts: array<Part> = [
    { qty: qa, price: qa * 10 },
    { qty: qb, price: qb * 10 },
    { qty: qc, price: qc * 10 }
  ]
  let zero: Part = { qty: 0, price: 0 }
  let holder: Holder = { best: zero }
  for (p in parts) {
    if (p.qty == 1) {
      let inner: Holder = { best: p }
      holder = inner
    }
  }
  print(holder.best.qty)
  print(holder.best.price)
}
