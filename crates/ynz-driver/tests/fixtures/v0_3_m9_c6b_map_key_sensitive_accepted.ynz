// v0.3-M9 C6 follow-up: a `sensitive string` is a `string` to a map: the same key slot, the same
// comparison by text and the same release. So it is a key, not refused.
// Correct behavior: compiles and runs; lookups by an equal secret hit, an overwrite keeps one
// entry, growth and a copy keep every key, and a key prints as [REDACTED].
function make() -> map<sensitive string, int> {
  let table: map<sensitive string, int> = {}
  let first: sensitive string = sensitive(`alpha`)
  let second: sensitive string = sensitive(`beta`)
  table.set(first, 1)
  table.set(second, 2)
  return table
}

function entrypoint() -> nothing {
  let table = make()
  let probe: sensitive string = sensitive(`alpha`)
  print(table.has(probe))
  print(table[probe].or(0 - 1))
  table.set(probe, 10)
  print(table.count())
  print(table[probe].or(0 - 1))
  let absent: sensitive string = sensitive(`gamma`)
  print(table.has(absent))
  for (index in range(0, 100)) {
    let name: sensitive string = sensitive(`key ${index}`)
    table.set(name, index + 1000)
  }
  print(table.count())
  let duplicate = table.copy()
  duplicate.set(absent, 5)
  print(`${table.count()} ${duplicate.count()}`)
  for (entry in duplicate) {
    if (entry.value == 5) {
      print(entry.key)
    }
  }
}
