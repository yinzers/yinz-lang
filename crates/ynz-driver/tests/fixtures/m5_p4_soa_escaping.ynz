// M5 P4 step 4 — SoA decline fixture: ESCAPING ARRAY (D4).
//
// `pts` runs a fully-qualifying hot loop first (66 > 64, 1-field union), then is
// passed to `sumX()` — the analysis cannot see all accesses, so the binding
// declines. Asserted verdicts: the entrypoint binding =
// Escapes { how: "passed to `sumX()` (D4)" }; the `pts` PARAMETER inside sumX is
// its own declined row — Escapes { how: "function parameter — cross-function by
// definition (D4)" } (params are recorded, never silently absent).
shape Point {
  x: int
  y: int
}

function sumX(share pts: array<Point>) -> int {
  let total = 0
  for (p in pts) {
    total = total + p.x
  }
  return total
}

