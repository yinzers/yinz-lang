// Fixture: `fixed<boolean>` array as iterator in a suspending for-loop.
// Must produce a clean WHAT/WHAT-INSTEAD/WHY compile error (exit 1).
// fixed<T> arrays are stack-allocated; their pointer becomes dangling after suspension.
// See design/concurrency.md 'FixedArrayIterWithWait'.
// Workaround: use array<boolean> instead.
function entrypoint() -> nothing {
  let flags: fixed<boolean> = [true, false, true]
  for (b in flags) {
    wait sleep(5)
    print(b.toString())
  }
}
