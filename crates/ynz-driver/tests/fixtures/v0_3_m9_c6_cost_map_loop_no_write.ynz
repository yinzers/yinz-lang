// v0.3-M9 C6 cost fixture: a `for` over a map whose body writes nothing copies no entry (the
// entry's string key and array value are read in place).
// Allocations: the literal's map (counted: 5), its two array values (2 each = 4), nothing for the
// loop. The two literal keys are heap strings the map owns (2); the loop copies neither.

function entrypoint() -> Nothing {
  let table: Map<String, Array<Int>> = { `a`: [1, 2], `b`: [3] }
  for (entry in table) {
    print(entry.value.count())
  }
}
