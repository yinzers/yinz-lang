// v0.3-M9 C1j: a `background` call passes the `fixed<array<string>, 2>` field of a NAMED value
// (`bag.rows`). The `fixed` list's cells live with the spawner's frame and its items cannot be
// copied, so the task read the dead frame (a crash, ASan: stack-use-after-return). Refused at
// compile time instead.
// Expected: a compile error naming the type and the line.

shape Bag {
  rows: Fixed<Array<String>, 2>
  id: Int
}

function f(rows: Fixed<Array<String>, 2>) -> Nothing {
  wait sleep(100)
  for (row in rows) {
    print(row.count())
  }
}

function launch() -> Nothing {
  let first: Array<String> = [`a`.toUpperCase()]
  let second: Array<String> = [`b`.toUpperCase(), `c`.toUpperCase()]
  let bag: Bag = { rows: [first, second], id: 1 }
  background f(bag.rows)
}

function entrypoint() -> Nothing {
  launch()
  wait sleep(300)
  print(`done`)
}
