// WHY: v0.3-M5 P3 step-5 ownership sweep — a background task's array<Part> arg
// must be an INDEPENDENT copy of the caller's buffer, not an alias. Pre-fix the
// spawn path passed Shape-element arrays through untouched (inline element bytes
// since the P3 by-value cut), so the task saw the caller's post-spawn mutation
// (RED observed: task total = 119). The fix routes Shape-element arrays through
// the elem_size-aware ynz_array_clone_primitive in prepare_bg_arg_for_ctx.
// The task sleeps past the caller's mutation, so an alias deterministically
// shows 119; the correct independent copy shows 30.
//
// Expected output (byte-identical default vs --no-auto-parallel):
//   caller set qty: 99
//   task total: 30
shape Part {
  id: int
  qty: int
}

function processParts(parts: array<Part>) -> nothing {
  sleepBlocking(80)
  let total: int = 0
  for (p in parts) {
    total = total + p.qty
  }
  print(`task total: ${total}`)
}

function entrypoint() -> nothing {
  let parts: array<Part> = [{ id: 1, qty: 10 }, { id: 2, qty: 20 }]
  background processParts(parts)
  let repl: Part = { id: 1, qty: 99 }
  parts[0] = repl
  print(`caller set qty: 99`)
  sleepBlocking(200)
}
