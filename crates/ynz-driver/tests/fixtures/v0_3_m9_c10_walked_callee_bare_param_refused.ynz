// v0.3-M9 C10: a parameter with no modifier that the body assigns is inferred `lend`: the callee
// writes the walked field, so the call is refused as for an explicit `lend`.
shape Holder {
  rows: array<array<int>>
}
function reset(holder: Holder) -> nothing {
  holder.rows = [[9]]
}
function entrypoint() -> nothing {
  let holder: Holder = { rows: [[1], [2], [3]] }
  let total = 0
  for (row in holder.rows) {
    reset(holder)
    total = total + row[0].or(0)
  }
  print(total)
}
