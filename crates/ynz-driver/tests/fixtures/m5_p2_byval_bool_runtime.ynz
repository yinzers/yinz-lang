// M5 P2 step 1 — by-value ABI matrix: boolean × runtime-computed elements × full op set
// (non-suspending). Bool values derive from runtime comparisons.
function entrypoint() -> nothing {
  let n: int = 7
  let t1: boolean = n > 3
  let f1: boolean = n > 100
  let t2: boolean = n == 7
  let f2: boolean = n < 0
  let flags: array<boolean> = [t1, f1, t2]
  flags.add(f2)
  print(flags.count())
  print(flags[0].or(false))
  print(flags[3].or(true))
  print(flags[9].or(true))
  print(flags.get(1).or(true))
  print(flags.first().or(false))
  print(flags.last().or(true))
  let target: boolean = n < 1
  print(flags.contains(target))
  let setVal: boolean = n > 6
  flags.set(1, setVal)
  print(flags[1].or(false))
  let setVal2: boolean = n < 5
  flags[2] = setVal2
  print(flags[2].or(true))
}
