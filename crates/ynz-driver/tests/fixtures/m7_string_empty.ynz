// WHY: validates empty string operations. An empty backtick string must have
// count() == 0 and contains() == false for any substring. These are the boundary
// conditions that are most likely to produce off-by-one errors in the string runtime.
// Tests M7 P4b string method correctness for the zero-length edge case.

function main() -> nothing {
  let s = ``
  print(s.count().toString())
  print(s.contains(`x`).toString())
  print(s.startsWith(``).toString())
  print(s.endsWith(``).toString())
}
