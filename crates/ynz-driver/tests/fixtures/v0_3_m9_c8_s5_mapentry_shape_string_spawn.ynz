// WHY: C8 slice 5 — a `MapEntry` spawn argument is a copy the task owns: the 16-byte entry cell,
// the value's shape cell and the string the shape holds are all freed by the ladder, for a plain
// task (CPU arm) and a suspending task (state-machine ladder).
shape Part {
  name: string
  qty: int
}

function readLater(entry: MapEntry<int, Part>) -> nothing {
  sleepBlocking(30)
  print(entry.value.name)
}

function readLaterWait(entry: MapEntry<int, Part>) -> nothing {
  wait sleep(30)
  print(entry.value.name)
}

function entrypoint() -> nothing {
  let stock: map<int, Part> = {}
  stock.set(1, { name: `a${1}`, qty: 10 })
  for (entry in stock) {
    background readLater(entry)
    background readLaterWait(entry)
  }
  wait sleep(300)
}
