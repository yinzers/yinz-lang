// v0.3-M9 C6 cost fixture: the `share` argument of a plain call to a user function reads a list
// element the call writes nothing through, so it is passed as it is. This is the call-argument
// site that `v0_3_m9_c6_cost_arg_no_alias.ynz` pins on arrays, here on a shape. The dotted UFCS
// receiver has its own pair, `v0_3_m9_c6_cost_ufcs_receiver_no_write.ynz`.
// Allocations: `first`'s array (2), the list of one `Bucket` (2) and the fallback's empty array
// (2); the call copies no argument.

shape Bucket {
  rows: Array<Int>
  id: Int
}

function total(share bucket: Bucket) -> Int {
  return bucket.rows.count()
}

function entrypoint() -> Nothing {
  let first: Bucket = { rows: [1, 2], id: 1 }
  let buckets: Array<Bucket> = [first]
  let fallback: Bucket = { rows: [], id: 0 }
  print(total(buckets[0].or(fallback)))
}
