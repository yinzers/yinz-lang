// v0.3-M9 C1q: the same hand-over for the items of a `fixed` list.
// Correct behavior: prints 2, then 6.

function entrypoint() -> Nothing {
  let matrix: Fixed<Array<Int>> = [[1, 2], [3, 4], [5, 6]]
  let kept: Array<Array<Int>> = []
  let seen = 0
  for (row in matrix) {
    seen = seen + 1
    if (seen != 2) {
      kept.add(row)
    }
  }
  print(kept.count())
  let total = 0
  for (row in kept) {
    total = total + row[0].or(0)
  }
  print(total)
}
