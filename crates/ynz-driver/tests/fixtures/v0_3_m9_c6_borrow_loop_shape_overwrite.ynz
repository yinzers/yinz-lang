// v0.3-M9 C6: a for-loop variable reads a shape item whose string the body releases
// The reader keeps the value it read after the place is overwritten: no freed memory is read.

shape Tag {
  name: String
  id: Int
}
function entrypoint() -> Nothing {
  let tags: Array<Tag> = [{ name: `a-${1}`, id: 1 }]
  for (tag in tags) {
    tags[0] = { name: `b-${2}`, id: 2 }
    print(tag.name)
  }
}
