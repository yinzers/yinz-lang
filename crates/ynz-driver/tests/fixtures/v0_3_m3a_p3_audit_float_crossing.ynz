// Audit: float crossing local across top-level wait — must be CLEAN (no crash, exit 0).
// float is f64; flush uses bitcast f64->i64 for the frame slot, reload uses bitcast i64->f64.
// The round-trip correctness is verified by confirming the function completes without error.
// (Float comparisons with literals are not yet supported in Yinz v0.3; this fixture
// proves the frame-slot mechanism does not crash, which is the relevant audit property.)
function entrypoint() -> nothing {
  let x: float = 7.0
  wait sleep(5)
  let _ = x
  print(`ok`)
}
