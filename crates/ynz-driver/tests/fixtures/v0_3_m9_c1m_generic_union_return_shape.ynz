// v0.3-M9 C1m: a generic function returns `T | nothing` with `T` = a shape: once its given first
// argument, once its shared second argument (copied for the caller). The caller holds the result.
// Before: one value leaked per call, though the output was right.
// Expected output: `kept` twice.

shape Big {
  label: string
  items: array<int>
}

function wrap<T>(give item: T, share other: T) -> T | nothing {
  return item
}

function wrapOther<T>(give item: T, share other: T) -> T | nothing {
  return other
}

function entrypoint() -> nothing {
  let first: Big = { label: `hello`.toUpperCase(), items: [1] }
  let second: Big = { label: `bye`.toUpperCase(), items: [2] }
  let wrapped = wrap(first, second)
  print(`kept`)
  let third: Big = { label: `hello`.toUpperCase(), items: [1] }
  let fourth: Big = { label: `bye`.toUpperCase(), items: [2] }
  let wrappedOther = wrapOther(third, fourth)
  print(`kept`)
}
