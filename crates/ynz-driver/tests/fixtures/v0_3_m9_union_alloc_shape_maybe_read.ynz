// v0.3-M9 C1f (#423) round 2: binding `holders.get(0)` (a `maybe<Holder>` whose payload is the
// element, still in the array) is a VIEW while the array is not written: reading it allocates
// nothing. Correct behavior: prints 100. The counter test compares it with the single-read fixture:
// 99 more reads, no more cells.
shape End {
  flag: Boolean
}
shape Node {
  value: Int
  next: Node | End
}
shape Holder {
  chain: Node | End
  id: Int
}
shape Outer {
  inner: Holder
  tag: Int
}

function buildChain() -> Node {
  let stop: End = { flag: true }
  let last: Node = { value: 3, next: stop }
  let middle: Node = { value: 2, next: last }
  let top: Node = { value: 1, next: middle }
  return top
}

function makeHolder() -> Holder {
  let top = buildChain()
  let holder: Holder = { chain: top, id: 1 }
  return holder
}

function entrypoint() -> Nothing {
  let holders: Array<Holder> = []
  holders.add(makeHolder())
  let total = 0
  let round = 0
  while (round < 100) {
    let found = holders.get(0)
    if (found.exists()) {
      total = total + found.value.id
    }
    round = round + 1
  }
  print(total)
}
