// WHY: v0.3-M5 P3 crossing-wait acceptance, nested-if position — an array<Shape>
// with runtime-computed fields declared INSIDE a nested `if` body, crossing a
// `wait` in that same body, must print correct values. This was the M3a-R7
// nested-scope under-rejection-hole position (the guard had to fire here pre-M5);
// with by-value element storage the nested-scope crossing must now RUN correctly.
// Expected: total = 10+20 = 30.
// See docs/internal/implementation/IMP-concurrency.md 'ArrayShapeRuntimeFieldWithWait — LIFTED'.
shape Item {
  id: int
  qty: int
}

function entrypoint() -> nothing {
  let a: int = 10
  let b: int = 20
  let cond: boolean = true
  if (cond) {
    let items: array<Item> = [{ id: 1, qty: a }, { id: 2, qty: b }]
    wait sleep(5)
    let total: int = 0
    for (it in items) {
      total = total + it.qty
    }
    print(total.toString())
  }
}
