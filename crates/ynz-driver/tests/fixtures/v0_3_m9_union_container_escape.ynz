// v0.3-M9 C1e rework (#421): a union container RETURNED from the function that filled it. The
// element cell holds a pointer to the envelope (not the 16 bytes by value), and the payload is
// a pointer into the callee's frame, so a frame envelope dangles once `build` returns.
// Correct behavior: prints `big hello`, `tiny`, then `end`; clean under AddressSanitizer.
// Failure of a frame envelope (measured, also for an explicit `let held: Thing = big` store on
// the base): ASan stack-use-after-return at -O0 (stack-use-after-scope at -O2), `none` printed.

shape Tiny {
  flag: Boolean
}
shape Big {
  label: String
  count: Int
}
shape Thing = Tiny | Big

function describe(share thing: Thing) -> String {
  if (thing) {
    is Tiny => {
      return `tiny`
    }
    is Big => {
      return `big ${thing.label}`
    }
  }
  return `none`
}

function build() -> Array<Thing> {
  let big: Big = { label: `hello`, count: 3 }
  let tiny: Tiny = { flag: true }
  let things: Array<Thing> = []
  things.add(big)
  things.add(tiny)
  return things
}

function clobber(seed: Int) -> Int {
  let plusOne = seed + 1
  let doubled = plusOne * 2
  let reduced = doubled - 3
  return reduced + plusOne
}

function entrypoint() -> Nothing {
  let things = build()
  let scratch = clobber(7)
  let i = 0
  while (i < things.count()) {
    let got = things.get(i)
    if (got.exists()) {
      print(describe(got.value))
    }
    i = i + 1
  }
  print(`end`)
}
