// WHY: shape_value_eq compares a `string` field by its BYTES (`ynz_string_eq`, as `==` does),
// not by pointer. Every store copies a borrowed string (v0.3-M9 C3b), so two shapes built from
// one string hold two pointers and must still be equal; nested-shape fields still compare by
// pointer identity (D12, M5). Three cells, all true:
//   cell 1: target's name is read FROM the source binding (a copy of the same bytes).
//   cell 2: a SECOND occurrence of the same literal text.
//   cell 3: runtime-built same text via backtick interpolation (`${prefix}pha`; string `+`
//           concat is a type error in Yinz) — the cell a pointer-identity compare gets wrong.
//
// Expected output (byte-identical default vs --no-auto-parallel):
//   true
//   true
//   true
shape Tag {
  name: string
  n: int
}

function entrypoint() -> nothing {
  let a: Tag = { name: `alpha`, n: 1 }
  let same: Tag = { name: a.name, n: 1 }
  let tags: array<Tag> = [a]
  print(tags.contains(same))
  let fresh: Tag = { name: `alpha`, n: 1 }
  print(tags.contains(fresh))
  let prefix: string = `al`
  let built: string = `${prefix}pha`
  let runtimeName: Tag = { name: built, n: 1 }
  print(tags.contains(runtimeName))
}
