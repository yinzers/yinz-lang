// v0.3-M3g cross-module fused group — direct import. `crunch` (local, CPU-eligible) and
// `fetchRemote` (imported from `io_lib`, Suspending-eligible) form one fused group in
// `entrypoint`'s TOP-LEVEL body. `entrypoint`'s own frame must reserve the CPU handle/result
// region (sized by the LOCAL `cpu_group_slots_and_reserve` computation) AND embed
// `fetchRemote`'s child sub-frame at the correct cross-module-resolved offset — a frame sized
// by one query boundary (codegen_query's local admission) and laid out using the other
// (frame_layouts_query's cross-module resolver) is exactly the silent-corruption class the
// byte-identity oracle exists to catch.
//
// crunch(n) loops 0..50 (sum 1225); fetchRemote(n) waits on a timer then returns n+1.
//
// Arithmetic: crunch(1) = 1225+1=1226; fetchRemote(2) = 2+1=3.
//   sum = 1226 + 3 = 1229.
//
// Expected output (both modes — default and --no-auto-parallel):
//   1229

import { fetchRemote } from `io_lib`

function crunch(n: int) -> int {
  let total = 0
  let i = 0
  while (i < 50) {
    total = total + i
    i = i + 1
  }
  return total + n
}

function entrypoint() -> nothing {
  let a = crunch(1)
  let b = fetchRemote(2)
  print(a + b)
}
