// v0.3-M9 C1h: a shape holds a `fixed<string, 2>` list in a field. The shape owns the list's strings:
// the caller reads them, and every string is released when the shape leaves scope.
// Before: the field held a pointer into the building function's dead stack frame with no length:
// the strings were never released and a read went through freed stack.
// Expected output: the count, then both names.

shape Roster {
  title: String
  names: Fixed<String, 2>
}

function makeRoster() -> Roster {
  let names: Fixed<String> = [`amy`.toUpperCase(), `bob`]
  let roster: Roster = { title: `crew`, names: names }
  return roster
}

function entrypoint() -> Nothing {
  let roster = makeRoster()
  print(roster.names.count())
  print(roster.names[0].or(`?`))
  print(roster.names[1].or(`?`))
}
