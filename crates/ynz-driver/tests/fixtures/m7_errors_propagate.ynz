// WHY: two-level errors propagation test. inner() always succeeds; outer() is also
// errors-capable and calls inner(). main catches with .or(`fallback`).
// Verifies that an errors-capable function can call another errors-capable function
// and propagate its result.

function inner() -> string errors {
  return `propagated`
}

function outer() -> string errors {
  let x = inner()
  return x
}

function entrypoint() -> nothing {
  let result = outer()
  print(result.or(`fallback`))
}
