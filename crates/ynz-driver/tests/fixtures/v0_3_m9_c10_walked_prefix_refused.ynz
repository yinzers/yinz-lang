// v0.3-M9 C10: the body assigns a PREFIX of the place the loop walks (`outer.inner` while
// walking `outer.inner.rows`). The assignment frees the walked list; refused with a copy suggestion.
shape Inner {
  rows: array<array<int>>
}
shape Outer {
  inner: Inner
}
function entrypoint() -> nothing {
  let outer: Outer = { inner: { rows: [[1], [2], [3]] } }
  let total = 0
  for (row in outer.inner.rows) {
    let fresh: Inner = { rows: [[9]] }
    outer.inner = fresh
    total = total + row[0].or(0)
  }
  print(total)
}
