// v0.3-M9 C1h: a function returns a `fixed<int, 0>`: the empty list, the lowest length that can be
// written. Nothing is read or written for it, so the emitted code must not touch memory for it.
// Expected output: the count, 0.

function noInts() -> Fixed<Int, 0> {
  let nothingYet: Fixed<Int> = []
  return nothingYet
}

function entrypoint() -> Nothing {
  print(noInts().count())
}
