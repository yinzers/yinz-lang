// v0.3-M3d same-callee distinctness: two calls to the SAME function with DIFFERENT inputs,
// run at the same time, each returning a `float`. `a` is sumf(2) (3) and `b` is sumf(4) (6) —
// the two results stay separate, so the prints differ. Both print the same lines whether or
// not the two calls run at the same time.

function sumf(n: int) -> float {
  let total: float = 0.0.toFloat()
  let i: int = 0
  while (i < n) {
    total = total + 1.5.toFloat()
    i = i + 1
  }
  return total
}

function entrypoint() -> nothing {
  let a = sumf(2)
  let b = sumf(4)
  print(a)
  print(b)
}
