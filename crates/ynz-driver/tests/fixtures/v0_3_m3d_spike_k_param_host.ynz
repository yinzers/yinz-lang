// Spike admission fixture (k): the SM function hosting the CPU pair takes a param AND
// reads it after the pair's join.
//
// The first param slot lands at byte 32 — the byte the first CPU handle occupies — so a
// param READ after the join would reload the handle pointer's bytes instead of its value.
// A host that reads its param after the join therefore declines (it would be silent
// corruption on reload). A param used only in spawn args round-trips safely and fires; this
// fixture is the read-after-join shape that stays declined.
//
// `driver` is a SM function with one param that contains an adjacent fib pair, a wait sleep,
// and two prints that read `offset` after the pair. The host declines and the fib calls run
// sequentially. Both default and --no-auto-parallel modes must produce the same output.
//
// Expected output (both modes):
//   55
//   89
function fib(n: int) -> int {
  if (n < 2) {
    return n
  }
  return fib(n - 1) + fib(n - 2)
}

function driver(offset: int) -> nothing {
  let a = fib(10)
  let b = fib(11)
  wait sleep(0)
  print(a + offset - offset)
  print(b + offset - offset)
}

function entrypoint() -> nothing {
  driver(0)
}
