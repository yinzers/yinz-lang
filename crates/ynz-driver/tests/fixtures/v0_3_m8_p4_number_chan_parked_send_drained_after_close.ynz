// WHY: v0.3-M8 Phase 4 step 3d — fr12's parked cell: capacity 1, the producer's second send
// PARKS holding its minted cell inside the pending entry; the spawner closes, then drains —
// the parked (pre-close) send lands (contract item 4) and its cell is freed at the receive
// like any other. Both values round-trip; the third receive is `none`. Parity: two allocs,
// two frees — alloc == free + 0. RED today: `channel<number>` is rejected at construction.
//
// Expected output:
//   1.5
//   2.5
//   end
function producer(lend wire: channel<number>) -> nothing {
  let low: number = 1.5
  let high: number = 2.5
  wire.send(low)
  wire.send(high)
}

function entrypoint() -> nothing {
  let wire: channel<number> = channel<number>(1)
  background producer(wire)
  wait sleep(30)
  wire.close()
  let got = wire.receive()
  let first = got.or(0.0)
  print(first)
  let got2 = wire.receive()
  let second = got2.or(0.0)
  print(second)
  let after = wire.receive()
  if (after.exists()) {
    print(`unexpected value after end of stream`)
  }
  print(`end`)
}
