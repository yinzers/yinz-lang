// v0.3-M9 C1h: a function returns a `fixed<int>` and the caller reads its count and items.
// Before: the returned `fixed` was a bare pointer into the callee's dead stack frame, and its
// length was not carried, so `count()` printed 0 and every index read `none`.
// Expected output: the count, the first item and the last item.

function makeInts() -> fixed<int> {
  let numbers: fixed<int> = [10, 20, 30]
  return numbers
}

function entrypoint() -> nothing {
  let numbers = makeInts()
  print(numbers.count())
  print(numbers[0].or(-1))
  print(numbers[2].or(-1))
}
