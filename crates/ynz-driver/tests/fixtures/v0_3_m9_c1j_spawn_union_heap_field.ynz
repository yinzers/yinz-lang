// v0.3-M9 C1j: a `background` call passes a union field of a NAMED value (`bag.choice`) whose
// variant owns heap (an array of strings and a string). The task gets a slot of its own with a
// copy of what the variant owns, so `launch` can return and release `bag` while the task still
// reads the payload. Must be accepted, balanced and ASan clean.
// Expected output: the payload's item count, first item and label, then `done`.

shape Circle {
  radius: Float
}

shape Names {
  items: Array<String>
  label: String
}

shape Bag {
  choice: Circle | Names
  id: Int
}

function f(choice: Circle | Names) -> Nothing {
  wait sleep(100)
  if (choice) {
    is Circle => {
      print(`circle`)
    }
    is Names => {
      print(choice.items.count())
      print(choice.items[0].or(`?`))
      print(choice.label)
    }
  }
}

function launch() -> Nothing {
  let names: Names = { items: [`a`.toUpperCase(), `b`.toUpperCase()], label: `l`.toUpperCase() }
  let bag: Bag = { choice: names, id: 1 }
  background f(bag.choice)
}

function entrypoint() -> Nothing {
  launch()
  wait sleep(300)
  print(`done`)
}
