// v0.3-M9 C6: a task returns its argument's field; the release glue frees it under the parent
// The reader keeps the value it read after the place is overwritten: no freed memory is read.

shape Bucket {
  rows: Array<Int>
  id: Int
}
function pick(bucket: Bucket) -> Array<Int> {
  wait sleep(1)
  return bucket.rows
}
function entrypoint() -> Nothing {
  let bucket: Bucket = { rows: [10, 20, 30], id: 1 }
  let handle = background pick(bucket)
  wait sleep(50)
  let got = handle.receive()
  let fallback: Array<Int> = []
  let pickedArray = got.or(fallback)
  print(pickedArray.count())
  print(pickedArray[0].or(-1))
}
