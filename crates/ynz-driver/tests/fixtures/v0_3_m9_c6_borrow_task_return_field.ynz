// v0.3-M9 C6 security r1 red fixture: a task returns its argument's field; the release glue frees it under the parent
// Expected output is what base cf5a42dd prints; head frees the old value under the live reader.

shape Bucket {
  rows: array<int>
  id: int
}
function pick(b: Bucket) -> array<int> {
  wait sleep(1)
  return b.rows
}
function entrypoint() -> nothing {
  let b: Bucket = { rows: [10, 20, 30], id: 1 }
  let h = background pick(b)
  wait sleep(50)
  let got = h.receive()
  let fallback: array<int> = []
  let arr = got.or(fallback)
  print(arr.count())
  print(arr[0].or(-1))
}
