// v0.3-M9 C1g rework (round 2 test fixer): built-in `fixed<T>` methods called with the wrong
// number of arguments.
// Correct behavior: does not compile — each call is refused with the arity text of a plain call,
// the value before the dot counted as the first argument.
// Pre-fix failure: the type checker never counted a built-in method's arguments, so `fs.get()`
// read an index that was never passed and `fs.count(1)` dropped its argument without a word.

function entrypoint() -> nothing {
  let fs: fixed<int> = [1, 2, 3]
  let found = fs.get()
  let total = fs.count(1)
}
