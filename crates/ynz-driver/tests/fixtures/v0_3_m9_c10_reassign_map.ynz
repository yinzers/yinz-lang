// v0.3-M9 C10: the same for a `map` walked by entry. Correct behavior: prints 6, 1.

function entrypoint() -> Nothing {
  let scores: Map<String, Int> = { `a`: 1, `b`: 2, `c`: 3 }
  let total = 0
  for (entry in scores) {
    scores = { `z`: 9 }
    total = total + entry.value
  }
  print(total)
  print(scores.count())
}
