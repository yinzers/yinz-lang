// `combine` makes one pair of independent `score(...)` calls in plain sequence, then
// another pair inside an `if` branch — two pairs in one function. A function with more than one
// pair runs every call one after the other (no pair runs at the same time), so the printed line
// is the same as plain sequence. `entrypoint` calls `combine` once.
//
// score(seed) loops, so it does enough work to be worth running alongside another call, and
// returns the loop sum plus its seed.
//
// Arithmetic: loopSum = 0+1+...+99 = 4950.
//   first pair:  score(1)+score(2) = 4951 + 4952 = 9903
//   branch pair: score(3)+score(4) = 4953 + 4954 = 9907
//   combine    = 9903 + 9907 = 19810
//
// Expected output (both modes — default and --no-auto-parallel):
//   19810
function score(seed: int) -> int {
  let total = 0
  let i = 0
  while (i < 100) {
    total = total + i
    i = i + 1
  }
  return total + seed
}

function combine() -> int {
  let a = score(1)
  let b = score(2)
  let result = a + b
  let go = true
  if (go) {
    let lo = score(3)
    let hi = score(4)
    result = result + lo + hi
  }
  return result
}

function entrypoint() -> nothing {
  let r = combine()
  print(r)
}
