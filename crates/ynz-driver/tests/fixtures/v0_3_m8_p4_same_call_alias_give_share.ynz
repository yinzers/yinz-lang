// WHY: v0.3-M8 Phase 4 fix round 2 (Producer C1) — the mixed form: `rows` at a `give`
// position and its class-mate `other` at a `share` position of the SAME call. The callee
// frees `a` and reads `b` — one allocation, read after free. The `share` position runs no
// transfer decision at all, so nothing in the old per-position loop could see that its
// binding was consumed one position earlier in the same call.
// RED today: compiles. GREEN: refused with the use-after-give error naming `other` and `rows`.
function mix(give a: array<int>, share b: array<int>) -> nothing {
  print(`${a.count()} ${b.count()}`)
}

function entrypoint() -> nothing {
  let rows: array<int> = [1, 2, 3]
  let other = rows
  mix(rows, other)
}
