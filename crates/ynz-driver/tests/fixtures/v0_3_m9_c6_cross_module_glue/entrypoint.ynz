import { Tag, makeTags, replaceFirst } from `tags`

function entrypoint() -> Nothing {
  let tags = makeTags()
  tags[1] = { name: `main-${4}`, id: 4 }
  replaceFirst(tags)
  let fallback: Tag = { name: `none`, id: 0 }
  let firstTag: Tag = tags[0].or(fallback)
  let secondTag: Tag = tags[1].or(fallback)
  print(firstTag.name)
  print(secondTag.name)
}
