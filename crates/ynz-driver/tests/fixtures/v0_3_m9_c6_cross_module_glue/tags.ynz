// v0.3-M9 C6 probe: the module that declares `Tag` builds and overwrites tags; the entry module
// overwrites the same tags. Each module emits its own release glue for `array<Tag>`.

export shape Tag {
  name: String
  id: Int
}

export function makeTags() -> Array<Tag> {
  let tags: Array<Tag> = [{ name: `a-${1}`, id: 1 }, { name: `b-${2}`, id: 2 }]
  return tags
}

export function replaceFirst(lend tags: Array<Tag>) -> Nothing {
  tags[0] = { name: `lib-${3}`, id: 3 }
}
