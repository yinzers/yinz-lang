// v0.3-M9 C3b fixture: a `maybe<Tag>` whose payload shape holds a string field owns that string
// once it is returned or stored: the payload copy copies the string with it. A binding of the
// element read only reads it and is a view of the element (C1f views).
// Allocations: `t-1` is fresh and stored by move 1; `let found = tags.get(0)` is a view and copies
// nothing 0; `pick` returns a payload copy 1 and `let picked = pick(tags)` TAKES it (C7 slice 3: a
// binding of a returned `maybe` owns the payload the return made, so it is not copied again) 0.
// Total 1+0+1+0 = 2.
// Expected output: one value per line below.

shape Tag {
  name: String
  id: Int
}

function pick(tags: Array<Tag>) -> Maybe<Tag> {
  return tags.get(0)
}

function entrypoint() -> Nothing {
  let count: Int = 1
  let tags: Array<Tag> = [{ name: `t-${count}`, id: 1 }]
  let found = tags.get(0)
  if (found.exists()) {
    print(found.value.name)
  }
  let picked = pick(tags)
  if (picked.exists()) {
    print(picked.value.name)
  }
}
