// WHY: no-over-reject boundary for ArrayShapeRuntimeFieldWithWait — an array<Shape>
// whose elements have ALL-LITERAL int/bool field values is safe and must NOT be
// rejected by the guard. Since v0.3-M5 P2 the elements live BY VALUE in the heap
// array buffer (the buffer is the stable owner across the wait; the old
// module-global lowering, try_build_shape_global, was deleted with the by-value
// cut). Confirms the literal-field case still crosses: total must print 30.
// See docs/internal/implementation/IMP-concurrency.md 'ArrayShapeRuntimeFieldWithWait'.
shape Item {
  id: int
  qty: int
}

function entrypoint() -> nothing {
  let items: array<Item> = [{ id: 1, qty: 10 }, { id: 2, qty: 20 }]
  let total: int = 0
  wait sleep(5)
  for (it in items) {
    total = total + it.qty
  }
  print(total.toString())
}
