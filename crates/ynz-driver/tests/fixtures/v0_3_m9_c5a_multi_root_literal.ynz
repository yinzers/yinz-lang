// v0.3-M9 C5a (spike S3 probe t7): the literal `{ first: a, second: c }` holds BOTH `a` and `c`.
// Returned through `p`, a release pass that joined only the first root frees `c` while the
// returned pair holds it (prints `3` then `0`). GREEN today; guards C7. Expected output: `3` `2`.
shape Pair {
  first: array<int>
  second: array<int>
}

function make() -> Pair {
  let a: array<int> = [1, 2, 3]
  let c: array<int> = [4, 5]
  let p: Pair = { first: a, second: c }
  return p
}

function entrypoint() -> nothing {
  let p: Pair = make()
  print(p.first.count().toString())
  print(p.second.count().toString())
}
