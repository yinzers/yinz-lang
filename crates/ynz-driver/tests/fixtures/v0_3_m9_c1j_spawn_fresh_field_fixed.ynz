// v0.3-M9 C1j: a fire-and-forget `background` call passes a `fixed<string>` FIELD of a fresh call
// result (`make().items`). The task holds its own copy of the field; the temporary `make()`
// returns, strings included, must be released by the spawn, since a spawn suppresses the
// statement-end temporary. Before: 2 of the 4 strings leaked.
// Expected output: the count, the first name, then `done`.

shape Crate {
  items: fixed<string, 2>
}

function crunch(xs: fixed<string>) -> nothing {
  print(xs.count())
  print(xs[0].or(`?`))
}

function make() -> Crate {
  let crate: Crate = { items: [`a`.toUpperCase(), `b`.toUpperCase()] }
  return crate
}

function entrypoint() -> nothing {
  background crunch(make().items)
  wait sleep(50)
  print(`done`)
}
