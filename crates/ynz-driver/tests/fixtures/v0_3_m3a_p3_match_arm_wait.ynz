// Fixture: wait inside a match arm — resumes into the correct arm.
// The scrutinee is 2, so the `2 =>` arm runs. It waits, then prints `two`.
// The `1 =>` arm (no wait) must NOT run. Guards that SM match correctly routes
// to the right arm and resumes there.
// Expected output: two
function entrypoint() -> nothing {
  let x: int = 2
  if (x) {
    1 => {
      print(`one`)
    }
    2 => {
      wait sleep(5)
      print(`two`)
    }
    else => {
      print(`other`)
    }
  }
}
