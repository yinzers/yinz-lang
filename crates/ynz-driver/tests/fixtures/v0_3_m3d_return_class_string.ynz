// v0.3-M3d return-class matrix: two independent computations, each calling a different
// function that returns a `string`. They run at the same time; each result is available after
// both finish. Both print the same lines whether or not they run at the same time.

function buildStr(n: int) -> string {
  let count: int = 0
  let i: int = 0
  while (i < n) {
    count = count + 1
    i = i + 1
  }
  return `len=${count}`
}

function buildStr2(n: int) -> string {
  let count: int = 0
  let i: int = 0
  while (i < n) {
    count = count + 2
    i = i + 1
  }
  return `total=${count}`
}

function entrypoint() -> nothing {
  let a = buildStr(3)
  let b = buildStr2(5)
  print(a)
  print(b)
}
