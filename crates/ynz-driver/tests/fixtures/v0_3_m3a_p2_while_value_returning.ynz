// Fixture: value-returning suspending function containing a while loop.
// sum_n(5) adds 1+2+3+4+5 = 15 with a sleep each iteration.
// Guards that a non-nothing return type works correctly after a while-body suspension.
// Expected output: 15
function sum_n(n: int) -> int {
  let acc: int = 0
  let i: int = 1
  while (i <= n) {
    wait sleep(5)
    acc = acc + i
    i = i + 1
  }
  return acc
}

function entrypoint() -> nothing {
  let result: int = wait sum_n(5)
  print(result.toString())
}
