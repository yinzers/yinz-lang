// v0.3-M9 C1e rework (#421): a child shape's hidden defaults include its parent's.
// `extends` must stay inside one file (typeck refuses a parent from another file), so parent and
// child are declared here together and the child is constructed in another module.
// `extra` is a non-shape variant default into a union field, inherited from `Parent`.

export shape Big {
  label: String
  count: Int
}

export shape Parent {
  name: String
  hidden count: Int = 5
  hidden extra: Big | Int = 4096
}

export shape Child extends Parent {
  tag: String
  hidden more: Int = 7
}

// Hidden fields are read only by functions taking the shape as `self`, so the readers live here.
export function peekCount(share self: Child) -> Int {
  return self.count
}

export function peekMore(share self: Child) -> Int {
  return self.more
}

export function peekExtra(share self: Child) -> String {
  let slot: Big | Int = self.extra
  if (slot) {
    is Big => {
      return `big ${slot.label}`
    }
    else => {
      return `other`
    }
  }
  return `none`
}
