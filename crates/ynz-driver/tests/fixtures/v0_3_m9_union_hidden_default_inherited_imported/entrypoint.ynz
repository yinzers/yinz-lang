// v0.3-M9 C1e rework (#421): constructing an IMPORTED child shape applies its own hidden default
// AND the defaults it inherits from its parent, the union one included.
// Correct behavior: prints `5`, `7`, `other`, `end`; clean under AddressSanitizer at -O0 and -O2.
import { Child, peekCount, peekMore, peekExtra } from `holders`

function entrypoint() -> Nothing {
  let child: Child = { name: `a`, tag: `t` }
  print(child.peekCount().toString())
  print(child.peekMore().toString())
  print(child.peekExtra())
  print(`end`)
}
