// v0.3-M2 Phase 7: background from a suspending entrypoint.
// Verifies Bug C fix: background task runs concurrently while parent SM waits.

function worker() -> nothing {
  wait sleep(50)
  print(`worker done`)
}

function entrypoint() -> nothing {
  background worker()
  print(`main waiting`)
  wait sleep(100)
  print(`main done`)
}
