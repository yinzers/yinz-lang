// v0.3-M9 C8 slice 4b: a function returns a `fixed<Part>` of shapes that own a string.
// A `fixed<T>` in a signature carries its length (card #433): a returned list comes back by value
// with its length, an unsized parameter is compiled once per length its callers pass. Correct
// behavior: the program compiles, runs, frees every allocation (items included) and is clean
// under AddressSanitizer at both optimization levels.

shape Part {
  name: string
}

function makeParts() -> fixed<Part> {
  let first: Part = { name: `a`.toUpperCase() }
  let second: Part = { name: `bb` }
  let parts: fixed<Part> = [first, second]
  return parts
}

function entrypoint() -> nothing {
  let parts = makeParts()
  print(`built`)
}
