// M3e collision regression: import alias key must win over a local function with the same name.
// `compute` from work_ops is imported as `doWork`. A local `function doWork()` exists with
// the same alias name. Three `background doWork()` calls must dispatch to the IMPORTED
// callee — which prints "IMPORTED-OK" — not to the local function — which would print
// "LOCAL-BUG". Any wrong dispatch (local wins) produces "LOCAL-BUG" in stdout and the
// test fails. Heap corruption from an undersized frame (local's 32-byte header vs the
// imported callee's 72+ byte frame) would also prevent "IMPORTED-OK" from printing.
// Expected output: three "IMPORTED-OK" lines + "main-done"
import { compute as doWork } from `work_ops`

function doWork() -> nothing {
  print(`LOCAL-BUG`)
}

function entrypoint() -> nothing {
  background doWork()
  background doWork()
  background doWork()
  sleep(300)
  print(`main-done`)
}
