// M3e collision regression: import alias key must win over a local function with the same name.
// `compute` from work_ops is imported as `doWork`. A local `function doWork(...)` exists with
// the same alias name AND the same signature (so name collision — not arity — is what dispatch
// must resolve). Three `background doWork(done)` calls must dispatch to the IMPORTED callee —
// which prints "IMPORTED-OK" — not to the local function — which would print "LOCAL-BUG".
// Any wrong dispatch (local wins) produces "LOCAL-BUG" in stdout and the test fails. Heap
// corruption from an undersized frame (local's 32-byte header vs the imported callee's 72+
// byte frame) would also prevent "IMPORTED-OK" from printing.
// Synchronization: each spawned task sends 1 on `done` after its print; the parent receives
// THREE times before printing "main-done". This is a real barrier (receive suspends until the
// value arrives) — task completion happens-before "main-done", with no timing margin anywhere.
// The local decoy also sends, so even a wrong dispatch terminates (and fails on LOCAL-BUG)
// instead of hanging the parent.
// Expected output: three "IMPORTED-OK" lines + "main-done"
import { compute as doWork } from `work_ops`

function doWork(lend done: channel<int>) -> nothing {
  print(`LOCAL-BUG`)
  done.send(1)
}

function entrypoint() -> nothing {
  let done: channel<int> = channel<int>(3)
  background doWork(done)
  background doWork(done)
  background doWork(done)
  let first = done.receive()
  let second = done.receive()
  let third = done.receive()
  print(`main-done`)
}
