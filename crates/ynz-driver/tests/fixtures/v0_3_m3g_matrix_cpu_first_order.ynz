// v0.3-M3g N+M matrix — order permutation: CPU member declared FIRST, I/O member SECOND (the
// twin of v0_3_m3g_matrix_io_first_order.ynz, same two callees, roles swapped). Both fixtures
// sum to the identical total, proving declaration order is immaterial to correctness.
//
// crunch(n) loops 0..50 (sum 1225); fetch(n) waits on a timer.
//
// Arithmetic: crunch(1) = 1225+1=1226; fetch(2) = 2+1=3.
//   sum = 1226 + 3 = 1229.
//
// Expected output (both modes — default and --no-auto-parallel):
//   1229

function crunch(n: int) -> int {
  let total = 0
  let i = 0
  while (i < 50) {
    total = total + i
    i = i + 1
  }
  return total + n
}

function fetch(n: int) -> int {
  wait sleep(0)
  return n + 1
}

function entrypoint() -> nothing {
  let a = crunch(1)
  let b = fetch(2)
  print(a + b)
}
