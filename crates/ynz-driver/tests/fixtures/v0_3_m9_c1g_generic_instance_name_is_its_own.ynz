// v0.3-M9 C1g regression guard: a generic instance's symbol name never equals a user function's.
// Identifiers may contain `_`, and instance names were `_`-joined: `show<Big>` was
// `show_shape_Big`, which is also the user function below, so `show(big)` ran `show_shape_Big`
// on a `Big` and printed the `label` pointer as `code`.
// Correct behavior: compiles; prints generic.
// Pre-fix (b3e23ce): prints a heap address.

shape Tiny {
  code: Int
}
shape Big {
  label: String
  count: Int
}
function show<T>(share value: T) -> Nothing {
  print(`generic`)
}
function show_shape_Big(share value: Tiny) -> Nothing {
  print(`${value.code}`)
}
function entrypoint() -> Nothing {
  let big: Big = { label: `hello`, count: 3 }
  show(big)
}
