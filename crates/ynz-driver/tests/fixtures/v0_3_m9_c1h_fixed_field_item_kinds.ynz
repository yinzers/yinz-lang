// v0.3-M9 C1h: fixed fields of number, boolean and float items, an inherited shape, a hidden field with a list default, and a copy that does not share the list.
// Expected output: 2.25, true, 1.5, 3, 9.5, 1.5, 3.75

shape Base {
  id: int
  hidden secret: fixed<int, 2> = [7, 8]
}
shape Child extends Base {
  vals: fixed<number, 2>
  flags: fixed<boolean, 2>
  floats: fixed<float, 2>
}

function entrypoint() -> nothing {
  let child: Child = { id: 3, vals: [1.5, 2.25], flags: [true, false], floats: [0.5, 1.5] }
  print(child.vals[1].or(0.0))
  print(child.flags[0].or(false))
  print(child.floats[1].or(0.0))
  print(child.id)
  let twin = child.copy()
  twin.vals.set(0, 9.5)
  print(twin.vals[0].or(0.0))
  print(child.vals[0].or(0.0))
  let total: number = 0.0
  for (v in child.vals) {
    total = total + v
  }
  print(total)
}
