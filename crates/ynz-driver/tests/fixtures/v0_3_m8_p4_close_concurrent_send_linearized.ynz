// WHY: v0.3-M8 Phase 4 — contract item 2's LINEARIZATION, asserted the only way it can be: a
// producer task hammers `send()` while the spawner calls `close()` under it. The order is
// decided by ONE critical section — the sender-lock clone, not the `try_send` — so a send that
// already holds its clone when `close()` takes the `Option` is a PRE-close send and LANDS
// (including one parked on a full buffer: it completes when the consumer drains a slot). A
// send that reaches the lock after the take is refused. The invariant that holds under EVERY
// interleaving: every send the producer counted as delivered is received, and every send the
// producer counted as refused is not — delivered == received, delivered + refused == attempts.
// The fixture deliberately does NOT assert "any send after close() returns is refused" — the
// design says that ordering is neither provided nor needed (obligation (5) in the plan).
// RED today: `.close()` is an unknown method.
//
// Expected output:
//   parity ok
//   end
function blast(lend wire: channel<int>, lend tally: channel<int>) -> nothing {
  let refused = 0
  let i = 0
  while (i < 200) {
    let sent = wire.send(i)
    if (sent.failed()) {
      refused = refused + 1
    }
    i = i + 1
  }
  let delivered = 200 - refused
  tally.send(delivered)
  tally.close()
}

function entrypoint() -> nothing {
  let wire: channel<int> = channel<int>(8)
  let tally: channel<int> = channel<int>(1)
  background blast(wire, tally)
  wait sleep(2)
  wire.close()
  let received = 0
  let stillOpen = true
  while (stillOpen) {
    let next = wire.receive()
    if (next.exists()) {
      received = received + 1
    }
    stillOpen = next.exists()
  }
  let reported = tally.receive()
  if (reported.exists()) {
    if (reported.value == received) {
      print(`parity ok`)
    }
    if (reported.value != received) {
      print(`MISMATCH delivered=${reported.value.toString()} received=${received.toString()}`)
    }
  }
  print(`end`)
}
