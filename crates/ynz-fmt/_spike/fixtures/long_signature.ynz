// long_signature.ynz: function with many params and inline comments
// All six params contribute to the final score calculation.
function computeScore(name: string, health: int, attack: int, defense: int, speed: int, level: int) -> int {
  // compute a weighted score from all six stats
  const hp = health + attack // health plus attack
  const stats = defense + speed // defense plus speed
  const total = hp + stats + level // add level last
  return total
}
