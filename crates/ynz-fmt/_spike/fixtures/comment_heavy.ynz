// comment_heavy.ynz: dense comment coverage across multiple functions
// Every statement and declaration has at least one comment.
// This tests the formatter's ability to handle high comment density.
function greet(name: string) -> nothing {
  // Build the greeting message from the name param
  const msg = `Hello, ${name}!` // interpolated greeting
  // Print it out to the user
  print(msg) // terminal output
}

// A farewell function that says goodbye
// Symmetric to greet above
function farewell(name: string) -> nothing {
  // Build the farewell message
  const msg = `Goodbye, ${name}!` // farewell interpolation
  // Output the message
  print(msg) // terminal output
}

// Utility: doubles an integer
// Used by callers who need 2x a value
function double(x: int) -> int {
  // Simple addition double — avoids multiplication operator
  return x + x // idiomatic double
}
