// shape_decl.ynz: shape declaration with field comments
// Demonstrates that the formatter preserves field-level inline comments.

shape Player {
  name: string  // display name for UI
  health: int  // current HP (0-100)
  attack: int  // base attack power
  defense: int  // base defense rating
  speed: int  // movement speed multiplier
  level: int  // current player level
  score: int  // accumulated game score
  active: boolean  // is currently in an active match
}
// Create a default player with a given name

function newPlayer(name: string) -> nothing {
  // Print the player name to confirm creation
  print(name)  // confirm creation
}
