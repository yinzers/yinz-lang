---
source: crates/ynz-codegen/tests/golden.rs
expression: artifact.ir_text
---
; ModuleID = 'ynz-hello.ynz'
source_filename = "ynz-hello.ynz"
target datalayout = "e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
target triple = "x86_64-pc-linux-gnu"

@bts = private unnamed_addr constant [12 x i8] c"hello, yinz\00"

; Function Attrs: nofree nounwind
declare noundef i32 @puts(ptr nocapture noundef readonly) local_unnamed_addr #0

declare void @ynz_siphash_init() local_unnamed_addr

declare void @ynz_rt_init() local_unnamed_addr

declare void @ynz_rt_shutdown() local_unnamed_addr

define noundef i32 @main() local_unnamed_addr {
entry:
  tail call void @ynz_siphash_init()
  tail call void @ynz_rt_init()
  %puts = tail call i32 @puts(ptr nonnull dereferenceable(1) @bts)
  tail call void @ynz_rt_shutdown()
  ret i32 0
}

attributes #0 = { nofree nounwind }
