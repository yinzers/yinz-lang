  store ptr null, ptr %h_slot_wr2, align 8
  %ret_slot_ptr = getelementptr i8, ptr %0, i64 16
  store i64 0, ptr %ret_slot_ptr, align 8
  ret i32 0

sm_suspend:                                       ; preds = %sm_s0
  %h_slot_wr = getelementptr i8, ptr %0, i64 8
  store ptr %sleep_handle, ptr %h_slot_wr, align 8
  store i32 1, ptr %0, align 4
  br label %sm_pending
}

