# Container-side ~/.bash_aliases for ynz devcontainer.
# Bind-mounted from .devcontainer/bash_aliases (this file).
# Sourced automatically by Ubuntu's stock ~/.bashrc.

# Inherit shared aliases (host + all devcontainers)
[ -f ~/.dev-shared/aliases.sh ] && . ~/.dev-shared/aliases.sh

# ───── Container-specific overrides ─────

# ynz has the host docker socket mounted, so docker aliases work and
# target the host daemon. Re-define them here because dev-shared gates them
# off in any /.dockerenv environment.
alias dps="docker ps --format 'table {{.Names}}\t{{.Status}}\t{{.Ports}}' | sed 's/0.0.0.0://g; s/\/tcp//g; s/, / /g'"
alias dstop="docker stop \$(docker ps -a -q)"
alias dstart="docker compose up"
alias dc="docker compose exec"
alias dprune="CONTAINERS=\$(docker ps -a -q) && if [ -n \"\$CONTAINERS\" ]; then docker stop \$CONTAINERS && docker rm -f \$CONTAINERS; fi && docker image prune --all -f && docker system prune -f --volumes=false && docker builder prune -a -f"
