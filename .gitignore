target/
*.ll
*.o
*.bc
Cargo.lock.bak

# Compiled binaries emitted by `ynz build`/`ynz run` during integration tests.
# These land adjacent to the source .ynz file (same name, no extension) when no
# output path is specified. Ignore every file in the fixtures tree EXCEPT the real
# sources (.ynz / .toml) so a new fixture's compiled output never bloats the repo —
# replaces the old per-file allowlist that silently missed new fixtures.
crates/ynz-driver/tests/fixtures/**
!crates/ynz-driver/tests/fixtures/
!crates/ynz-driver/tests/fixtures/**/
!crates/ynz-driver/tests/fixtures/**/*.ynz
!crates/ynz-driver/tests/fixtures/**/*.toml

# VSCode extension build artifacts
tooling/vscode-ynz/node_modules/
tooling/vscode-ynz/out/
tooling/vscode-ynz/*.vsix
# Build outputs for example projects — `ynz build examples/<name>/` writes here.
# Matches `bin` directly inside any example project root.
examples/*/bin

# Website build artifacts (belt-and-suspenders; website/.gitignore is primary)
website/node_modules/
website/.nuxt/
website/.output/
