function work(rows: array<int>) -> int {
  wait sleep(5)
  return rows.count()
}
function launch() -> nothing {
  let rows: array<int> = [4, 5, 6]
  let h = background work(rows)
  print(rows.count().toString())
  wait sleep(50)
  let got = h.receive()
  print(got.or(-1).toString())
}
function entrypoint() -> nothing {
  launch()
}
