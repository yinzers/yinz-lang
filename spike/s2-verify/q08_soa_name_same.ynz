shape P {
  x: int
  y: int
}
function escape(share items: array<P>) -> int {
  return items.count()
}
function entrypoint() -> nothing {
  let c = true
  if (c) {
    let pts: array<P> = [{ x: 0, y: 0 }, { x: 1, y: 2 }, { x: 2, y: 4 }, { x: 3, y: 6 }, { x: 4, y: 8 }, { x: 5, y: 10 }, { x: 6, y: 12 }, { x: 7, y: 14 }, { x: 8, y: 16 }, { x: 9, y: 18 }, { x: 10, y: 20 }, { x: 11, y: 22 }, { x: 12, y: 24 }, { x: 13, y: 26 }, { x: 14, y: 28 }, { x: 15, y: 30 }, { x: 16, y: 32 }, { x: 17, y: 34 }, { x: 18, y: 36 }, { x: 19, y: 38 }, { x: 20, y: 40 }, { x: 21, y: 42 }, { x: 22, y: 44 }, { x: 23, y: 46 }, { x: 24, y: 48 }, { x: 25, y: 50 }, { x: 26, y: 52 }, { x: 27, y: 54 }, { x: 28, y: 56 }, { x: 29, y: 58 }, { x: 30, y: 60 }, { x: 31, y: 62 }, { x: 32, y: 64 }, { x: 33, y: 66 }, { x: 34, y: 68 }, { x: 35, y: 70 }, { x: 36, y: 72 }, { x: 37, y: 74 }, { x: 38, y: 76 }, { x: 39, y: 78 }, { x: 40, y: 80 }, { x: 41, y: 82 }, { x: 42, y: 84 }, { x: 43, y: 86 }, { x: 44, y: 88 }, { x: 45, y: 90 }, { x: 46, y: 92 }, { x: 47, y: 94 }, { x: 48, y: 96 }, { x: 49, y: 98 }, { x: 50, y: 100 }, { x: 51, y: 102 }, { x: 52, y: 104 }, { x: 53, y: 106 }, { x: 54, y: 108 }, { x: 55, y: 110 }, { x: 56, y: 112 }, { x: 57, y: 114 }, { x: 58, y: 116 }, { x: 59, y: 118 }, { x: 60, y: 120 }, { x: 61, y: 122 }, { x: 62, y: 124 }, { x: 63, y: 126 }, { x: 64, y: 128 }, { x: 65, y: 130 }, { x: 66, y: 132 }, { x: 67, y: 134 }, { x: 68, y: 136 }, { x: 69, y: 138 }]
    let sum = 0
    for (p in pts) {
      sum = sum + p.x
    }
    print(sum.toString())
  }
  if (c) {
    let pts: array<P> = [{ x: 1000, y: 0 }, { x: 1001, y: 2 }, { x: 1002, y: 4 }, { x: 1003, y: 6 }, { x: 1004, y: 8 }, { x: 1005, y: 10 }, { x: 1006, y: 12 }, { x: 1007, y: 14 }, { x: 1008, y: 16 }, { x: 1009, y: 18 }, { x: 1010, y: 20 }, { x: 1011, y: 22 }, { x: 1012, y: 24 }, { x: 1013, y: 26 }, { x: 1014, y: 28 }, { x: 1015, y: 30 }, { x: 1016, y: 32 }, { x: 1017, y: 34 }, { x: 1018, y: 36 }, { x: 1019, y: 38 }, { x: 1020, y: 40 }, { x: 1021, y: 42 }, { x: 1022, y: 44 }, { x: 1023, y: 46 }, { x: 1024, y: 48 }, { x: 1025, y: 50 }, { x: 1026, y: 52 }, { x: 1027, y: 54 }, { x: 1028, y: 56 }, { x: 1029, y: 58 }, { x: 1030, y: 60 }, { x: 1031, y: 62 }, { x: 1032, y: 64 }, { x: 1033, y: 66 }, { x: 1034, y: 68 }, { x: 1035, y: 70 }, { x: 1036, y: 72 }, { x: 1037, y: 74 }, { x: 1038, y: 76 }, { x: 1039, y: 78 }, { x: 1040, y: 80 }, { x: 1041, y: 82 }, { x: 1042, y: 84 }, { x: 1043, y: 86 }, { x: 1044, y: 88 }, { x: 1045, y: 90 }, { x: 1046, y: 92 }, { x: 1047, y: 94 }, { x: 1048, y: 96 }, { x: 1049, y: 98 }, { x: 1050, y: 100 }, { x: 1051, y: 102 }, { x: 1052, y: 104 }, { x: 1053, y: 106 }, { x: 1054, y: 108 }, { x: 1055, y: 110 }, { x: 1056, y: 112 }, { x: 1057, y: 114 }, { x: 1058, y: 116 }, { x: 1059, y: 118 }, { x: 1060, y: 120 }, { x: 1061, y: 122 }, { x: 1062, y: 124 }, { x: 1063, y: 126 }, { x: 1064, y: 128 }, { x: 1065, y: 130 }, { x: 1066, y: 132 }, { x: 1067, y: 134 }, { x: 1068, y: 136 }, { x: 1069, y: 138 }]
    let n = escape(pts)
    let sum2 = 0
