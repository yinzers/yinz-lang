// S2-verify: sibling shape-destructure loops over DIFFERENT shapes -> same synthetic var `__shape`, type taken from first.
shape A {
  s: string
}
shape B {
  n: int
  m: int
}
function entrypoint() -> nothing {
  let xs: array<A> = [{ s: `one` }]
  let ys: array<B> = [{ n: 5, m: 6 }]
  for ({ s } in xs) {
    wait sleep(5)
    print(s)
  }
  for ({ n } in ys) {
    wait sleep(5)
    print(n.toString())
  }
}
