// Q2: p02 with HEAP strings (toString), to see alloc/free and which value survives.
function entrypoint() -> nothing {
  let a = true
  let n: int = 1
  let m: int = 2
  if (a) {
    let x = n.toString()
    wait sleep(5)
    if (a) {
      let x = m.toString()
      wait sleep(5)
      print(x)
    }
    print(x)
  }
}
